@page "/selection"

<PageTitle>Selection — NxGrid</PageTitle>

<h1>Selection</h1>
<p class="doc-intro">
    <code>SelectionMode</code> controls how the grid responds to mouse and keyboard interaction.
    <code>Cell</code> (default) gives you rectangular cell-range selection.
    <code>Row</code> selects entire rows — the natural fit for master-detail layouts.
    <code>None</code> disables all selection feedback for display-only grids.
</p>

<div class="doc-section">
    <h2>OnCellClicked — Single-Click Event</h2>
    <p class="doc-para">
        <code>OnCellClicked</code> fires when the user cleanly left-clicks a body cell (mousedown and mouseup
        on the same cell, no drag). It fires for all cells regardless of editability, and fires after
        <code>OnSelectionChanged</code>. Use it to load a detail panel, open a form, or navigate — without
        conflating click intent with keyboard navigation.
    </p>
    <div class="doc-demo-row">
        <div class="doc-demo-grid">
            <NxGrid T="Person" Data="@clickPeople"
                    SelectionMode="NxGridSelectionMode.Row"
                    OnCellClicked="@OnPersonClicked"
                    Cursor="NxGridCursor.Pointer"
                    Style="height:260px">
                <NxGridColumn Property="@(x => x.FirstName)"  Width="130" />
                <NxGridColumn Property="@(x => x.LastName)"   Width="130" />
                <NxGridColumn Property="@(x => x.Age)"        Width="70"  Alignment="NxGridColumnAlignment.Right" />
                <NxGridColumn Property="@(x => x.Department)" />
            </NxGrid>
        </div>
        <div class="doc-detail-panel">
            @if (clickedPerson != null)
            {
                <div class="doc-detail-card">
                    <div class="doc-detail-name">@clickedPerson.FirstName @clickedPerson.LastName</div>
                    <div class="doc-detail-row"><span>ID</span><span>@clickedPerson.Id</span></div>
                    <div class="doc-detail-row"><span>Age</span><span>@clickedPerson.Age</span></div>
                    <div class="doc-detail-row"><span>Department</span><span>@clickedPerson.Department</span></div>
                </div>
            }
            else
            {
                <div class="doc-detail-empty">← Click a row</div>
            }
        </div>
    </div>
    <div class="doc-output">@(clickLog ?? "Click a cell…")</div>
</div>

<div class="doc-section">
    <h2>SelectionMode.Cell — Rectangular Range</h2>
    <p class="doc-para">
        Click to anchor, <kbd class="doc-kbd">Shift+click</kbd> or <kbd class="doc-kbd">Shift+Arrow</kbd> to extend.
        <kbd class="doc-kbd">Ctrl+A</kbd> selects all. <kbd class="doc-kbd">Ctrl+C</kbd> copies the range as TSV.
    </p>
    <div class="doc-controls">
        <label>
            <input type="checkbox" @bind="headerClickSelects" />
            <strong>HeaderClickSelects</strong> — click a column header to select the whole column
        </label>
        <button class="doc-btn" @onclick="SelectAlice">SelectRow(alice)</button>
        <button class="doc-btn doc-btn-secondary" @onclick="ClearCellLog">Clear log</button>
    </div>
    <NxGrid T="Person" @ref="cellGrid" Data="@cellPeople"
            SelectionMode="NxGridSelectionMode.Cell"
            OnSelectionChanged="@OnCellSelectionChanged"
            HeaderClickSelects="@headerClickSelects"
            RowGutter="NxGridRowGutter.Numbers"
            Cursor="@NxGridCursor.Cell"
            Style="height:260px">
        <NxGridColumn Property="@(x => x.Id)"         Width="50"  MaxWidth="50" />
        <NxGridColumn Property="@(x => x.FirstName)"  Width="130" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="130" />
        <NxGridColumn Property="@(x => x.Age)"        Width="70"  Alignment="NxGridColumnAlignment.Right" />
        <NxGridColumn Property="@(x => x.Department)" />
    </NxGrid>
    <div class="doc-output">@(string.IsNullOrEmpty(cellLog) ? "Click a cell to see selection info…" : cellLog)</div>
</div>

<div class="doc-section">
    <h2>SelectionMode.Row — Master-Detail</h2>
    <p class="doc-para">
        Clicking any cell in a row selects the whole row.
        <kbd class="doc-kbd">Shift+click</kbd> and <kbd class="doc-kbd">Shift+↑↓</kbd> extend to a contiguous row range.
        Left/right arrows are no-ops. <code>args.Ranges[0].Items</code> gives you the selected row objects directly.
    </p>
    <div class="doc-demo-row">
        <div class="doc-demo-grid">
            <NxGrid T="Person" Data="@rowPeople"
                    SelectionMode="NxGridSelectionMode.Row"
                    OnSelectionChanged="@OnRowSelectionChanged"
                    Cursor="@NxGridCursor.Pointer"
                    Style="height:260px">
                <NxGridColumn Property="@(x => x.FirstName)"  Width="130" />
                <NxGridColumn Property="@(x => x.LastName)"   Width="130" />
                <NxGridColumn Property="@(x => x.Age)"        Width="70"  Alignment="NxGridColumnAlignment.Right" />
                <NxGridColumn Property="@(x => x.Department)" />
            </NxGrid>
        </div>
        <div class="doc-detail-panel">
            @if (selectedPerson != null)
            {
                <div class="doc-detail-card">
                    <div class="doc-detail-name">@selectedPerson.FirstName @selectedPerson.LastName</div>
                    <div class="doc-detail-row"><span>ID</span><span>@selectedPerson.Id</span></div>
                    <div class="doc-detail-row"><span>Age</span><span>@selectedPerson.Age</span></div>
                    <div class="doc-detail-row"><span>Department</span><span>@selectedPerson.Department</span></div>
                    <div class="doc-detail-row"><span>Email</span><span>@($"{selectedPerson.FirstName.ToLower()}.{selectedPerson.LastName.ToLower()}@corp.com")</span></div>
                </div>
            }
            else
            {
                <div class="doc-detail-empty">← Select a row</div>
            }
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Multi-Range Selection (Ctrl+Click)</h2>
    <p class="doc-para">
        Hold <kbd class="doc-kbd">Ctrl</kbd> (⌘ on Mac) while clicking or dragging to build up multiple independent
        selection ranges. Each range highlights separately and all contribute to
        <code>args.Ranges</code>. <kbd class="doc-kbd">Shift+click</kbd> still extends the most recent range while
        keeping the others. Any plain click without Ctrl collapses back to a single range.
    </p>
    <div class="doc-controls">
        <button class="doc-btn doc-btn-secondary" @onclick="ClearMultiLog">Clear log</button>
    </div>
    <NxGrid T="Person" Data="@multiPeople"
            SelectionMode="NxGridSelectionMode.Cell"
            OnSelectionChanged="@OnMultiSelectionChanged"
            RowGutter="NxGridRowGutter.Numbers"
            Cursor="NxGridCursor.Cell"
            Style="height:260px">
        <NxGridColumn Property="@(x => x.Id)"         Width="50"  MaxWidth="50" />
        <NxGridColumn Property="@(x => x.FirstName)"  Width="130" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="130" />
        <NxGridColumn Property="@(x => x.Age)"        Width="70"  Alignment="NxGridColumnAlignment.Right" />
        <NxGridColumn Property="@(x => x.Department)" />
    </NxGrid>
    <div class="doc-output">@(string.IsNullOrEmpty(multiLog) ? "Ctrl+click cells to build multiple ranges…" : multiLog)</div>
</div>

<div class="doc-section">
    <h2>SelectionMode.None — Display-Only</h2>
    <p class="doc-para">
        No selection highlight is applied. Mouse clicks, keyboard navigation, and
        <code>OnSelectionChanged</code> are all suppressed. Use for read-only report grids
        where selection feedback would be misleading.
    </p>
    <NxGrid T="Person" Data="@nonePeople"
            SelectionMode="NxGridSelectionMode.None"
            Cursor="NxGridCursor.Default"
            Style="height:200px">
        <NxGridColumn Property="@(x => x.FirstName)"  Width="130" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="130" />
        <NxGridColumn Property="@(x => x.Age)"        Width="70"  Alignment="NxGridColumnAlignment.Right" />
        <NxGridColumn Property="@(x => x.Department)" />
    </NxGrid>
    <div class="doc-output" style="color:var(--nx-grid-muted-fg)">Click anywhere in the grid — nothing is highlighted.</div>
</div>

<div class="doc-section">
    <h2>@@bind-SelectedItems — Two-Way Binding</h2>
    <p class="doc-para">
        <code>@@bind-SelectedItems</code> keeps a <code>List&lt;T&gt;</code> in sync with the selection automatically —
        no <code>OnSelectionChanged</code> handler required. The list always contains the unique row objects
        across all active ranges.
    </p>
    <div class="doc-controls">
        <button class="doc-btn doc-btn-secondary" @onclick="ClearBindSelection">Clear selection</button>
    </div>
    <div class="doc-demo-row">
        <div class="doc-demo-grid">
            <NxGrid T="Person" Data="@bindPeople"
                    SelectionMode="NxGridSelectionMode.Row"
                    @bind-SelectedItems="bindSelectedPeople"
                    Cursor="NxGridCursor.Pointer"
                    Style="height:260px">
                <NxGridColumn Property="@(x => x.FirstName)"  Width="130" />
                <NxGridColumn Property="@(x => x.LastName)"   Width="130" />
                <NxGridColumn Property="@(x => x.Age)"        Width="70"  Alignment="NxGridColumnAlignment.Right" />
                <NxGridColumn Property="@(x => x.Department)" />
            </NxGrid>
        </div>
        <div class="doc-detail-panel">
            @if (bindSelectedPeople.Count > 0)
            {
                @foreach (var p in bindSelectedPeople)
                {
                    <div class="doc-detail-card" style="margin-bottom:6px">
                        <div class="doc-detail-name">@p.FirstName @p.LastName</div>
                        <div class="doc-detail-row"><span>Dept</span><span>@p.Department</span></div>
                    </div>
                }
            }
            else
            {
                <div class="doc-detail-empty">← Select a row</div>
            }
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>@@bind-SelectedItems</h2>
    <pre class="doc-code">@bindSelectedItemsCode</pre>
</div>

<div class="doc-section">
    <h2>Key Property — Stable Selection Across Data Refresh</h2>
    <p class="doc-para">
        By default, replacing <code>Data</code> with a new list loses the selection because the old
        object references are gone. <code>KeyProperty</code> tells the grid how to identify rows by
        value — so after an API reload the selection is automatically restored to the matching row in
        the new list.
    </p>
    <p class="doc-para">
        Click a row in each grid, then press <strong>Refresh Data</strong>. The left grid (no key)
        loses its selection; the right grid restores it by matching on <code>Id</code>.
    </p>
    <div class="doc-controls">
        <button class="doc-btn" @onclick="RefreshKeyData" disabled="@keyRefreshing">
            @(keyRefreshing ? "Refreshing…" : "Refresh Data")
        </button>
        <span style="font-size:13px;color:#555">@keyStatusMessage</span>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <div>
            <div style="font-size:12px;font-weight:600;margin-bottom:6px;color:#666">Without KeyProperty</div>
            <NxGrid T="Person" Data="@keyPeopleNoKey"
                    SelectionMode="NxGridSelectionMode.Row"
                    @bind-SelectedItems="keySelectedNoKey"
                    Cursor="NxGridCursor.Pointer"
                    Style="height:220px">
                <NxGridColumn Property="@(x => x.Id)"        Width="50" MaxWidth="50" />
                <NxGridColumn Property="@(x => x.FirstName)" Width="120" />
                <NxGridColumn Property="@(x => x.LastName)"  Width="120" />
                <NxGridColumn Property="@(x => x.Department)" />
            </NxGrid>
            <div class="doc-output" style="min-height:24px">
                @(keySelectedNoKey.Count > 0
                    ? $"Selected: {keySelectedNoKey[0].FirstName} {keySelectedNoKey[0].LastName}"
                    : "No selection")
            </div>
        </div>
        <div>
            <div style="font-size:12px;font-weight:600;margin-bottom:6px;color:#666">With KeyProperty="@@(x => x.Id)"</div>
            <NxGrid T="Person" Data="@keyPeopleWithKey"
                    KeyProperty="@(x => x.Id)"
                    SelectionMode="NxGridSelectionMode.Row"
                    @bind-SelectedItems="keySelectedWithKey"
                    Cursor="NxGridCursor.Pointer"
                    Style="height:220px">
                <NxGridColumn Property="@(x => x.Id)"        Width="50" MaxWidth="50" />
                <NxGridColumn Property="@(x => x.FirstName)" Width="120" />
                <NxGridColumn Property="@(x => x.LastName)"  Width="120" />
                <NxGridColumn Property="@(x => x.Department)" />
            </NxGrid>
            <div class="doc-output" style="min-height:24px">
                @(keySelectedWithKey.Count > 0
                    ? $"Selected: {keySelectedWithKey[0].FirstName} {keySelectedWithKey[0].LastName}"
                    : "No selection")
            </div>
        </div>
    </div>
    <pre class="doc-code" style="margin-top:24px">@keyPropertySaveRefreshCode</pre>
</div>

<div class="doc-section">
    <h2>SelectRowByKey — Navigate to a Row by ID</h2>
    <p class="doc-para">
        <code>SelectRowByKey(keyValue)</code> selects the row whose <code>KeyProperty</code> value
        matches — without needing a reference to the row object. Useful after creating a new record
        or deep-linking from a URL parameter.
    </p>
    <div class="doc-controls">
        <label style="font-size:13px">Jump to ID:
            <input type="number" min="1" max="8" @bind="jumpToId" style="width:60px;margin-left:6px" />
        </label>
        <button class="doc-btn" @onclick="JumpToId">SelectRowByKey(@jumpToId)</button>
    </div>
    <NxGrid T="Person" @ref="keyNavGrid" Data="@keyNavPeople"
            KeyProperty="@(x => x.Id)"
            SelectionMode="NxGridSelectionMode.Row"
            @bind-SelectedItems="keyNavSelected"
            Cursor="NxGridCursor.Pointer"
            Style="height:240px">
        <NxGridColumn Property="@(x => x.Id)"        Width="50" MaxWidth="50" />
        <NxGridColumn Property="@(x => x.FirstName)" Width="130" />
        <NxGridColumn Property="@(x => x.LastName)"  Width="130" />
        <NxGridColumn Property="@(x => x.Department)" />
    </NxGrid>
    <div class="doc-output">
        @(keyNavSelected.Count > 0
            ? $"Selected: Id={keyNavSelected[0].Id} — {keyNavSelected[0].FirstName} {keyNavSelected[0].LastName}"
            : "No selection — enter an ID (1–8) and click the button")
    </div>
    <pre class="doc-code" style="margin-top:24px">@selectRowByKeyCode</pre>
</div>

<div class="doc-section">
    <h2>OnSelectionChanged</h2>
    <pre class="doc-code">@selectionCode</pre>
</div>

<div class="doc-section">
    <h2>Row Mode</h2>
    <pre class="doc-code">@selectionModeRowCode</pre>
</div>

<div class="doc-section">
    <h2>None Mode</h2>
    <pre class="doc-code">@selectionModeNoneCode</pre>
</div>

<div class="doc-section">
    <h2>Programmatic Selection — SelectRow()</h2>
    <pre class="doc-code">@selectRowCode</pre>
</div>

<div class="doc-section">
    <h2>NxGridSelectionRange&lt;T&gt; Properties</h2>
    <table class="doc-table">
        <thead>
            <tr><th>Property</th><th>Type</th><th>Description</th></tr>
        </thead>
        <tbody>
            <tr><td>StartRow / EndRow</td><td>int</td><td>First and last row index in the currently filtered/sorted data</td></tr>
            <tr><td>StartCol / EndCol</td><td>int</td><td>First and last column index (always 0 / last in Row mode)</td></tr>
            <tr><td>Items</td><td>List&lt;T&gt;</td><td>Unique row objects in the range</td></tr>
            <tr><td>Columns</td><td>List&lt;NxGridColumn&lt;T&gt;&gt;</td><td>Column objects in the range (all visible columns in Row mode)</td></tr>
        </tbody>
    </table>
</div>

@code {
    List<Person> clickPeople = SampleData.GetPeopleCopy();
    Person? clickedPerson;
    string? clickLog;

    void OnPersonClicked(NxGridCellClickArgs<Person> args)
    {
        clickedPerson = args.Row;
        clickLog = $"Clicked: {args.Row.FirstName} {args.Row.LastName} — column \"{args.Column.EffectiveTitle}\"";
    }

    List<Person> cellPeople  = SampleData.GetPeopleCopy();
    List<Person> rowPeople   = SampleData.GetPeopleCopy();
    List<Person> nonePeople  = SampleData.GetPeopleCopy();
    List<Person> multiPeople = SampleData.GetPeopleCopy();
    List<Person> bindPeople  = SampleData.GetPeopleCopy();
    List<Person> bindSelectedPeople = [];

    NxGrid<Person> cellGrid = null!;
    bool headerClickSelects;
    string cellLog = "";
    string multiLog = "";
    Person? selectedPerson;

    void OnCellSelectionChanged(NxGridSelectionArgs<Person> args)
    {
        var range = args.Ranges.FirstOrDefault();
        if (range == null) { cellLog = "No selection"; return; }

        var rows = range.EndRow - range.StartRow + 1;
        var cols = range.EndCol - range.StartCol + 1;
        var preview = range.Items.Take(3).Select(p => $"{p.FirstName} {p.LastName}");
        var names = string.Join(", ", preview) + (range.Items.Count > 3 ? "…" : "");

        cellLog =
            $"{rows} row{(rows == 1 ? "" : "s")} × {cols} col{(cols == 1 ? "" : "s")} " +
            $"[rows {range.StartRow}–{range.EndRow}, cols {range.StartCol}–{range.EndCol}]" +
            $"  →  {names}";
    }

    void OnRowSelectionChanged(NxGridSelectionArgs<Person> args)
    {
        selectedPerson = args.Ranges.FirstOrDefault()?.Items.FirstOrDefault();
    }

    async Task SelectAlice()
    {
        var alice = cellPeople.FirstOrDefault(p => p.FirstName == "Alice");
        if (alice != null) await cellGrid.SelectRow(alice);
    }

    void ClearCellLog() => cellLog = "";
    void ClearMultiLog() => multiLog = "";
    void ClearBindSelection() => bindSelectedPeople = [];

    void OnMultiSelectionChanged(NxGridSelectionArgs<Person> args)
    {
        if (args.Ranges.Count == 0) { multiLog = "No selection"; return; }

        var parts = args.Ranges.Select((r, i) =>
        {
            var rows = r.EndRow - r.StartRow + 1;
            var cols = r.EndCol - r.StartCol + 1;
            return $"Range {i + 1}: {rows}×{cols} [rows {r.StartRow}–{r.EndRow}, cols {r.StartCol}–{r.EndCol}]";
        });

        var totalCells = args.Ranges.Sum(r => (r.EndRow - r.StartRow + 1) * (r.EndCol - r.StartCol + 1));
        var totalRows  = args.Ranges.SelectMany(r => r.Items).Distinct().Count();

        multiLog = $"{args.Ranges.Count} range{(args.Ranges.Count == 1 ? "" : "s")}, " +
                   $"{totalCells} cell{(totalCells == 1 ? "" : "s")}, " +
                   $"{totalRows} unique row{(totalRows == 1 ? "" : "s")}" +
                   "\n" + string.Join("\n", parts);
    }

    // KeyProperty — stable selection demo
    List<Person> keyPeopleNoKey    = SampleData.GetPeopleCopy();
    List<Person> keyPeopleWithKey  = SampleData.GetPeopleCopy();
    List<Person> keySelectedNoKey  = [];
    List<Person> keySelectedWithKey = [];
    bool keyRefreshing;
    string keyStatusMessage = "Select a row in either grid, then click Refresh Data.";

    async Task RefreshKeyData()
    {
        keyRefreshing = true;
        keyStatusMessage = "Refreshing…";
        await Task.Delay(400);
        keyPeopleNoKey   = SampleData.GetPeopleCopy();
        keyPeopleWithKey = SampleData.GetPeopleCopy();
        keyRefreshing = false;
        keyStatusMessage = "Refreshed — check whether each grid preserved its selection.";
    }

    // SelectRowByKey demo
    NxGrid<Person> keyNavGrid = null!;
    List<Person> keyNavPeople   = SampleData.GetPeopleCopy();
    List<Person> keyNavSelected = [];
    int jumpToId = 1;

    async Task JumpToId()
    {
        await keyNavGrid.SelectRowByKey(jumpToId);
    }

    string keyPropertySaveRefreshCode = DemoCodeSamples.KeyPropertySaveRefresh;
    string selectRowByKeyCode         = DemoCodeSamples.SelectRowByKeyCode;

    string bindSelectedItemsCode = DemoCodeSamples.BindSelectedItems;
    string selectionCode        = DemoCodeSamples.Selection;
    string selectionModeRowCode = DemoCodeSamples.SelectionModeRow;
    string selectionModeNoneCode = DemoCodeSamples.SelectionModeNone;
    string selectRowCode        = DemoCodeSamples.SelectRow;
}
