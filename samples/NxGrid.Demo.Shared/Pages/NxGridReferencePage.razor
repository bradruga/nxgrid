            </tr>
            <tr>
                <td>EnableSelectionMath</td>
                <td>bool</td>
                <td>false</td>
                <td>Shows a Sum / Avg / Count status bar below the grid body for the current selection.</td>
                <td><a href="selection-math">Selection Math</a></td>
            </tr>
            <tr>
                <td>GroupBy</td>
                <td>Func&lt;T, object?&gt;?</td>
                <td>—</td>
                <td>Groups rows by this function's return value after filtering. Disables virtualization.</td>
                <td><a href="grouping">Row Grouping</a></td>
            </tr>
            <tr>
                <td>GroupHeaderTemplate</td>
                <td>RenderFragment&lt;NxGridGroupHeaderArgs&lt;T&gt;&gt;?</td>
                <td>—</td>
                <td>Custom markup for each group header row. When omitted renders "{GroupValue} ({Count})".</td>
                <td><a href="grouping">Row Grouping</a></td>
            </tr>
            <tr>
                <td>GroupsCollapsible</td>
                <td>bool</td>
                <td>true</td>
                <td>When true, clicking a group header collapses or expands that group.</td>
                <td><a href="grouping">Row Grouping</a></td>
            </tr>
            <tr>
                <td>GroupCollapsedWhen</td>
                <td>Func&lt;object?, bool&gt;?</td>
                <td>—</td>
                <td>Called once per group at first render to set the initial collapsed state.</td>
                <td><a href="grouping">Row Grouping</a></td>
            </tr>
        </tbody>
    </table>
</div>

<div class="doc-section">
    <h2>Content</h2>
    <table class="doc-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Notes</th><th>Sample Pages</th></tr></thead>
        <tbody>
            <tr>
                <td>ChildContent</td>
                <td>RenderFragment?</td>
                <td>—</td>
                <td>Where <code>NxGridColumn</code> declarations go. When omitted, columns are auto-generated from T's public readable properties.</td>
                <td></td>
            </tr>
            <tr>
                <td>EmptyTemplate</td>
                <td>RenderFragment?</td>
                <td>—</td>
                <td>Rendered centered in the grid body when there are no rows and <code>IsLoading</code> is false.</td>
                <td><a href="empty-state">Empty &amp; Loading State</a></td>
            </tr>
            <tr>
                <td>LoadingTemplate</td>
                <td>RenderFragment?</td>
                <td>—</td>
                <td>Rendered when <code>IsLoading</code> is true. With no rows it fills the body; with rows present it is shown as an overlay on top of the data (<code>pointer-events:none</code>).</td>
                <td><a href="empty-state">Empty &amp; Loading State</a></td>
            </tr>
            <tr>
                <td>IsLoading</td>
                <td>bool</td>
                <td>false</td>
                <td>When true, suppresses <code>EmptyTemplate</code> and shows <code>LoadingTemplate</code>. With rows already present the rows stay visible and <code>LoadingTemplate</code> overlays them. Set while an async fetch is in-flight to prevent an empty-state flash.</td>
                <td><a href="empty-state">Empty &amp; Loading State</a></td>
            </tr>
            <tr>
                <td>Overlays</td>
                <td>RenderFragment?</td>
                <td>—</td>
                <td>Rendered in an absolute-positioned, pointer-events-none layer above the grid — useful for custom row highlights.</td>
                <td><a href="layout">Layout</a></td>
            </tr>
        </tbody>
    </table>
</div>

