            </tr>
            <tr>
                <td>Cursor</td>
                <td>NxGridCursor</td>
                <td>Default</td>
                <td>CSS cursor applied to body cells: <code>Default</code>, <code>Cell</code>, or <code>Pointer</code>.</td>
