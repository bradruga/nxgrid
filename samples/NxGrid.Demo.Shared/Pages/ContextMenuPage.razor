@page "/context-menu"

<PageTitle>Context Menu — NxGrid</PageTitle>

<h1>Context Menu</h1>
<p class="doc-intro">
    Right-clicking any cell opens a context menu. The built-in <strong>Copy</strong> item is always present, and
    <strong>Copy with headers</strong> sits below it unless <code>ShowCopyWithHeaders="false"</code>.
    <strong>Paste</strong> appears only when the right-clicked cell is editable.
    In cell-selection mode a <strong>Focus Cell</strong> checkbox highlights the anchor row and column.
    Use <code>OnContextMenuShowing</code> to append custom items, and <code>OnContextMenuItemClicked</code>
    to handle them. The handler receives the right-clicked row and column along with the item that was selected.
</p>

<div class="doc-section">
    <h2>Custom items</h2>
    <p class="doc-note">
        Right-click any cell. Two custom items — <em>View details</em> and <em>Copy full name</em> — appear
        after Copy. <em>Copy full name</em> has a separator above it and a keyboard shortcut hint.
    </p>
    <div class="doc-controls">
        <span style="font-size:13px;color:#555;">Last action: <strong>@basicLog</strong></span>
    </div>
    <NxGrid T="Person" Data="@SampleData.People.ToList()"
            OnContextMenuShowing="@BuildBasicMenu"
            OnContextMenuItemClicked="@HandleBasicClick">
        <NxGridColumn Property="@(x => x.Id)"         MinWidth="50" MaxWidth="50" />
        <NxGridColumn Property="@(x => x.FirstName)"  Width="140" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="140" />
        <NxGridColumn Property="@(x => x.Department)" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@basicCode</pre>
</div>

<div class="doc-section">
    <h2>Dynamic items and disabled state</h2>
    <p class="doc-note">
        Items are tailored to the right-clicked row. Finance rows get an <em>Approve budget</em> item.
        <em>Archive</em> is always present but disabled for Engineering rows.
    </p>
    <div class="doc-controls">
        <span style="font-size:13px;color:#555;">Last action: <strong>@dynamicLog</strong></span>
    </div>
    <NxGrid T="Person" Data="@SampleData.People.ToList()"
            OnContextMenuShowing="@BuildDynamicMenu"
            OnContextMenuItemClicked="@HandleDynamicClick">
        <NxGridColumn Property="@(x => x.Id)"         MinWidth="50" MaxWidth="50" />
        <NxGridColumn Property="@(x => x.FirstName)"  Width="140" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="140" />
        <NxGridColumn Property="@(x => x.Department)" Width="160" />
        <NxGridColumn Property="@(x => x.Age)"        Width="70" Alignment="NxGridColumnAlignment.Right" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@dynamicCode</pre>
</div>

<div class="doc-section">
    <h2>Item sections</h2>
    <p class="doc-note">
        Use <code>Section</code> on any <code>NxGridContextMenuItem</code> to control placement.
        <strong>Header</strong> items appear above Copy. <strong>BeforeFocusCell</strong> items appear between Paste and Focus Cell.
        <strong>Footer</strong> items (the default) appear below all built-ins.
        Section boundaries receive a divider automatically — right-click any cell to see all three sections in action.
        <em>Delete</em> is disabled for Engineering rows.
    </p>
    <div class="doc-controls">
        <span style="font-size:13px;color:#555;">Last action: <strong>@sectionsLog</strong></span>
    </div>
    <NxGrid T="Person" Data="@SampleData.People.ToList()"
            AllowFocusCellMode="true"
            OnContextMenuShowing="@BuildSectionsMenu"
            OnContextMenuItemClicked="@HandleSectionsClick">
        <NxGridColumn Property="@(x => x.Id)"         MinWidth="50" MaxWidth="50" />
        <NxGridColumn Property="@(x => x.FirstName)"  Width="140" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="140" />
        <NxGridColumn Property="@(x => x.Department)" Width="160" />
        <NxGridColumn Property="@(x => x.Age)"        Width="70" Alignment="NxGridColumnAlignment.Right" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@sectionsCode</pre>
</div>

<div class="doc-section">
    <h2>Copy with headers and Paste</h2>
    <p class="doc-note">
        <strong>Copy with headers</strong> prepends a tab-separated header row to the copied TSV so column titles
        travel with the data. <strong>Paste</strong> appears only when the right-clicked cell is editable.
        Try copying a range with headers, then pasting it into a spreadsheet application.
        You can also copy from elsewhere and paste back into the grid. Untick the box below to hide
        <strong>Copy with headers</strong> from the menu — plain <strong>Copy</strong> and <kbd class="doc-kbd">Ctrl+C</kbd>
        keep working either way.
    </p>
    <div class="doc-controls">
        <label style="font-size:13px;"><input type="checkbox" @bind="showCopyWithHeaders" /> ShowCopyWithHeaders</label>
    </div>
    <NxGrid T="Person" Data="@pasteData"
            Editable="true"
            ShowCopyWithHeaders="@showCopyWithHeaders"
            OnUpdate="@HandlePasteUpdate">
        <NxGridColumn Property="@(x => x.FirstName)"  Width="140" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="140" />
        <NxGridColumn Property="@(x => x.Department)" />
        <NxGridColumn Property="@(x => x.Age)"        Width="70" Alignment="NxGridColumnAlignment.Right" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@copyHeadersCode</pre>
</div>

<div class="doc-section">
    <h2>Focus Cell</h2>
    <p class="doc-note">
        Right-click any cell and check <strong>Focus Cell</strong> to highlight the entire row and column of the
        selection anchor. The setting is stored in <code>localStorage</code> so it persists across page loads and
        is shared by all grids on the page. Set <code>AllowFocusCellMode="false"</code> to hide the option from
        the context menu entirely.
    </p>
    <NxGrid T="Person" Data="@SampleData.People.ToList()">
        <NxGridColumn Property="@(x => x.Id)"         MinWidth="50" MaxWidth="50" />
        <NxGridColumn Property="@(x => x.FirstName)"  Width="140" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="140" />
        <NxGridColumn Property="@(x => x.Department)" Width="160" />
        <NxGridColumn Property="@(x => x.Age)"        Width="70" Alignment="NxGridColumnAlignment.Right" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@focusCellCode</pre>
</div>

<div class="doc-section">
    <h2>Parameters</h2>
    <table class="doc-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Description</th></tr></thead>
        <tbody>
            <tr>
                <td>OnContextMenuShowing</td>
                <td>Action&lt;NxGridContextMenuArgs&lt;T&gt;&gt;?</td>
                <td>Called synchronously just before the context menu opens. Append <code>NxGridContextMenuItem</code> entries to <code>args.Items</code> to add custom items after the built-in items (Copy, Copy with headers, Paste).</td>
            </tr>
            <tr>
                <td>ShowCopyWithHeaders</td>
                <td>bool</td>
                <td>When <code>true</code> (default), the menu includes a <strong>Copy with headers</strong> item below <strong>Copy</strong>. Set to <code>false</code> to hide it; plain <strong>Copy</strong> and <code>Ctrl+C</code> are unaffected.</td>
            </tr>
            <tr>
                <td>OnContextMenuItemClicked</td>
                <td>EventCallback&lt;NxGridContextMenuItemArgs&lt;T&gt;&gt;</td>
                <td>Fires when the user selects a custom item. Receives the clicked <code>Item</code> plus the <code>Row</code> and <code>Column</code> that were right-clicked.</td>
            </tr>
        </tbody>
    </table>

    <h3 style="margin-top:20px">NxGridContextMenuItem properties</h3>
    <table class="doc-table">
        <thead><tr><th>Property</th><th>Type</th><th>Description</th></tr></thead>
        <tbody>
            <tr>
                <td>Id</td>
                <td>string</td>
                <td>Identifies which item was clicked. Returned in <code>OnContextMenuItemClicked</code> as <code>args.Item.Id</code>.</td>
            </tr>
            <tr>
                <td>Label</td>
                <td>string</td>
                <td>Text displayed in the menu.</td>
            </tr>
            <tr>
                <td>Separator</td>
                <td>bool</td>
                <td>When <code>true</code>, renders a divider line above this item.</td>
            </tr>
            <tr>
                <td>Disabled</td>
                <td>bool</td>
                <td>When <code>true</code>, renders the item grayed out and non-clickable. Clicking it does nothing.</td>
            </tr>
            <tr>
                <td>Shortcut</td>
                <td>string?</td>
                <td>Optional keyboard shortcut hint displayed on the right side of the item (e.g. <code>"Ctrl+Z"</code>). Purely decorative — the grid does not wire up the shortcut automatically.</td>
            </tr>
            <tr>
                <td>Section</td>
                <td>NxGridMenuSection</td>
                <td>Controls placement relative to built-in items. <code>Header</code> — above Copy. <code>BeforeFocusCell</code> — between Paste and Focus Cell. <code>Footer</code> — below all built-ins (default). Section boundaries receive a divider automatically.</td>
            </tr>
        </tbody>
    </table>
</div>

@code {
    string basicLog    = "none";
    string dynamicLog  = "none";
    string sectionsLog = "none";

    List<Person> pasteData = SampleData.People.Take(6).Select(p => new Person
    {
        Id         = p.Id,
        FirstName  = p.FirstName,
        LastName   = p.LastName,
        Department = p.Department,
        Age        = p.Age
    }).ToList();

    void HandlePasteUpdate(NxGridUpdateArgs<Person> args)
    {
        foreach (var row in args.Rows)
            foreach (var change in row.Changes)
                change.Apply(row.Row);
    }

    void BuildBasicMenu(NxGridContextMenuArgs<Person> args)
    {
        args.Items.Add(new NxGridContextMenuItem { Id = "view",      Label = "View details" });
        args.Items.Add(new NxGridContextMenuItem { Id = "copy-name", Label = "Copy full name", Separator = true, Shortcut = "Ctrl+Shift+C" });
    }

    void HandleBasicClick(NxGridContextMenuItemArgs<Person> args)
    {
        basicLog = args.Item.Id switch
        {
            "view"      => $"View details — {args.Row.FirstName} {args.Row.LastName}",
            "copy-name" => $"Copied \"{args.Row.FirstName} {args.Row.LastName}\"",
            _           => args.Item.Id
        };
    }

    void BuildDynamicMenu(NxGridContextMenuArgs<Person> args)
    {
        if (args.Row.Department == "Finance")
        {
            args.Items.Add(new NxGridContextMenuItem { Id = "approve", Label = "Approve budget" });
        }

        args.Items.Add(new NxGridContextMenuItem
        {
            Id        = "archive",
            Label     = "Archive",
            Separator = true,
            Disabled  = args.Row.Department == "Engineering"
        });
    }

    void HandleDynamicClick(NxGridContextMenuItemArgs<Person> args)
    {
        dynamicLog = args.Item.Id switch
        {
            "approve" => $"Approved budget for {args.Row.FirstName} {args.Row.LastName}",
            "archive" => $"Archived {args.Row.FirstName} {args.Row.LastName}",
            _         => args.Item.Id
        };
    }

    void BuildSectionsMenu(NxGridContextMenuArgs<Person> args)
    {
        args.Items.Add(new NxGridContextMenuItem { Id = "open",         Label = "Open profile",  Section = NxGridMenuSection.Header });
        args.Items.Add(new NxGridContextMenuItem { Id = "send-message", Label = "Send message",  Section = NxGridMenuSection.Header, Separator = true });
        args.Items.Add(new NxGridContextMenuItem { Id = "flag",         Label = "Flag row",      Section = NxGridMenuSection.BeforeFocusCell });
        args.Items.Add(new NxGridContextMenuItem { Id = "export",       Label = "Export row",    Section = NxGridMenuSection.Footer });
        args.Items.Add(new NxGridContextMenuItem { Id = "delete",       Label = "Delete",        Section = NxGridMenuSection.Footer, Separator = true, Disabled = args.Row.Department == "Engineering" });
    }

    void HandleSectionsClick(NxGridContextMenuItemArgs<Person> args)
    {
        sectionsLog = args.Item.Id switch
        {
            "open"         => $"Opened profile — {args.Row.FirstName} {args.Row.LastName}",
            "send-message" => $"Message sent to {args.Row.FirstName} {args.Row.LastName}",
            "flag"         => $"Flagged {args.Row.FirstName} {args.Row.LastName}",
            "export"       => $"Exported {args.Row.FirstName} {args.Row.LastName}",
            "delete"       => $"Deleted {args.Row.FirstName} {args.Row.LastName}",
            _              => args.Item.Id
        };
    }

    string basicCode     = DemoCodeSamples.ContextMenuBasic;
    string dynamicCode   = DemoCodeSamples.ContextMenuDynamic;
    string sectionsCode  = DemoCodeSamples.ContextMenuSections;
    bool showCopyWithHeaders = true;

    string copyHeadersCode = """
        <!-- Hide "Copy with headers" from the context menu -->
        <NxGrid T="Person" Data="@people" ShowCopyWithHeaders="false">
            ...
        </NxGrid>
        """;

    string focusCellCode = """
        <NxGrid T="Person" Data="@people">
            <NxGridColumn Property="@(x => x.FirstName)" />
            <NxGridColumn Property="@(x => x.LastName)"  />
            <NxGridColumn Property="@(x => x.Department)" />
        </NxGrid>

        <!-- Disable the option entirely -->
        <NxGrid T="Person" Data="@people" AllowFocusCellMode="false">
            ...
        </NxGrid>

        /* Override the highlight color in CSS */
        :root { --nx-grid-focus-cell-bg: #fff3cd; }
        """;
}
