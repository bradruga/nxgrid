@page "/columns"

<PageTitle>Columns — NxGrid</PageTitle>

<h1>Columns</h1>
<p class="doc-intro">
    <code>NxGridColumn&lt;T&gt;</code> controls how each column displays, sorts, and renders.
    Key features: custom cell templates, text alignment, <code>Property</code> for data binding,
    <code>Display</code> for formatted output, and min/max width constraints.
</p>

<div class="doc-section">
    <h2>Alignment</h2>
    <p class="doc-note">Use <code>Alignment</code> to control text alignment within cells. Numeric columns typically use Right alignment.</p>
    <NxGrid T="Person" Data="@SampleData.People.ToList()" Cursor="@NxGridCursor.Cell">
        <NxGridColumn Title="Name (Left)"    Property="@(x => x.FirstName)"  Width="180" Alignment="NxGridColumnAlignment.Left" />
        <NxGridColumn Title="Dept (Center)"  Property="@(x => x.Department)" Width="160" Alignment="NxGridColumnAlignment.Center" />
        <NxGridColumn Title="Age (Right)"    Property="@(x => x.Age)"        Width="130" Alignment="NxGridColumnAlignment.Right" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@alignmentCode</pre>
</div>

<div class="doc-section">
    <h2>Custom Templates</h2>
    <p class="doc-note">
        Use <code>Template</code> to render any content inside a cell. The grid still provides padding,
        borders, and selection highlighting — the template fills the inner content area.
        The <code>Context</code> attribute names the row object variable.
    </p>
    <NxGrid T="Person" Data="@SampleData.People.ToList()" Cursor="@NxGridCursor.Cell" RowHeight="32">
        <NxGridColumn Title="Name" Width="180">
            <Template>
                @context.FirstName @context.LastName
            </Template>
        </NxGridColumn>
        <NxGridColumn Property="@(x => x.Department)" Width="180">
            <Template Context="p">
                <span style="@GetDeptBadgeStyle(p)">@p.Department</span>
            </Template>
        </NxGridColumn>
        <NxGridColumn Property="@(x => x.Age)" Width="160" Alignment="NxGridColumnAlignment.Right">
            <Template Context="p">
                <div style="width:100%;display:flex;align-items:center;gap:8px;justify-content:flex-end;">
                    <div style="height:6px;background:#0078d4;border-radius:3px;width:@Math.Clamp(p.Age * 2, 4, 120)px;flex-shrink:0;"></div>
                    <span style="font-size:12px;color:#555;min-width:24px;text-align:right;">@p.Age</span>
                </div>
            </Template>
        </NxGridColumn>
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@templateCode</pre>
</div>

<div class="doc-section">
    <h2>Display — Formatted Output with Property Sort</h2>
    <p class="doc-note">
        <code>Property</code> drives sort and filter. <code>Display</code> overrides what is shown
        in the cell. Click the "Age" column header to sort — it sorts numerically even though the
        display value is a formatted string.
    </p>
    <NxGrid T="Person" Data="@SampleData.People.ToList()" Cursor="@NxGridCursor.Cell">
        <NxGridColumn Title="Name"            Display="@(x => x.FirstName + " " + x.LastName)" Width="180" />
        <NxGridColumn Title="Age — try sorting!"
                      Property="@(x => x.Age)" Display="@(x => x.Age + " yrs")"
                      Width="240" />
        <NxGridColumn Property="@(x => x.Department)" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@valueGetterCode</pre>
</div>

<div class="doc-section">
    <h2>SortValue — Edit Text, Sort by Number</h2>
    <p class="doc-note">
        The opposite split to <code>Display</code>: <code>Property</code> is the feet-and-inches text the
        user sees and edits (its setter parses it back to inches), and <code>SortValue</code> is the
        number to sort on. Sort the Length column — <code>9'-0"</code> comes before <code>10'-0"</code> —
        then press <kbd class="doc-kbd">F2</kbd> on a cell: the editor opens on the text. Type
        <code>12'-3"</code>, <code>8'</code> or <code>40</code> (inches).
    </p>
    <NxGrid T="PieceLength" Data="@pieceLengths" OnUpdate="@HandlePieceLengthUpdate"
            Cursor="@NxGridCursor.Cell" Editable="true">
        <NxGridColumn Property="@(x => x.Mark)" Width="100" Editable="false" />
        <NxGridColumn Title="Length" Property="@(x => x.LengthText)" SortValue="@(x => x.Length)" Width="120" />
        <NxGridColumn Title="Inches" Property="@(x => x.Length)" Width="90" Editable="false"
                      Alignment="NxGridColumnAlignment.Right" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@sortValueCode</pre>
</div>

<div class="doc-section">
    <h2>Width, MinWidth, MaxWidth</h2>
    <p class="doc-note">Drag any column resize grip to see the constraints in action. The Id column is fixed at 50px; the Name column can grow freely.</p>
    <NxGrid T="Person" Data="@SampleData.People.ToList()" Cursor="@NxGridCursor.Cell">
        <NxGridColumn Title="Id (fixed 50px)" Property="@(x => x.Id)"         MinWidth="50" MaxWidth="50" />
        <NxGridColumn Title="First (80–200)"  Property="@(x => x.FirstName)"  Width="120" MinWidth="80"  MaxWidth="200" />
        <NxGridColumn Title="Department (grows freely)" Property="@(x => x.Department)" Width="160" />
    </NxGrid>
    <table class="doc-table" style="margin-top:12px">
        <thead><tr><th>Parameter</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
            <tr><td>Width</td><td>100</td><td>Initial column width in pixels</td></tr>
            <tr><td>MinWidth</td><td>—</td><td>Minimum width the user can drag to</td></tr>
            <tr><td>MaxWidth</td><td>—</td><td>Maximum width the user can drag to. When null, the column grows to fill available space.</td></tr>
        </tbody>
    </table>
</div>

<div class="doc-section">
    <h2>Auto-size (Double-click)</h2>
    <p class="doc-note">
        Double-click any column's resize grip to auto-size it to fit its widest content.
        Because the grid is virtualized, column widths are estimated via a character-width
        prediction model built from the grid's font — accurate for the full dataset without
        requiring off-screen rows to be in the DOM.
    </p>
    <p class="doc-note">
        The columns below start narrow. Double-click a resize grip to fit them.
        Set <code>AutoSizable="false"</code> to disable this on a specific column.
    </p>
    <NxGrid T="Person" Data="@autoSizeData" Cursor="@NxGridCursor.Cell" Style="height:260px">
        <NxGridColumn Title="First Name"   Property="@(x => x.FirstName)"  Width="60" />
        <NxGridColumn Title="Last Name"    Property="@(x => x.LastName)"   Width="60" />
        <NxGridColumn Title="Department"   Property="@(x => x.Department)" Width="60" />
        <NxGridColumn Title="Age (no auto-size)" Property="@(x => x.Age)"  Width="60" AutoSizable="false" Alignment="NxGridColumnAlignment.Right" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@autoSizeCode</pre>
</div>

<div class="doc-section">
    <h2>Sortable, Resizable, Filterable</h2>
    <p class="doc-note">
        All three default to <code>true</code>. <code>Sortable="false"</code> stops the header
        title from cycling the sort and removes the three sort entries from the column menu.
        <code>Resizable="false"</code> omits the resize grip, so the column cannot be dragged or
        double-click auto-sized. <code>Filterable="false"</code> removes the filter panel —
        a <code>FilterState</code> set in code still applies.
    </p>
    <p class="doc-note">
        Try it below: <strong>Department</strong> cannot be sorted but can still be filtered and
        resized. <strong>Age</strong> sorts but has no grip. <strong>Last Name</strong> sorts and
        resizes but cannot be filtered. The <strong>Edit</strong> column has all four off plus
        <code>Freezable</code> and <code>Hideable</code> — with nothing left to show, it gets no
        ▾ button at all.
    </p>
    <NxGrid T="Person" Data="@SampleData.People.ToList()" Cursor="@NxGridCursor.Cell" HasColumnMenu="true">
        <NxGridColumn Property="@(x => x.FirstName)"  Width="160" />
        <NxGridColumn Property="@(x => x.Department)" Width="160" Sortable="false" />
        <NxGridColumn Property="@(x => x.Age)"        Width="90"  Resizable="false" Alignment="NxGridColumnAlignment.Right" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="140" Filterable="false" />
        <NxGridColumn Title="" Width="70" Sizing="NxGridColumnSizing.Fixed"
                      Sortable="false" Resizable="false" Filterable="false"
                      Freezable="false" Hideable="false">
            <Template><button class="demo-btn">Edit</button></Template>
        </NxGridColumn>
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@sortResizeCode</pre>
</div>

<div class="doc-section">
    <h2>FitContent</h2>
    <p class="doc-note">
        Columns automatically size to fit their widest data value on first render and whenever
        <code>Data</code> changes. <code>FitContent="Auto"</code> is the default — each fitted
        column snaps to its content width, and remaining space is distributed among
        <code>Sizing="Flex"</code> columns proportionally.
    </p>
    <p class="doc-note">
        Manually resize any column — it will keep its width across data changes.
        <code>FlexMinWidth</code> / <code>FlexMaxWidth</code> bound the measurement.
        Setting <code>Sizing="Fixed"</code> with an explicit <code>Width</code> automatically
        disables measurement (<code>Auto</code> infers <code>Never</code>). Use
        <code>FitContent="Never"</code> to opt out on a flex column with a declared basis.
        Use <code>FitColumnsAsync()</code> to re-fit programmatically.
    </p>
    <NxGrid T="Person" @ref="fitGrid" Data="@fitData" Cursor="@NxGridCursor.Cell" Style="height:260px">
        <NxGridColumn Title="First Name"  Property="@(x => x.FirstName)" />
        <NxGridColumn Title="Last Name"   Property="@(x => x.LastName)" />
        <NxGridColumn Title="Department"  Property="@(x => x.Department)" />
        <NxGridColumn Title="Age"         Property="@(x => x.Age)" Alignment="NxGridColumnAlignment.Right" FlexMaxWidth="80" />
    </NxGrid>
    <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap;">
        <button class="demo-btn" @onclick="ReloadFitData">Reload data</button>
        <button class="demo-btn" @onclick="@(async () => { if (fitGrid != null) await fitGrid.FitColumnsAsync(); })">Re-fit columns</button>
    </div>
    <pre class="doc-code" style="margin-top:12px">@fitColumnsCode</pre>
</div>

<div class="doc-section">
    <h2>Fixed Sizing</h2>
    <p class="doc-note">
        When every column is <code>Sizing="Fixed"</code>, nothing grows to fill the grid.
        Columns hold their declared widths, and row banding ends at the last column.
    </p>
    <NxGrid T="Person" Data="@SampleData.People.ToList()" Cursor="@NxGridCursor.Cell" Style="height:260px">
        <NxGridColumn Property="@(x => x.Id)"         Width="60"  Sizing="NxGridColumnSizing.Fixed" Alignment="NxGridColumnAlignment.Right" />
        <NxGridColumn Property="@(x => x.FirstName)"  Width="140" Sizing="NxGridColumnSizing.Fixed" />
        <NxGridColumn Property="@(x => x.Department)" Width="160" Sizing="NxGridColumnSizing.Fixed" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@fixedSizingCode</pre>
</div>

@code {
    string GetDeptBadgeStyle(Person p) => p.Department switch
    {
        "Engineering" => "background:#dbeafe;color:#1e40af;padding:2px 9px;border-radius:10px;font-size:12px;font-weight:600;white-space:nowrap;",
        "Finance"     => "background:#d1fae5;color:#065f46;padding:2px 9px;border-radius:10px;font-size:12px;font-weight:600;white-space:nowrap;",
        "Marketing"   => "background:#fef3c7;color:#92400e;padding:2px 9px;border-radius:10px;font-size:12px;font-weight:600;white-space:nowrap;",
        "HR"          => "background:#ede9fe;color:#5b21b6;padding:2px 9px;border-radius:10px;font-size:12px;font-weight:600;white-space:nowrap;",
        "Sales"       => "background:#fce7f3;color:#9d174d;padding:2px 9px;border-radius:10px;font-size:12px;font-weight:600;white-space:nowrap;",
        _             => "background:#f3f4f6;color:#374151;padding:2px 9px;border-radius:10px;font-size:12px;font-weight:600;white-space:nowrap;"
    };

    class PieceLength
    {
        public string Mark   { get; set; } = "";
        public double Length { get; set; }   // inches

        public string LengthText
        {
            get => $"{(int)(Length / 12)}'-{Length % 12:0.##}\"";
            set { if (TryParseFeetInches(value, out var inches)) Length = inches; }
        }

        // 10'-6", 10', 6" or plain inches
        static bool TryParseFeetInches(string? text, out double inches)
        {
            inches = 0;
            var m = System.Text.RegularExpressions.Regex.Match(text?.Trim() ?? "",
                @"^(?:(\d+(?:\.\d+)?)')?\s*-?\s*(?:(\d+(?:\.\d+)?)""?)?$");
            if (!m.Success || (!m.Groups[1].Success && !m.Groups[2].Success)) return false;
            var feet = m.Groups[1].Success ? double.Parse(m.Groups[1].Value) : 0;
            var rest = m.Groups[2].Success ? double.Parse(m.Groups[2].Value) : 0;
            inches = feet * 12 + rest;
            return true;
        }
    }

    List<PieceLength> pieceLengths =
    [
        new() { Mark = "W001", Length = 126 },
        new() { Mark = "W002", Length = 108 },
        new() { Mark = "W003", Length = 144 },
        new() { Mark = "C101", Length = 30 },
        new() { Mark = "C102", Length = 222 },
    ];

    void HandlePieceLengthUpdate(NxGridUpdateArgs<PieceLength> args)
    {
        foreach (var rowArgs in args.Rows)
            foreach (var change in rowArgs.Changes)
                change.Apply(rowArgs.Row);
    }

    List<Person> autoSizeData = SampleData.GeneratePeople(500);
    List<Person> fitData = SampleData.GeneratePeople(500);
    NxGrid<Person>? fitGrid;

    void ReloadFitData() => fitData = SampleData.GeneratePeople(500);

    string alignmentCode   = DemoCodeSamples.Alignment;
    string templateCode    = DemoCodeSamples.Template;
    string valueGetterCode = DemoCodeSamples.FormattedDisplay;
    string sortValueCode   = DemoCodeSamples.SortValue;
    string autoSizeCode    = DemoCodeSamples.AutoSize;
    string sortResizeCode  = DemoCodeSamples.SortableResizable;
    string fitColumnsCode  = DemoCodeSamples.FitColumns;
    string fixedSizingCode = DemoCodeSamples.FixedSizing;
}
