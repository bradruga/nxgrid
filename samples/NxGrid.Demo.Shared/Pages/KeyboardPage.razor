@page "/keyboard"

<PageTitle>Keyboard — NxGrid</PageTitle>

<h1>Keyboard</h1>
<p class="doc-intro">
    NxGrid supports full keyboard navigation and editing. All shortcuts work when the grid has focus.
    Click the grid below — or tab into it, which selects the top-left cell for you — and try any of
    the shortcuts in the table.
</p>

<div class="doc-section">
    <h2>Live Grid — Try the Shortcuts</h2>
    <div class="doc-controls">
        <span style="font-size:13px;color:#555;">Last key event: <strong>@keyLog</strong></span>
        <button class="doc-btn doc-btn-secondary" @onclick="@(() => keyLog = "")">Clear</button>
    </div>
    <NxGrid T="Person" Data="@kbPeople"
            OnKeyPressed="@OnKeyPressed"
            OnSelectionChanged="@OnSelectionChanged"
            OnUpdate="@HandleUpdate"
            RowGutter="NxGridRowGutter.Numbers"
            Cursor="@NxGridCursor.Cell"
            Editable="true">
        <NxGridColumn Property="@(x => x.Id)"        Width="50"  MaxWidth="50" Editable="false" />
        <NxGridColumn Property="@(x => x.FirstName)" Width="130" />
        <NxGridColumn Property="@(x => x.LastName)"  Width="130" />
        <NxGridColumn Property="@(x => x.Age)"       Width="70"  Alignment="NxGridColumnAlignment.Right" />
        <NxGridColumn Property="@(x => x.Department)" ComboBoxSource="@(NxGridComboSource.FixedList("Engineering", "Finance", "HR", "Marketing"))" />
    </NxGrid>
    <div class="doc-output">@selectionLog</div>
</div>

<div class="doc-section">
    <h2>OnKeyPressed — Custom Hotkeys</h2>
    <p class="doc-note">
        <code>OnKeyPressed</code> fires for keys the grid does not handle internally.
        Use it to add custom hotkeys (e.g. Ctrl+E to export) without losing grid focus.
        Try pressing <kbd class="doc-kbd">Ctrl+E</kbd>, <kbd class="doc-kbd">Ctrl+N</kbd>, or <kbd class="doc-kbd">Ctrl+Delete</kbd> in the grid above.
        (Plain <kbd class="doc-kbd">Delete</kbd> clears the selection and never reaches <code>OnKeyPressed</code>; only <kbd class="doc-kbd">Ctrl+Delete</kbd> is forwarded.)
    </p>
    <pre class="doc-code">@keyPressedCode</pre>
</div>

<div class="doc-section">
    <h2>Keyboard Reference</h2>
    <table class="doc-table">
        <thead>
            <tr><th>Key</th><th>Action</th></tr>
        </thead>
        <tbody>
            <tr><td><kbd class="doc-kbd">Tab</kbd> (into the grid)</td><td>Selects the top-left cell — the whole first row in the row-selection modes — and scrolls it into view, so the next key acts on a cell right away. An existing selection is kept; clicking into the grid never triggers it.</td></tr>
            <tr><td><kbd class="doc-kbd">Arrow keys</kbd></td><td>Move selection one cell — or commit edit and move when editing an empty cell (not started by F2)</td></tr>
            <tr><td><kbd class="doc-kbd">Shift+Arrow</kbd></td><td>Extend the selection rectangle</td></tr>
            <tr><td><kbd class="doc-kbd">Ctrl+Arrow</kbd> / <kbd class="doc-kbd">⌘+Arrow</kbd></td><td>Jump to the edge of the data block (Excel-style)</td></tr>
            <tr><td><kbd class="doc-kbd">Home</kbd> / <kbd class="doc-kbd">End</kbd></td><td>Jump to first / last column in the row</td></tr>
            <tr><td><kbd class="doc-kbd">Ctrl+Home</kbd> / <kbd class="doc-kbd">Ctrl+End</kbd></td><td>Jump to the very first / last cell</td></tr>
            <tr><td><kbd class="doc-kbd">Page Up</kbd> / <kbd class="doc-kbd">Page Down</kbd></td><td>Move by one page height</td></tr>
            <tr><td><kbd class="doc-kbd">Tab</kbd> / <kbd class="doc-kbd">Shift+Tab</kbd></td><td>Move right / left, wrapping to the next/previous row</td></tr>
            <tr><td><kbd class="doc-kbd">Tab</kbd> (last row)</td><td>Wraps back to the first row — unless <code>OnNewRow</code> is registered, in which case it appends a row instead. See <a href="new-row">New Row on Tab</a>.</td></tr>
            <tr><td><kbd class="doc-kbd">Enter</kbd> / <kbd class="doc-kbd">Shift+Enter</kbd></td><td>Move down / up one row</td></tr>
            <tr><td><kbd class="doc-kbd">Ctrl+Enter</kbd> / <kbd class="doc-kbd">⌘+Enter</kbd></td><td>While editing: apply the current value to every editable cell in the selection</td></tr>
            <tr><td><kbd class="doc-kbd">F2</kbd></td><td>Open edit mode (shows the existing value)</td></tr>
            <tr><td>Printable character</td><td>Open edit mode, replacing the current value</td></tr>
            <tr><td><kbd class="doc-kbd">Escape</kbd></td><td>Cancel the current edit and restore the original value</td></tr>
            <tr><td><kbd class="doc-kbd">Ctrl+A</kbd> / <kbd class="doc-kbd">⌘+A</kbd></td><td>Select all cells</td></tr>
            <tr><td><kbd class="doc-kbd">Ctrl+C</kbd> / <kbd class="doc-kbd">⌘+C</kbd></td><td>Copy the selection as TSV to the clipboard</td></tr>
            <tr><td><kbd class="doc-kbd">Ctrl+V</kbd> / <kbd class="doc-kbd">⌘+V</kbd></td><td>Paste TSV from the clipboard at the selection origin</td></tr>
            <tr><td><kbd class="doc-kbd">Delete</kbd></td><td>Clear selected cells (sets to "" or null if <code>Nullable=true</code>)</td></tr>
            <tr><td><kbd class="doc-kbd">Ctrl+Delete</kbd> / <kbd class="doc-kbd">⌘+Delete</kbd></td><td>Not handled internally — forwarded to <code>OnKeyPressed</code> so the host can bind it (e.g. delete the selected row)</td></tr>
        </tbody>
    </table>
</div>

@code {
    List<Person> kbPeople = SampleData.GetPeopleCopy();
    string keyLog = "none";
    string selectionLog = "Click the grid and use keyboard shortcuts…";

    async Task HandleUpdate(NxGridUpdateArgs<Person> args)
    {
        foreach (var rowArgs in args.Rows)
            foreach (var change in rowArgs.Changes)
                change.Apply(rowArgs.Row);
        await Task.CompletedTask;
    }

    void OnKeyPressed(NxGridKeyPressedArgs args)
    {
        var key = args.KeyboardEvent.Key;
        var mod = args.ModifierPressed ? "Ctrl+" : "";
        keyLog = $"{mod}{key} — custom hotkey fired";

        if (args.KeyboardEvent.Key == "e" && args.ModifierPressed)
            keyLog = "Ctrl+E — trigger export";
        else if (args.KeyboardEvent.Key == "n" && args.ModifierPressed)
            keyLog = "Ctrl+N — add new row";
        else if (args.KeyboardEvent.Key == "Delete" && args.ModifierPressed)
            keyLog = "Ctrl+Delete — delete the selected row";
    }

    void OnSelectionChanged(NxGridSelectionArgs<Person> args)
    {
        var range = args.Ranges.FirstOrDefault();
        if (range == null) { selectionLog = "No selection"; return; }
        var rows = range.EndRow - range.StartRow + 1;
        var cols = range.EndCol - range.StartCol + 1;
        selectionLog = $"Selection: {rows} row{(rows == 1 ? "" : "s")} × {cols} col{(cols == 1 ? "" : "s")} [rows {range.StartRow}–{range.EndRow}]";
    }

    string keyPressedCode = DemoCodeSamples.KeyPressed;
}
