@page "/reference/types"

<PageTitle>Types — NxGrid Reference</PageTitle>

<h1>Types</h1>
<p class="doc-intro">
    Supporting types, enums, and event argument classes used across the NxGrid API.
</p>

<div class="doc-section">
    <h2>Enums</h2>

    <h3>NxGridSelectionMode</h3>
    <p class="doc-note">Passed to the <code>SelectionMode</code> parameter on <code>NxGrid</code>. <a href="/selection">Selection</a></p>
    <table class="doc-table">
        <thead><tr><th>Value</th><th>Notes</th></tr></thead>
        <tbody>
            <tr>
                <td>Cell</td>
                <td>Rectangular cell-range selection. Mouse drag, Shift+click, and Shift+Arrow extend the range.</td>
            </tr>
            <tr>
                <td>Row</td>
                <td>Clicking any cell selects the entire row. Left/right arrows are no-ops.</td>
            </tr>
            <tr>
                <td>None</td>
                <td>No selection highlight or interaction. <code>OnSelectionChanged</code> never fires. Use for display-only grids.</td>
            </tr>
        </tbody>
    </table>

    <h3 style="margin-top:20px">NxGridRowGutter</h3>
    <p class="doc-note">Passed to <code>RowGutter</code> on <code>NxGrid</code>. <a href="/layout">Layout</a>, <a href="/row-drag-drop">Row Drag &amp; Drop</a></p>
    <table class="doc-table">
        <thead><tr><th>Value</th><th>Notes</th></tr></thead>
        <tbody>
            <tr>
                <td>Blank</td>
                <td>32 px gutter with no content (default).</td>
            </tr>
            <tr>
                <td>Hidden</td>
                <td>Gutter not rendered.</td>
            </tr>
            <tr>
                <td>Numbers</td>
                <td>1-based row numbers.</td>
            </tr>
            <tr>
                <td>DragHandle</td>
                <td>Drag handles for row reordering. Requires <code>OnRowDrop</code>. Hidden when an active sort or filter is applied.</td>
            </tr>
        </tbody>
    </table>

    <h3 style="margin-top:20px">NxGridCursor</h3>
    <p class="doc-note">Passed to <code>Cursor</code> on <code>NxGrid</code>. <a href="/layout">Layout</a></p>
    <table class="doc-table">
        <thead><tr><th>Value</th><th>Notes</th></tr></thead>
        <tbody>
            <tr>
                <td>Default</td>
                <td>Browser default cursor (arrow).</td>
            </tr>
            <tr>
                <td>Cell</td>
                <td>Spreadsheet-style crosshair cursor.</td>
            </tr>
            <tr>
                <td>Pointer</td>
                <td>Hand/pointer cursor — suits read-only or clickable rows.</td>
            </tr>
        </tbody>
    </table>

    <h3 style="margin-top:20px">NxGridColumnAlignment</h3>
    <p class="doc-note">Passed to <code>Alignment</code> on <code>NxGridColumn</code>. <a href="/columns">Columns</a></p>
    <table class="doc-table">
        <thead><tr><th>Value</th><th>Notes</th></tr></thead>
        <tbody>
            <tr>
                <td>Left</td>
                <td>Left-aligned text (default).</td>
            </tr>
            <tr>
                <td>Center</td>
                <td>Center-aligned text.</td>
            </tr>
            <tr>
                <td>Right</td>
                <td>Right-aligned text. Auto-assigned to numeric types in auto-column mode.</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="doc-section">
    <h2>NxGridComboItem</h2>
    <p class="doc-note">Used with <code>ComboBoxItems</code> on <code>NxGridColumn</code>. <code>Value</code> is written to the <code>Property</code> on commit; <code>Display</code> is shown in the dropdown list and in the non-editing cell.</p>
    <table class="doc-table">
        <thead><tr><th>Member</th><th>Notes</th></tr></thead>
        <tbody>
            <tr>
                <td>Value</td>
                <td><code>string?</code> — Written to the <code>Property</code> setter on selection.</td>
            </tr>
            <tr>
                <td>Display</td>
                <td><code>string?</code> — Shown in the dropdown list and in the non-editing cell when the stored value matches.</td>
            </tr>
        </tbody>
    </table>
    <pre class="doc-code" style="margin-top:12px">// Project any typed collection — no wrapper objects needed.
NxGridComboItem.From(source, value, display)

// String list shorthand — Value and Display are set to the same string.
NxGridComboItem.From(new[] { "Engineering", "Finance", "HR" })</pre>
</div>

<div class="doc-section">
    <h2>NxGridSelectionRange&lt;T&gt;</h2>
    <p class="doc-note">Exposed through <code>OnSelectionChanged</code> as <code>args.Ranges[0]</code>. Coordinates are always normalized (Start &le; End). <a href="/selection">Selection</a></p>
    <table class="doc-table">
        <thead><tr><th>Property</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr>
                <td>StartRow</td>
                <td>int</td>
                <td>First row index in the selection (normalized).</td>
            </tr>
            <tr>
                <td>EndRow</td>
                <td>int</td>
                <td>Last row index in the selection (normalized).</td>
            </tr>
            <tr>
                <td>StartCol</td>
                <td>int</td>
                <td>First column index in the selection (normalized).</td>
            </tr>
            <tr>
                <td>EndCol</td>
                <td>int</td>
                <td>Last column index in the selection (normalized).</td>
            </tr>
            <tr>
                <td>Items</td>
                <td>List&lt;T&gt;</td>
                <td>Distinct row objects in the selection.</td>
            </tr>
            <tr>
                <td>Columns</td>
                <td>List&lt;NxGridColumn&lt;T&gt;&gt;</td>
                <td>Column objects in the selection.</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="doc-section">
    <h2>NxGridCellChange&lt;T&gt;</h2>
    <p class="doc-note">One entry per changed cell inside <code>NxGridRowChange&lt;T&gt;.Changes</code>, received from <code>OnUpdate</code>. <a href="/editing">Editing</a>, <a href="/batch-update">Batch Update</a></p>
    <table class="doc-table">
        <thead><tr><th>Member</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr>
                <td>Column</td>
                <td>NxGridColumn&lt;T&gt;</td>
                <td>The column that was edited.</td>
            </tr>
            <tr>
                <td>OldValue</td>
                <td>object?</td>
                <td>The cell's value before the edit (from <code>Property</code> or <code>Display</code>).</td>
            </tr>
            <tr>
                <td>NewValue</td>
                <td>object?</td>
                <td>The typed value after the edit. Already parsed to the property's CLR type when <code>Property</code> points to a supported type.</td>
            </tr>
            <tr>
                <td>Apply(T row)</td>
                <td>void</td>
                <td>Writes <code>NewValue</code> back to the row via the <code>Property</code> setter. No-op when <code>Property</code> is not set or is get-only.</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="doc-section">
    <h2>Event Args</h2>
    <table class="doc-table">
        <thead><tr><th>Type</th><th>Raised by</th><th>Key Properties</th></tr></thead>
        <tbody>
            <tr>
                <td>NxGridSelectionArgs&lt;T&gt;</td>
                <td>OnSelectionChanged</td>
                <td><code>Ranges</code> — list of <code>NxGridSelectionRange&lt;T&gt;</code></td>
            </tr>
            <tr>
                <td>NxGridUpdateArgs&lt;T&gt;</td>
                <td>OnUpdate</td>
                <td><code>Rows</code> — <code>IReadOnlyList&lt;NxGridRowChange&lt;T&gt;&gt;</code>; each row has <code>Changes</code></td>
            </tr>
            <tr>
                <td>NxGridEditingArgs&lt;T&gt;</td>
                <td>OnEditing</td>
                <td><code>Row</code>, <code>Column</code>, <code>Cancel</code> (set to true to prevent editor opening)</td>
            </tr>
            <tr>
                <td>NxGridEditBlockedArgs&lt;T&gt;</td>
                <td>OnEditBlocked</td>
                <td><code>Row</code>, <code>Column</code></td>
            </tr>
            <tr>
                <td>NxGridCellClickArgs&lt;T&gt;</td>
                <td>OnCellClicked, OnCellDoubleClicked</td>
                <td><code>Row</code>, <code>Column</code></td>
            </tr>
            <tr>
                <td>NxGridColumnResizedArgs</td>
                <td>OnColumnResized</td>
                <td><code>ColumnIndex</code>, <code>NewWidth</code></td>
            </tr>
            <tr>
                <td>NxGridContextMenuArgs&lt;T&gt;</td>
                <td>OnContextMenuShowing</td>
                <td><code>Row</code>, <code>Column</code>, <code>Items</code> (append <code>NxGridContextMenuItem</code> here)</td>
            </tr>
            <tr>
                <td>NxGridContextMenuItemArgs&lt;T&gt;</td>
                <td>OnContextMenuItemClicked</td>
                <td><code>Item</code> (with <code>Id</code> and <code>Label</code>), <code>Row</code>, <code>Column</code></td>
            </tr>
            <tr>
                <td>NxGridRowDropArgs&lt;T&gt;</td>
                <td>OnRowDrop</td>
                <td><code>Row</code> (dragged row), <code>OldIndex</code>, <code>NewIndex</code></td>
            </tr>
            <tr>
                <td>NxGridTooltipContext&lt;T&gt;</td>
                <td>TooltipTemplate</td>
                <td><code>Row</code>, <code>Column</code>, <code>Data</code> (whatever <code>CellTooltip</code> returned)</td>
            </tr>
            <tr>
                <td>NxGridGroupHeaderArgs&lt;T&gt;</td>
                <td>GroupHeaderTemplate</td>
                <td><code>GroupValue</code>, <code>Items</code>, <code>IsCollapsed</code></td>
            </tr>
        </tbody>
    </table>
</div>
