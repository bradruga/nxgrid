@page "/combo-box"

<PageTitle>Combo Box — NxGrid</PageTitle>

<h1>Combo Box</h1>
<p class="doc-intro">
    Set <code>ComboBoxSource</code> on a column to turn its inline editor into a dropdown.
    Use <code>NxGridComboSource.FixedList</code> when the list is the same for every row — the selected
    item's <code>Id</code> is committed to the property and its <code>Text</code> is automatically
    shown in the non-editing cell, with no separate <code>Display</code> parameter required.
    Use <code>NxGridComboSource.VariableList</code> when the list depends on the row.
</p>

<div class="doc-section">
    <h2>String List</h2>
    <p class="doc-note">
        When <code>Id</code> and <code>Text</code> are the same, pass a plain string collection.
        Type to filter, press <kbd class="doc-kbd">↓</kbd> or click the chevron to open the full list.
    </p>
    <NxGrid T="Person" Data="@stringPeople" OnUpdate="@HandleStringUpdate"
            Cursor="@NxGridCursor.Cell" RowGutter="NxGridRowGutter.Numbers" Editable="true">
        <NxGridColumn Property="@(x => x.Id)"        Width="50"  MaxWidth="50" Editable="false" />
        <NxGridColumn Property="@(x => x.FirstName)" Width="130" />
        <NxGridColumn Property="@(x => x.LastName)"  Width="130" />
        <NxGridColumn Property="@(x => x.Department)"
                      ComboBoxSource="@(NxGridComboSource.FixedList("Engineering", "Finance", "HR", "Marketing", "Sales"))" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@stringListCode</pre>
</div>

<div class="doc-section">
    <h2>Object Projection</h2>
    <p class="doc-note">
        <code>NxGridComboSource.FixedList</code> projects any typed collection.
        Supply <code>id</code> and <code>text</code> selectors; the selected item's <code>Id</code>
        is stored in the property and its <code>Text</code> is shown in the cell.
    </p>
    <NxGrid T="TaskRow" Data="@taskRows" OnUpdate="@HandleTaskUpdate"
            Cursor="@NxGridCursor.Cell" RowGutter="NxGridRowGutter.Numbers" Editable="true">
        <NxGridColumn Property="@(x => x.Id)"       Width="50"  MaxWidth="50" Editable="false" />
        <NxGridColumn Property="@(x => x.Employee)" Width="140" Editable="false" />
        <NxGridColumn Property="@(x => x.TaskName)" Title="Task" Width="200"
                      ComboBoxSource="@(NxGridComboSource.FixedList(TaskOptions, t => t.Name))" />
        <NxGridColumn Property="@(x => x.Hours)"    Width="80" Alignment="NxGridColumnAlignment.Right" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@objectProjectionCode</pre>
</div>

<div class="doc-section">
    <h2>Key / Text (Foreign Key)</h2>
    <p class="doc-note">
        Store a foreign-key ID in the row while showing the human-readable name in the cell.
        Because <code>FixedList</code> builds a lookup dictionary from the source,
        the cell automatically resolves <code>Id</code>→<code>Text</code> with no extra
        <code>Display</code> parameter or denormalized column required.
    </p>
    <NxGrid T="ProductRow" Data="@colorRows" OnUpdate="@HandleColorUpdate"
            Cursor="@NxGridCursor.Cell" RowGutter="NxGridRowGutter.Numbers" Editable="true">
        <NxGridColumn Property="@(x => x.Id)"      Width="50"  MaxWidth="50" Editable="false" />
        <NxGridColumn Property="@(x => x.Product)" Width="160" Editable="false" />
        <NxGridColumn Property="@(x => x.ColorId)"
                      Title="Color"
                      ComboBoxSource="@(NxGridComboSource.FixedList(ColorOptions, c => c.Id, c => c.Name))" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@keyDisplayCode</pre>
</div>

<div class="doc-section">
    <h2>Custom Item Template</h2>
    <p class="doc-note">
        <code>ComboBoxItemTemplate</code> replaces the plain <code>Text</code> string in
        each dropdown row. The <code>Id</code> committed on selection is unchanged.
    </p>
    <NxGrid T="TaskRow" Data="@templateRows" OnUpdate="@HandleTemplateUpdate"
            Cursor="@NxGridCursor.Cell" RowGutter="NxGridRowGutter.Numbers" Editable="true">
        <NxGridColumn Property="@(x => x.Id)"       Width="50"  MaxWidth="50" Editable="false" />
        <NxGridColumn Property="@(x => x.Employee)" Width="140" Editable="false" />
        <NxGridColumn Property="@(x => x.TaskName)" Title="Task" Width="220"
                      ComboBoxSource="@(NxGridComboSource.FixedList(TaskOptions, t => t.Code, t => t.Name))">
            <ComboBoxItemTemplate Context="item">
                <span class="demo-combo-code">@item.Id</span>
                <span class="demo-combo-name">@item.Text</span>
            </ComboBoxItemTemplate>
        </NxGridColumn>
        <NxGridColumn Property="@(x => x.Hours)" Width="80" Alignment="NxGridColumnAlignment.Right" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@itemTemplateCode</pre>
</div>

<div class="doc-section">
    <h2>Per-Row Options</h2>
    <p class="doc-note">
        <code>NxGridComboSource.VariableList</code> receives the row, so the list can depend on any
        property. Type the row parameter explicitly so C# can infer the row type —
        <code>(ScheduleRow r) =&gt; …</code>. Here each team has its own skill set — open the
        dropdown on any row and the options change based on that row's <strong>Team</strong>.
    </p>
    <NxGrid T="ScheduleRow" Data="@scheduleRows" OnUpdate="@HandleScheduleUpdate"
            Cursor="@NxGridCursor.Cell" RowGutter="NxGridRowGutter.Numbers" Editable="true">
        <NxGridColumn Property="@(x => x.Employee)" Width="150" Editable="false" />
        <NxGridColumn Property="@(x => x.Team)"     Width="120" Editable="false" />
        <NxGridColumn Property="@(x => x.Skill)"    Width="180"
                      ComboBoxSource="@(NxGridComboSource.VariableList((ScheduleRow r) => SkillsByTeam.GetValueOrDefault(r.Team, []), s => s))" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@perRowCode</pre>
</div>

<div class="doc-section">
    <h2>Parameters</h2>
    <table class="doc-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Description</th></tr></thead>
        <tbody>
            <tr>
                <td>ComboBoxSource</td>
                <td>NxGridComboSource?</td>
                <td>
                    Turns the column into a combo-box editor. Use
                    <code>NxGridComboSource.FixedList(source, id, text)</code> for a fixed list —
                    the selected item's <code>Id</code> is committed via <code>Property</code> and
                    its <code>Text</code> is shown in the cell automatically.
                    Use <code>FixedList(source, id)</code> when id and text are the same value, or
                    <code>FixedList("a", "b", "c")</code> for a plain string list.
                    Use <code>NxGridComboSource.VariableList((Row r) =&gt; …, id, text)</code> when
                    the list depends on the row; omit <code>text</code> when it equals <code>id</code>.
                </td>
            </tr>
            <tr>
                <td>ComboBoxItemTemplate</td>
                <td>RenderFragment&lt;NxGridComboItem&gt;?</td>
                <td>Custom markup for each dropdown item. Replaces the plain <code>Text</code> string. The committed <code>Id</code> is unchanged.</td>
            </tr>
        </tbody>
    </table>
</div>

<style>
    .demo-combo-code {
        display: inline-block;
        font-family: monospace;
        font-size: 11px;
        font-weight: 600;
        background: #e0e7ff;
        color: #3730a3;
        border-radius: 3px;
        padding: 1px 5px;
        margin-right: 8px;
        min-width: 36px;
        text-align: center;
    }

    .demo-combo-name {
        font-size: 13px;
    }
</style>

@code {
    record TaskOption(string Code, string Name);

    static readonly TaskOption[] TaskOptions =
    [
        new("DEV", "Development"),
        new("QA",  "Quality Assurance"),
        new("MGT", "Project Management"),
        new("DOC", "Documentation"),
        new("MTG", "Meetings"),
    ];

    class TaskRow
    {
        public int    Id       { get; set; }
        public string Employee { get; set; } = "";
        public string TaskName { get; set; } = "";
        public int    Hours    { get; set; }
    }

    List<Person>  stringPeople  = SampleData.GetPeopleCopy();

    List<TaskRow> taskRows =
    [
        new() { Id = 1, Employee = "Alice Johnson",  TaskName = "Development",       Hours = 6 },
        new() { Id = 2, Employee = "Bob Smith",      TaskName = "Quality Assurance", Hours = 4 },
        new() { Id = 3, Employee = "Carol Williams", TaskName = "Project Management",Hours = 3 },
        new() { Id = 4, Employee = "David Brown",    TaskName = "Development",       Hours = 8 },
        new() { Id = 5, Employee = "Eve Davis",      TaskName = "Documentation",     Hours = 2 },
        new() { Id = 6, Employee = "Frank Miller",   TaskName = "Meetings",          Hours = 1 },
        new() { Id = 7, Employee = "Grace Wilson",   TaskName = "Quality Assurance", Hours = 5 },
        new() { Id = 8, Employee = "Henry Moore",    TaskName = "Development",       Hours = 7 },
    ];

    List<TaskRow> templateRows =
    [
        new() { Id = 1, Employee = "Alice Johnson",  TaskName = "DEV", Hours = 6 },
        new() { Id = 2, Employee = "Bob Smith",      TaskName = "QA",  Hours = 4 },
        new() { Id = 3, Employee = "Carol Williams", TaskName = "MGT", Hours = 3 },
        new() { Id = 4, Employee = "David Brown",    TaskName = "DEV", Hours = 8 },
        new() { Id = 5, Employee = "Eve Davis",      TaskName = "DOC", Hours = 2 },
        new() { Id = 6, Employee = "Frank Miller",   TaskName = "MTG", Hours = 1 },
    ];

    record ColorOption(int Id, string Name);

    static readonly ColorOption[] ColorOptions =
    [
        new(1, "Crimson Red"),
        new(2, "Sky Blue"),
        new(3, "Forest Green"),
        new(4, "Sunset Orange"),
        new(5, "Violet Purple"),
        new(6, "Golden Yellow"),
    ];

    class ProductRow
    {
        public int    Id        { get; set; }
        public string Product   { get; set; } = "";
        public int    ColorId   { get; set; }
    }

    List<ProductRow> colorRows =
    [
        new() { Id = 1, Product = "Interior Matt",  ColorId = 1 },
        new() { Id = 2, Product = "Exterior Gloss", ColorId = 2 },
        new() { Id = 3, Product = "Primer",         ColorId = 3 },
        new() { Id = 4, Product = "Chalk Paint",    ColorId = 4 },
        new() { Id = 5, Product = "Spray Can",      ColorId = 5 },
        new() { Id = 6, Product = "Enamel",         ColorId = 6 },
        new() { Id = 7, Product = "Undercoat",      ColorId = 1 },
        new() { Id = 8, Product = "Varnish",        ColorId = 2 },
    ];

    async Task HandleColorUpdate(NxGridUpdateArgs<ProductRow> args)
    {
        foreach (var rowArgs in args.Rows)
            foreach (var change in rowArgs.Changes)
                change.Apply(rowArgs.Row);
        await Task.CompletedTask;
    }

    class ScheduleRow
    {
        public string Employee { get; set; } = "";
        public string Team     { get; set; } = "";
        public string Skill    { get; set; } = "";
    }

    static readonly Dictionary<string, string[]> SkillsByTeam = new()
    {
        ["Frontend"]       = ["React", "TypeScript", "CSS", "Performance"],
        ["Backend"]        = ["C#", "SQL", "Redis", "RabbitMQ"],
        ["Infrastructure"] = ["Kubernetes", "Terraform", "CI/CD", "Monitoring"],
    };

    List<ScheduleRow> scheduleRows =
    [
        new() { Employee = "Alice Johnson",  Team = "Frontend",       Skill = "React" },
        new() { Employee = "Bob Smith",      Team = "Backend",        Skill = "C#" },
        new() { Employee = "Carol Williams", Team = "Infrastructure",  Skill = "Kubernetes" },
        new() { Employee = "David Brown",    Team = "Frontend",       Skill = "TypeScript" },
        new() { Employee = "Eve Davis",      Team = "Backend",        Skill = "SQL" },
        new() { Employee = "Frank Miller",   Team = "Infrastructure",  Skill = "Terraform" },
    ];

    async Task HandleScheduleUpdate(NxGridUpdateArgs<ScheduleRow> args)
    {
        foreach (var rowArgs in args.Rows)
            foreach (var change in rowArgs.Changes)
                change.Apply(rowArgs.Row);
        await Task.CompletedTask;
    }

    async Task HandleStringUpdate(NxGridUpdateArgs<Person> args)
    {
        foreach (var rowArgs in args.Rows)
            foreach (var change in rowArgs.Changes)
                change.Apply(rowArgs.Row);
        await Task.CompletedTask;
    }

    async Task HandleTaskUpdate(NxGridUpdateArgs<TaskRow> args)
    {
        foreach (var rowArgs in args.Rows)
            foreach (var change in rowArgs.Changes)
                change.Apply(rowArgs.Row);
        await Task.CompletedTask;
    }

    async Task HandleTemplateUpdate(NxGridUpdateArgs<TaskRow> args)
    {
        foreach (var rowArgs in args.Rows)
            foreach (var change in rowArgs.Changes)
                change.Apply(rowArgs.Row);
        await Task.CompletedTask;
    }

    string stringListCode        = DemoCodeSamples.ComboBoxStringList;
    string objectProjectionCode  = DemoCodeSamples.ComboBoxObjectProjection;
    string keyDisplayCode        = DemoCodeSamples.ComboBoxKeyDisplay;
    string itemTemplateCode      = DemoCodeSamples.ComboBoxItemTemplateCode;
    string perRowCode            = DemoCodeSamples.ComboBoxPerRow;
}
