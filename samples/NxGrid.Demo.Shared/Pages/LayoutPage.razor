@page "/layout"

<PageTitle>Layout Options — NxGrid</PageTitle>

<h1>Layout Options</h1>
<p class="doc-intro">
    NxGrid offers several layout and display parameters. Toggle the options below to see them in action.
    All parameters can be combined freely.
</p>

<div class="doc-section">
    <h2>Interactive Toggle Demo</h2>
    <div class="doc-controls">
        <label><input type="checkbox" @bind="showHeader" />    <strong>ShowHeader</strong></label>
        <label><input type="checkbox" @bind="rowBanding" />    <strong>RowBanding</strong></label>
        <label><input type="checkbox" @bind="hasColumnMenu" /> <strong>HasColumnMenu</strong></label>
        <label><input type="checkbox" @bind="headerClickSelects" /> <strong>HeaderClickSelects</strong></label>
    </div>
    <div class="doc-controls">
        <span style="font-size:13px;color:#555;font-weight:600;">RowGutter:</span>
        <label><input type="radio" name="rowgutter" @onchange="@(() => rowGutter = NxGridRowGutter.Blank)"      checked="@(rowGutter == NxGridRowGutter.Blank)" />      Blank</label>
        <label><input type="radio" name="rowgutter" @onchange="@(() => rowGutter = NxGridRowGutter.Hidden)"     checked="@(rowGutter == NxGridRowGutter.Hidden)" />     Hidden</label>
        <label><input type="radio" name="rowgutter" @onchange="@(() => rowGutter = NxGridRowGutter.Numbers)"    checked="@(rowGutter == NxGridRowGutter.Numbers)" />    Numbers</label>
        <label><input type="radio" name="rowgutter" @onchange="@(() => rowGutter = NxGridRowGutter.DragHandle)" checked="@(rowGutter == NxGridRowGutter.DragHandle)" /> DragHandle</label>
    </div>
    <div class="doc-controls">
        <label><input type="checkbox" checked="@gutterTemplate" @onchange="@ToggleGutterTemplate" /> <strong>RowGutterTemplate</strong> <span style="font-size:12px;color:#777;">(numbers by Id; rows 3–5 left out of Data, gap marked)</span></label>
        <label><strong>RowGutterWidth</strong> <input type="number" @bind="gutterWidth" min="16" max="120" style="width:60px" /></label>
    </div>
    <div class="doc-controls">
        <span style="font-size:13px;color:#555;font-weight:600;">Cursor:</span>
        <label><input type="radio" name="cursor" @onchange="@(() => cursor = NxGridCursor.Default)" checked="@(cursor == NxGridCursor.Default)" /> Default</label>
        <label><input type="radio" name="cursor" @onchange="@(() => cursor = NxGridCursor.Cell)"    checked="@(cursor == NxGridCursor.Cell)" />    Cell</label>
        <label><input type="radio" name="cursor" @onchange="@(() => cursor = NxGridCursor.Pointer)" checked="@(cursor == NxGridCursor.Pointer)" /> Pointer</label>
    </div>
    <NxGrid T="Person" Data="@shownPeople"
            ShowHeader="@showHeader"
            RowGutter="@rowGutter"
            RowGutterTemplate="@(gutterTemplate ? GutterCell : null)"
            RowGutterWidth="@gutterWidth"
            RowBanding="@rowBanding"
            HasColumnMenu="@hasColumnMenu"
            HeaderClickSelects="@headerClickSelects"
            Cursor="@cursor"
            OnRowDrop="@OnLayoutRowDrop"
            OnColumnResized="@OnColumnResized">
        <NxGridColumn Property="@(x => x.Id)"         Width="50"  MaxWidth="50" />
        <NxGridColumn Property="@(x => x.FirstName)"  Width="130" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="130" />
        <NxGridColumn Property="@(x => x.Age)"        Width="70"  Alignment="NxGridColumnAlignment.Right" />
        <NxGridColumn Property="@(x => x.Department)" />
    </NxGrid>
    <div class="doc-output">@resizeLog</div>
    <p class="doc-note" style="margin-top:12px">
        <code>RowGutterTemplate</code> renders the gutter cell's content and receives the row. The grid keeps the
        cell, the row-select click and the row-resize grip. Hidden rows are the motivating case: leave them out
        of <code>Data</code>, number from the row, and mark the gap. Widen the gutter with <code>RowGutterWidth</code>.
    </p>
    <pre class="doc-code">@gutterTemplateCode</pre>
</div>

<div class="doc-section">
    <h2>Overlays</h2>
    <p class="doc-note">
        The <code>Overlays</code> parameter renders a <code>RenderFragment</code> in an
        <code>absolute</code>-positioned, <code>pointer-events:none</code> layer that covers the entire grid.
        Use it for custom row highlights, tooltips, or annotations that sit on top of the grid content.
        The demo below highlights Finance rows with a yellow band.
    </p>
    <NxGrid T="Person" Data="@layoutPeople" HasColumnMenu="false">
        <ChildContent>
            <NxGridColumn Property="@(x => x.Id)"         Width="50"  MaxWidth="50" />
            <NxGridColumn Property="@(x => x.FirstName)"  Width="130" />
            <NxGridColumn Property="@(x => x.LastName)"   Width="130" />
            <NxGridColumn Property="@(x => x.Age)"        Width="70"  Alignment="NxGridColumnAlignment.Right" />
            <NxGridColumn Property="@(x => x.Department)" />
        </ChildContent>
        <Overlays>
            @for (var i = 0; i < layoutPeople.Count; i++)
            {
                if (layoutPeople[i].Department == "Finance")
                {
                    var top = (i + 1) * 28;
                    <div style="position:absolute;top:@(top)px;left:0;right:0;height:28px;background:rgba(234,179,8,0.12);border-left:3px solid rgba(234,179,8,0.6);pointer-events:none;"></div>
                }
            }
        </Overlays>
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@overlaysCode</pre>
</div>

<div class="doc-section">
    <h2>Layout Parameters</h2>
    <table class="doc-table">
        <thead><tr><th>Parameter</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
            <tr><td>ShowHeader</td><td>true</td><td>When <code>false</code>, the column header row is not rendered. Sort, filter, resize, and HasColumnMenu are unavailable.</td></tr>
            <tr><td>RowGutter</td><td>Blank</td><td><code>Blank</code> — empty gutter. <code>Hidden</code> — gutter not rendered. <code>Numbers</code> — 1-based row numbers. <code>DragHandle</code> — drag handles for row reordering; requires <code>OnRowDrop</code>.</td></tr>
            <tr><td>RowGutterTemplate</td><td>—</td><td>RenderFragment&lt;T&gt; rendering each row's gutter content in place of the number or blank. Ignored for <code>Hidden</code> and <code>DragHandle</code>.</td></tr>
            <tr><td>RowGutterWidth</td><td>32</td><td>Gutter width in pixels for every mode except <code>Hidden</code></td></tr>
            <tr><td>RowBanding</td><td>true</td><td>Alternates even/odd row background colors</td></tr>
            <tr><td>HasColumnMenu</td><td>true</td><td>Shows the ▾ button in each column header for sort and filter</td></tr>
            <tr><td>HeaderClickSelects</td><td>false</td><td>Click a column header to select the entire column; click the row-number gutter to select the entire row</td></tr>
            <tr><td>Cursor</td><td>Default</td><td>CSS cursor applied to body cells. <code>Default</code> → default, <code>Cell</code> → cell crosshair, <code>Pointer</code> → hand</td></tr>
            <tr><td>RowHeight</td><td>28</td><td>Row height in pixels — also controls the header height</td></tr>
            <tr><td>Class / Style</td><td>—</td><td>Extra CSS class or inline style applied to the outermost grid element</td></tr>
            <tr><td>Overlays</td><td>—</td><td>RenderFragment rendered in a pointer-events-none absolute layer above the grid</td></tr>
            <tr><td>OnColumnResized</td><td>—</td><td>EventCallback&lt;NxGridColumnResizedArgs&gt; — fires with ColumnIndex and NewWidth when a resize grip is dragged</td></tr>
        </tbody>
    </table>
</div>

@code {
    List<Person> layoutPeople = SampleData.GetPeopleCopy();
    List<Person> shownPeople = [];
    bool showHeader = true;
    NxGridRowGutter rowGutter = NxGridRowGutter.Blank;
    bool gutterTemplate;
    int gutterWidth = 32;

    protected override void OnInitialized() => shownPeople = layoutPeople;

    void ToggleGutterTemplate(ChangeEventArgs e)
    {
        gutterTemplate = (bool)e.Value!;
        shownPeople = gutterTemplate ? layoutPeople.Where(p => p.Id is < 3 or > 5).ToList() : layoutPeople;
    }

    bool HidesRowsBelow(Person p) => gutterTemplate && p.Id == 2;

    RenderFragment<Person> GutterCell => p =>
        @<span style="display:flex;align-items:center;justify-content:center;height:100%;font-size:11px;color:#666;@(HidesRowsBelow(p) ? "border-bottom:3px double #666;" : "")">@p.Id</span>;
    bool rowBanding = true;
    bool hasColumnMenu = true;
    bool headerClickSelects;
    NxGridCursor cursor = NxGridCursor.Cell;
    string resizeLog = "Drag a column resize grip to see OnColumnResized fire…";

    void OnColumnResized(NxGridColumnResizedArgs args)
    {
        resizeLog = $"OnColumnResized: column {args.ColumnIndex} → {args.NewWidth}px";
    }

    void OnLayoutRowDrop(NxGridRowDropArgs<Person> args)
    {
        var item = shownPeople[args.OldIndex];
        shownPeople.RemoveAt(args.OldIndex);
        shownPeople.Insert(args.NewIndex, item);
    }

    string overlaysCode = DemoCodeSamples.Overlays;
    string gutterTemplateCode = DemoCodeSamples.RowGutterTemplate;
}
