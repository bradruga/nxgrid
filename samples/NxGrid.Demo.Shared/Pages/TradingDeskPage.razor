    .td-dark .td-chip:hover { background: rgba(255,255,255,0.08); border-color: #6e7681; }
    .td-dark .td-badge-live   { background: #052e16; color: #4ade80; }
    .td-dark .td-badge-paused { background: #451a03; color: #fbbf24; }
    .td-dark .td-pulse-dot    { background: #4ade80; }
    .td-dark .td-btn-on       { background: #1e3a5f; border-color: #388bfd; color: #93c5fd; }
    .td-dark .td-chip-on      { background: #388bfd; color: #fff; }
    .td-dark .td-pos          { color: #4ade80; }
    .td-dark .td-neg          { color: #f87171; }
</style>

@code {
    // ── Constants ─────────────────────────────────────────────────────────────
    const int TickMs    = 1200;
    const int FlashMs   = 700;
    const int HistLen   = 30;

    static readonly string?[] SectorOptions =
        [null, "Technology", "Finance", "Healthcare", "Energy", "Retail", "Media"];

    // ── State ─────────────────────────────────────────────────────────────────
    NxGrid<StockRow>? grid;
    List<StockRow>    allStocks     = [];
    List<StockRow>    displayStocks = [];
    string?           sectorFilter  = null;
    bool              isLive        = true;
    bool              darkMode      = false;
    int               updateCount   = 0;
    string            lastTick      = "--:--:--";

    HashSet<string> flashSymbols = [];
    Timer? liveTimer;
    Timer? flashTimer;
    readonly Random rng = new(42);

    // Selection stats
    List<NxGridSelectionRange<StockRow>> selection = [];
    int     selectedCount;
    decimal selectedAvgChangePct;
    decimal selectedAvgPrice;
    string? selectedBest;
    string? selectedWorst;

    // Market overview stats
    int       gainers;
    int       losers;
    StockRow? marketTopGainer;
    StockRow? marketTopLoser;

    string ContainerClass  => $"td-container{(darkMode ? " td-dark" : "")}";
    string LiveBadgeClass  => $"td-live-badge {(isLive ? "td-badge-live" : "td-badge-paused")}";

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        InitStocks();
        ApplySectorFilter();
        UpdateMarketStats();
        liveTimer = new Timer(OnTimerTick, null, TickMs, TickMs);
    }

    public void Dispose()
    {
        liveTimer?.Dispose();
        flashTimer?.Dispose();
    }

    // ── Live updates ──────────────────────────────────────────────────────────

    void ToggleLive()
    {
        isLive = !isLive;
        liveTimer?.Change(isLive ? TickMs : Timeout.Infinite, isLive ? TickMs : Timeout.Infinite);
    }

    void OnTimerTick(object? _) => InvokeAsync(Tick);

    void Tick()
    {
        var count = rng.Next(6, 11);
        var indices = Enumerable.Range(0, allStocks.Count)
            .OrderBy(_ => rng.Next())
            .Take(count);

        var updated = new HashSet<string>();
        foreach (var i in indices)
        {
            var s = allStocks[i];
            var delta = (decimal)(rng.NextDouble() * 0.008 - 0.004);
            s.Price    = Math.Round(Math.Max(0.01m, s.Price * (1 + delta)), 2);
            s.Change   = Math.Round(s.Price - s.Open, 2);
            s.ChangePct = Math.Round(s.Open > 0 ? (s.Price - s.Open) / s.Open * 100 : 0, 3);

            var h = s.History.ToList();
            h.Add(s.Price);
            if (h.Count > HistLen) h.RemoveAt(0);
            s.History = [.. h];

            updated.Add(s.Symbol);
        }

        flashSymbols = updated;
        updateCount += count;
        lastTick = DateTime.Now.ToString("HH:mm:ss");
        UpdateMarketStats();
        UpdateSelectionStats();
        StateHasChanged();
        grid?.ForceRerender();

        flashTimer?.Dispose();
        flashTimer = new Timer(_ => InvokeAsync(() =>
        {
            flashSymbols.Clear();
            grid?.ForceRerender();
        }), null, FlashMs, Timeout.Infinite);
    }

    // ── Sector filter ─────────────────────────────────────────────────────────

    void SetSector(string? sector)
    {
        sectorFilter = sector;
        ApplySectorFilter();
        selectedCount = 0;
        selectedAvgChangePct = 0;
        selectedAvgPrice = 0;
        selectedBest = selectedWorst = null;
        selection.Clear();
    }

    void ApplySectorFilter()
    {
        displayStocks = sectorFilter == null
            ? allStocks
            : allStocks.Where(s => s.Sector == sectorFilter).ToList();
    }

    // ── Stats ─────────────────────────────────────────────────────────────────

    void UpdateMarketStats()
    {
        gainers        = allStocks.Count(s => s.ChangePct > 0);
        losers         = allStocks.Count(s => s.ChangePct < 0);
        marketTopGainer = allStocks.MaxBy(s => s.ChangePct);
        marketTopLoser  = allStocks.MinBy(s => s.ChangePct);
    }

    void HandleSelection(NxGridSelectionArgs<StockRow> args)
    {
        selection = args.Ranges;
        UpdateSelectionStats();
    }

    void UpdateSelectionStats()
    {
        var rows = GetSelectedRows();
        selectedCount = rows.Count;
        if (rows.Count == 0)
        {
            selectedAvgChangePct = 0; selectedAvgPrice = 0;
            selectedBest = selectedWorst = null;
            return;
        }
        selectedAvgChangePct = rows.Average(s => s.ChangePct);
        selectedAvgPrice     = rows.Average(s => s.Price);
        var best  = rows.MaxBy(s => s.ChangePct);
        var worst = rows.MinBy(s => s.ChangePct);
        selectedBest  = best  != null ? $"{best.Symbol} {(best.ChangePct  >= 0 ? "+" : "")}{best.ChangePct:F2}%"  : null;
        selectedWorst = worst != null ? $"{worst.Symbol} {worst.ChangePct:F2}%" : null;
    }

    List<StockRow> GetSelectedRows()
    {
        if (selection.Count == 0) return [];
        var rowIndices = new HashSet<int>();
        foreach (var range in selection)
            for (var r = range.StartRow; r <= range.EndRow; r++)
                rowIndices.Add(r);
        return rowIndices
            .Where(i => i >= 0 && i < displayStocks.Count)
            .Select(i => displayStocks[i])
            .Distinct()
            .ToList();
    }

    // ── Editing ───────────────────────────────────────────────────────────────

    void HandleUpdate(NxGridUpdateArgs<StockRow> args)
    {
        foreach (var rowArgs in args.Rows)
            foreach (var change in rowArgs.Changes)
                if (change.Column.Title == "Target")
                    rowArgs.Row.Target = decimal.TryParse(
                        change.NewValue?.ToString(), out var d) ? d : (decimal?)null;
    }

    // ── Cell styling ──────────────────────────────────────────────────────────

    NxGridCellStyle? GetCellStyle(StockRow row, NxGridColumn<StockRow> col)
    {
        var title     = col.Title ?? "";
        var isFlash   = flashSymbols.Contains(row.Symbol);
        var flashCss  = isFlash ? (darkMode ? "background:#1a3a28;" : "background:#fefce8;") : "";

        if (title is "Change" or "Chg %")
        {
            var intensity = (double)Math.Min(Math.Abs(row.ChangePct) / 4.5m, 1m);
            var alpha = (0.08 + intensity * 0.26).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
            if (row.ChangePct > 0)
            {
                var fg = darkMode ? "#4ade80" : "#15803d";
                return new NxGridCellStyle { Style = $"color:{fg};background:rgba(22,163,74,{alpha});font-weight:600;" };
            }
            if (row.ChangePct < 0)
            {
                var fg = darkMode ? "#f87171" : "#b91c1c";
                return new NxGridCellStyle { Style = $"color:{fg};background:rgba(220,38,38,{alpha});font-weight:600;" };
            }
            return flashCss.Length > 0 ? new NxGridCellStyle { Style = flashCss } : null;
        }

        if (title == "Target" && row.Target.HasValue)
        {
            var met = row.Price >= row.Target.Value;
            var fg  = met ? (darkMode ? "#4ade80" : "#15803d") : (darkMode ? "#f87171" : "#b91c1c");
            return new NxGridCellStyle { Style = $"color:{fg};font-weight:600;{flashCss}" };
        }

        return flashCss.Length > 0 ? new NxGridCellStyle { Style = flashCss } : null;
    }

    // ── Formatting ────────────────────────────────────────────────────────────

    static string FormatChange(decimal v)    => (v >= 0 ? "+" : "") + v.ToString("F2");
    static string FormatChangePct(decimal v) => (v >= 0 ? "+" : "") + v.ToString("F2") + "%";

    static string FormatVolume(long vk)
    {
        if (vk >= 1_000_000) return (vk / 1_000_000m).ToString("F1") + "B";
        if (vk >= 1_000)     return (vk / 1_000m).ToString("F1") + "M";
        return vk + "K";
    }

    static string FormatMarketCap(decimal b) =>
        b >= 1_000 ? (b / 1_000m).ToString("F1") + "T" : b.ToString("F0") + "B";

    // ── Sparkline ─────────────────────────────────────────────────────────────

    static string GetSparklinePoints(decimal[] history, int w, int h)
    {
        if (history.Length < 2) return "";
        var min = history.Min();
        var max = history.Max();
        var range = max - min;
        const int pad = 2;
        return string.Join(" ", history.Select((v, i) =>
        {
            var x = pad + (double)i / (history.Length - 1) * (w - 2 * pad);
            var y = range == 0
                ? (double)(h / 2)
                : pad + (double)(max - v) / (double)range * (h - 2 * pad);
            return $"{x:F1},{y:F1}";
        }));
    }

    // ── Data initialization ───────────────────────────────────────────────────

    void InitStocks()
    {
        var defs = new (string Sym, string Name, string Sector, decimal Price, long VolK, decimal CapB)[]
        {
            ("AAPL",  "Apple Inc.",           "Technology",  178.25m, 62_000, 2_760),
            ("MSFT",  "Microsoft Corp.",      "Technology",  412.50m, 25_000, 3_060),
            ("NVDA",  "NVIDIA Corp.",         "Technology",  875.60m, 43_000, 2_160),
            ("GOOGL", "Alphabet Inc.",        "Technology",  175.30m, 24_000, 2_190),
            ("META",  "Meta Platforms",       "Technology",  525.80m, 18_000, 1_340),
            ("AMZN",  "Amazon.com Inc.",      "Technology",  218.45m, 34_000, 2_290),
            ("JPM",   "JPMorgan Chase",       "Finance",     205.70m, 12_000,   595),
            ("GS",    "Goldman Sachs",        "Finance",     478.90m,  3_200,   159),
            ("BAC",   "Bank of America",      "Finance",      39.85m, 48_000,   306),
            ("V",     "Visa Inc.",            "Finance",     278.90m,  8_500,   572),
            ("JNJ",   "Johnson & Johnson",    "Healthcare",  158.20m,  7_800,   382),
            ("UNH",   "UnitedHealth Group",   "Healthcare",  525.40m,  3_900,   483),
            ("LLY",   "Eli Lilly & Co.",      "Healthcare",  832.50m,  3_100,   790),
            ("PFE",   "Pfizer Inc.",          "Healthcare",   28.40m, 28_000,   161),
            ("XOM",   "Exxon Mobil Corp.",    "Energy",      112.30m, 15_600,   448),
            ("CVX",   "Chevron Corp.",        "Energy",      152.60m,  8_200,   288),
            ("WMT",   "Walmart Inc.",         "Retail",       68.75m, 14_500,   552),
            ("TGT",   "Target Corp.",         "Retail",      165.30m,  5_900,    76),
            ("NFLX",  "Netflix Inc.",         "Media",       685.40m,  4_800,   295),
            ("DIS",   "Walt Disney Co.",      "Media",       113.60m, 12_000,   208),
        };

        var hr = new Random(123);
        allStocks = defs.Select(d =>
        {
            // Generate initial price history with a slight downtrend from open → current
            var h = new List<decimal>();
            var p = d.Price * (1 - (decimal)(hr.NextDouble() * 0.035));
            for (var i = 0; i < HistLen; i++)
            {
                p = Math.Max(0.01m, p * (1 + (decimal)(hr.NextDouble() * 0.008 - 0.004)));
                h.Add(Math.Round(p, 2));
            }

            var openDelta = (decimal)(hr.NextDouble() * 0.025 - 0.012);
            var open = Math.Round(d.Price * (1 - openDelta), 2);

            return new StockRow
            {
                Symbol     = d.Sym,
                Name       = d.Name,
                Sector     = d.Sector,
                Price      = d.Price,
                Open       = open,
                Change     = Math.Round(d.Price - open, 2),
                ChangePct  = Math.Round((d.Price - open) / open * 100, 3),
                VolumeK    = d.VolK,
                MarketCapB = d.CapB,
                History    = [.. h],
            };
        }).ToList();
    }

    // codeSnippet is defined in TradingDeskPage.razor.cs to avoid Rider raw-string-literal parse issues
}
