@page "/trading-desk"
@implements IDisposable
@using System.Threading
@using Microsoft.AspNetCore.Components.Web
@using NxGrid

<PageTitle>Trading Desk — NxGrid</PageTitle>

<h1>Trading Desk</h1>
<p class="doc-intro">
    A live market dashboard that puts NxGrid's most powerful features together: real-time data
    updates via <code>ForceRerender()</code>, conditional cell styling for P&amp;L color coding,
    <code>Template</code> sparklines, frozen columns, multi-range selection with aggregation, and
    inline price-target editing — all in a single component.
</p>

<div class="@ContainerClass" style="border:1px solid var(--nx-grid-border,#ddd); border-radius:6px; overflow:hidden; margin-bottom:8px;">

    @* ── Toolbar ── *@
    <div class="td-toolbar">
        <div class="@LiveBadgeClass">
            @if (isLive) { <span class="td-pulse-dot"></span> }
            @(isLive ? "LIVE" : "PAUSED")
        </div>

        <button class="td-btn" @onclick="ToggleLive">@(isLive ? "⏸ Pause" : "▶ Resume")</button>

        <div class="td-sep-v"></div>

        @foreach (var s in SectorOptions)
        {
            var sector = s;
            <button class="td-chip @(sectorFilter == sector ? "td-chip-on" : "")"
                    @onclick="@(() => SetSector(sector))">
                @(sector ?? "All")
            </button>
        }

        <div class="td-sep-v"></div>

        <button class="td-btn @(darkMode ? "td-btn-on" : "")" @onclick="@(() => darkMode = !darkMode)">
            @(darkMode ? "☀ Light" : "🌙 Dark")
        </button>

        <span style="margin-left:auto; font-size:11px; opacity:0.5;">
            @updateCount updates · last tick @lastTick
        </span>
    </div>

    @* ── Grid ── *@
    <NxGrid T="StockRow"
            @ref="grid"
            Data="@displayStocks"
            Style="height:460px"
            RowHeight="30"
            Cursor="NxGridCursor.Cell"
            Editable="true"
            CellEditableGetter="@((row, col) => col.Title == "Target")"
            RowBanding="true"
            CellStyle="@GetCellStyle"
            OnSelectionChanged="@HandleSelection"
            OnUpdate="@HandleUpdate">

        <NxGridColumn T="StockRow" Title="Symbol"
                      Property="@(x => x.Symbol)"
                      Width="72" MinWidth="72" MaxWidth="72"
                      Frozen="true" />

        <NxGridColumn T="StockRow" Title="Name"
                      Property="@(x => x.Name)"
                      Width="162" MinWidth="130"
                      Frozen="true" />

        <NxGridColumn T="StockRow" Title="Sector"
                      Property="@(x => x.Sector)"
                      Width="110" MinWidth="100" />

        <NxGridColumn T="StockRow" Title="Price"
                      Property="@(x => x.Price)"
                      Display="@(x => x.Price.ToString("F2"))"
                      Width="88" Alignment="NxGridColumnAlignment.Right" />

        <NxGridColumn T="StockRow" Title="Change"
                      Property="@(x => x.Change)"
                      Display="@(x => FormatChange(x.Change))"
                      Width="82" Alignment="NxGridColumnAlignment.Right" />

        <NxGridColumn T="StockRow" Title="Chg %"
                      Property="@(x => x.ChangePct)"
                      Display="@(x => FormatChangePct(x.ChangePct))"
                      Width="82" Alignment="NxGridColumnAlignment.Right" />

        <NxGridColumn T="StockRow" Title="Volume"
                      Property="@(x => x.VolumeK)"
                      Display="@(x => FormatVolume(x.VolumeK))"
                      Width="86" Alignment="NxGridColumnAlignment.Right" />

        <NxGridColumn T="StockRow" Title="Mkt Cap"
                      Property="@(x => x.MarketCapB)"
                      Display="@(x => FormatMarketCap(x.MarketCapB))"
                      Width="82" Alignment="NxGridColumnAlignment.Right" />

        <NxGridColumn T="StockRow" Title="Target"
                      Display="@(x => x.Target.HasValue ? x.Target.Value.ToString("F2") : "")"
                      Width="76" Alignment="NxGridColumnAlignment.Right" />

        <NxGridColumn T="StockRow" Title="Trend"
                      Width="84" MinWidth="84" MaxWidth="84">
            <Template Context="row">
                <svg width="76" height="24" viewBox="0 0 76 24" style="display:block;overflow:visible;">
                    @if (row.History.Length >= 2)
                    {
                        <polyline points="@GetSparklinePoints(row.History, 76, 24)"
                                  fill="none"
                                  stroke="@(row.ChangePct >= 0 ? (darkMode ? "#4ade80" : "#16a34a") : (darkMode ? "#f87171" : "#dc2626"))"
                                  stroke-width="1.5"
                                  stroke-linejoin="round"
                                  stroke-linecap="round" />
                    }
                </svg>
            </Template>
        </NxGridColumn>

    </NxGrid>

    @* ── Stats bar ── *@
    <div class="td-stats">
        @if (selectedCount > 0)
        {
            <span class="td-stat"><strong>@selectedCount</strong> selected</span>
            <span class="td-stat-sep">|</span>
            <span class="td-stat">
                Avg Chg: <strong class="@(selectedAvgChangePct >= 0 ? "td-pos" : "td-neg")">
                    @((selectedAvgChangePct >= 0 ? "+" : "") + selectedAvgChangePct.ToString("F2"))%
                </strong>
            </span>
            <span class="td-stat-sep">|</span>
            <span class="td-stat">Avg Price: <strong>$@selectedAvgPrice.ToString("F2")</strong></span>
            @if (selectedBest != null)
            {
                <span class="td-stat-sep">|</span>
                <span class="td-stat">Best: <strong class="td-pos">@selectedBest</strong></span>
            }
            @if (selectedWorst != null)
            {
                <span class="td-stat-sep">|</span>
                <span class="td-stat">Worst: <strong class="td-neg">@selectedWorst</strong></span>
            }
        }
        else
        {
            <span class="td-stat"><strong class="td-pos">@gainers</strong> gainers</span>
            <span class="td-stat-sep">|</span>
            <span class="td-stat"><strong class="td-neg">@losers</strong> losers</span>
            @if (marketTopGainer != null)
            {
                <span class="td-stat-sep">|</span>
                <span class="td-stat">
                    Top: <strong class="td-pos">
                        @marketTopGainer.Symbol &nbsp;+@marketTopGainer.ChangePct.ToString("F2")%
                    </strong>
                </span>
            }
            @if (marketTopLoser != null)
            {
                <span class="td-stat-sep">|</span>
                <span class="td-stat">
                    Worst: <strong class="td-neg">
                        @marketTopLoser.Symbol &nbsp;@marketTopLoser.ChangePct.ToString("F2")%
                    </strong>
                </span>
            }
            <span class="td-stat-sep">|</span>
            <span class="td-stat" style="opacity:0.6;">
                Select rows to see aggregates
            </span>
        }
    </div>
</div>

<div class="doc-section">
    <h2>How it works</h2>
    <p class="doc-note">
        A <code>System.Threading.Timer</code> fires every 1.2 seconds on a thread-pool thread and calls
        <code>InvokeAsync</code> to update 6–10 random stock prices on the Blazor sync context, then
        calls <code>ForceRerender()</code>. <code>CellStyle</code> maps P&amp;L magnitude to a green/red
        RGBA background — the more extreme the move, the deeper the color. A flash overlay applies briefly
        to each updated row. The <code>Template</code> column draws SVG polylines from a rolling 30-point
        price history. The <code>Target</code> column is editable — double-click to set your price target;
        it turns green when the live price hits it.
    </p>
    <pre class="doc-code">@codeSnippet</pre>
</div>

<style>
    /* ── Container / dark mode ── */
    .td-container { background: var(--nx-grid-surface, #fff); }

    .td-dark {
        --nx-grid-surface:        #0d1117;
        --nx-grid-row-even-bg:    #161b22;
        --nx-grid-row-odd-bg:     #1c2128;
        --nx-grid-header-bg:      #1c2128;
        --nx-grid-border:         #30363d;
        --nx-grid-header-border:  #444c56;
        --nx-grid-hover-bg:       #21262d;
        --nx-grid-item-hover-bg:  #1e3a5f;
        --nx-grid-selection-bg:   #2d4b73;
        --nx-grid-selected-border:#4d7cc7;
        --nx-grid-selection-border:#4d7cc7;
        --nx-grid-accent:         #388bfd;
        --nx-grid-accent-dark:    #1f6feb;
        --nx-grid-row-number-fg:  #6e7681;
        --nx-grid-icon-fg:        #c9d1d9;
        --nx-grid-icon-muted-fg:  #8b949e;
        --nx-grid-muted-fg:       #6e7681;
        --nx-grid-group-header-bg:#21262d;
        --nx-grid-group-header-fg:#c9d1d9;
        --nx-grid-shadow:         rgba(0,0,0,0.4);
        background: #0d1117;
        color: #c9d1d9;
    }

    /* ── Toolbar ── */
    .td-toolbar {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 7px 10px;
        border-bottom: 1px solid var(--nx-grid-border, #ddd);
        background: var(--nx-grid-header-bg, #f8f9fa);
        flex-wrap: wrap;
    }

    /* ── Live badge ── */
    .td-live-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 2px 9px;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        margin-right: 4px;
    }
    .td-badge-live   { background: #dcfce7; color: #15803d; }
