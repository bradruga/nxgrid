        background: transparent; color: inherit;
        font-size: 11px; cursor: pointer; white-space: nowrap;
    }
    .td-chip:hover      { background: #e2e8f0; border-color: #94a3b8; }
    .td-chip-on:hover   { background: var(--nx-grid-accent, #0055b3); border-color: transparent; }
