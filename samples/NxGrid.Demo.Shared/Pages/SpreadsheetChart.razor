@namespace NxGrid.Demo.Shared.Pages
@using System.Text
@using System.Text.RegularExpressions
@inject IJSRuntime JS
@implements IDisposable

<div style="position:absolute; left:@(Chart.X.ToString("F0"))px; top:@(Chart.Y.ToString("F0"))px;
            width:@(Chart.Width.ToString("F0"))px; height:@(Chart.Height.ToString("F0"))px;
            pointer-events:auto; background:#fff; border:1px solid #ccc;
            border-radius:4px; box-shadow:0 2px 8px rgba(0,0,0,.12);
            display:flex; flex-direction:column; overflow:hidden;">

    @* Title bar – drag handle *@
    <div style="display:flex; align-items:center; height:26px; padding:0 6px;
                background:#f5f5f5; border-bottom:1px solid #ddd;
                border-radius:4px 4px 0 0; cursor:move; user-select:none; flex-shrink:0;"
         @onmousedown="OnDragStart" @onmousedown:preventDefault>
        <span style="flex:1; font-size:12px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
            @Chart.Title
        </span>
        <button type="button"
                style="border:none; background:none; cursor:pointer; padding:0 3px; color:#888; font-size:13px; line-height:1;"
                @onmousedown:stopPropagation @onclick="@(() => OnDelete.InvokeAsync())">✕</button>
    </div>

    @* SVG chart — built as MarkupString to avoid Razor <text> tag conflicts *@
    <div style="flex:1; overflow:hidden;">
        @BuildSvg()
    </div>

    @* Resize handle *@
    <div style="position:absolute; bottom:3px; right:3px; width:14px; height:14px; cursor:se-resize; opacity:0.4;"
         @onmousedown="OnResizeStart" @onmousedown:preventDefault>
        <svg viewBox="0 0 10 10" width="10" height="10">
            <polyline points="2,10 10,10 10,2" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round"/>
            <polyline points="6,10 10,10 10,6" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
    </div>
</div>

@code {
    [Parameter] public SpreadsheetChartDef      Chart             { get; set; } = null!;
    [Parameter] public Func<int, int, string>   CellDisplayGetter { get; set; } = null!;
    [Parameter] public int                      RowCount          { get; set; }
    [Parameter] public int                      ColCount          { get; set; }
    [Parameter] public int                      DataVersion       { get; set; }
    [Parameter] public EventCallback            OnDelete          { get; set; }
    [Parameter] public EventCallback            OnChanged         { get; set; }

    private IJSObjectReference?                      _module;
    private DotNetObjectReference<SpreadsheetChart>? _dotNetRef;

    private static readonly Regex RangeRx =
        new(@"^(\$?)([A-Za-z])(\$?)(\d+):(\$?)([A-Za-z])(\$?)(\d+)$", RegexOptions.Compiled);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module    = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/NxGrid.Demo.Shared/demo.js");
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    private async Task OnDragStart(MouseEventArgs e)
    {
        if (_module == null) return;
        await _module.InvokeVoidAsync("startChartDrag", _dotNetRef, e.ClientX, e.ClientY, Chart.X, Chart.Y);
    }

    [JSInvokable]
    public void OnDragMove(double x, double y) { Chart.X = Math.Max(0, x); Chart.Y = Math.Max(0, y); StateHasChanged(); }

    [JSInvokable]
    public async Task OnDragEnd() => await OnChanged.InvokeAsync();

    private async Task OnResizeStart(MouseEventArgs e)
    {
        if (_module == null) return;
        await _module.InvokeVoidAsync("startChartResize", _dotNetRef, e.ClientX, e.ClientY, Chart.Width, Chart.Height);
    }

    [JSInvokable]
    public void OnResizeMove(double w, double h) { Chart.Width = w; Chart.Height = h; StateHasChanged(); }

    [JSInvokable]
    public async Task OnResizeEnd() => await OnChanged.InvokeAsync();

    private record ChartPoint(string Label, double Y);
    private record ChartSeries(string Name, List<ChartPoint> Points);

    private MarkupString BuildSvg()
    {
        var svgW  = (int)Chart.Width;
        var svgH  = Math.Max(60, (int)Chart.Height - 26);
        const int padL = 52, padR = 12, padT = 14, padB = 32;
        var plotW = Math.Max(10, svgW - padL - padR);
        var plotH = Math.Max(10, svgH - padT - padB);

        var (seriesList, xLabels) = GetChartData();
        var allVals = seriesList.SelectMany(s => s.Points.Select(p => p.Y)).ToList();
        var minVal  = allVals.Count > 0 ? allVals.Min() : 0;
        var maxVal  = allVals.Count > 0 ? allVals.Max() : 1;
        if (maxVal <= minVal) maxVal = minVal + 1;
        var valRange = maxVal - minVal;

        double ToX(int i, int n) => padL + (n > 1 ? (double)i / (n - 1) * plotW : plotW / 2.0);
        double ToY(double v)     => padT + plotH - (v - minVal) / valRange * plotH;
        string F(double d)       => d.ToString("F1");

        string[] palette = ["#2196F3", "#F44336", "#4CAF50", "#FF9800", "#9C27B0", "#00BCD4", "#795548"];

        var sb = new StringBuilder();
        sb.Append($"<svg width=\"{svgW}\" height=\"{svgH}\" style=\"font-family:sans-serif;display:block;\" xmlns=\"http://www.w3.org/2000/svg\">");

        if (seriesList.Count == 0 || allVals.Count == 0)
        {
            sb.Append($"<text x=\"{svgW / 2}\" y=\"{svgH / 2}\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"11\" fill=\"#aaa\">Set a Data Range to show a chart</text>");
        }
        else
        {
            // Y-axis grid lines and labels
            for (var t = 0; t <= 4; t++)
            {
                var tv = minVal + valRange * (4 - t) / 4;
                var ty = padT + t * plotH / 4.0;
                sb.Append($"<line x1=\"{padL - 4}\" y1=\"{F(ty)}\" x2=\"{padL}\" y2=\"{F(ty)}\" stroke=\"#bbb\" stroke-width=\"1\"/>");
                sb.Append($"<line x1=\"{padL}\" y1=\"{F(ty)}\" x2=\"{padL + plotW}\" y2=\"{F(ty)}\" stroke=\"#eee\" stroke-width=\"1\" stroke-dasharray=\"3,2\"/>");
                sb.Append($"<text x=\"{padL - 6}\" y=\"{F(ty)}\" text-anchor=\"end\" dominant-baseline=\"middle\" font-size=\"9\" fill=\"#888\">{FormatLabel(tv)}</text>");
            }

            // Axes
            sb.Append($"<line x1=\"{padL}\" y1=\"{padT}\" x2=\"{padL}\" y2=\"{padT + plotH}\" stroke=\"#aaa\" stroke-width=\"1\"/>");
            sb.Append($"<line x1=\"{padL}\" y1=\"{padT + plotH}\" x2=\"{padL + plotW}\" y2=\"{padT + plotH}\" stroke=\"#aaa\" stroke-width=\"1\"/>");

            // Series
            for (var si = 0; si < seriesList.Count; si++)
            {
                var series = seriesList[si];
                var color  = palette[si % palette.Length];
                var n      = series.Points.Count;
                if (n == 0) continue;

                var pts = string.Join(" ", series.Points.Select((p, i) => $"{F(ToX(i, n))},{F(ToY(p.Y))}"));
                sb.Append($"<polyline points=\"{pts}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>");

                for (var pi = 0; pi < n; pi++)
                    sb.Append($"<circle cx=\"{F(ToX(pi, n))}\" cy=\"{F(ToY(series.Points[pi].Y))}\" r=\"3\" fill=\"{color}\" stroke=\"white\" stroke-width=\"1.5\"/>");
            }

            // X-axis labels
            var xStep = xLabels.Count <= 10 ? 1 : (int)Math.Ceiling((double)xLabels.Count / 10);
            for (var xi = 0; xi < xLabels.Count; xi += xStep)
                sb.Append($"<text x=\"{F(ToX(xi, xLabels.Count))}\" y=\"{padT + plotH + 14}\" text-anchor=\"middle\" font-size=\"9\" fill=\"#888\">{xLabels[xi]}</text>");

            // Legend (multiple series)
            if (seriesList.Count > 1)
            {
                var legendW = Math.Max(40, (int)Math.Min(70.0, (double)plotW / seriesList.Count));
                for (var li = 0; li < Math.Min(seriesList.Count, 6); li++)
                {
                    var lcolor = palette[li % palette.Length];
                    var lx     = padL + 4 + li * legendW;
                    sb.Append($"<rect x=\"{lx}\" y=\"{padT + 2}\" width=\"12\" height=\"6\" rx=\"2\" fill=\"{lcolor}\"/>");
                    sb.Append($"<text x=\"{lx + 14}\" y=\"{padT + 8}\" font-size=\"9\" fill=\"#444\">{seriesList[li].Name}</text>");
                }
            }
        }

        sb.Append("</svg>");
        return (MarkupString)sb.ToString();
    }

    private (List<ChartSeries> series, List<string> xLabels) GetChartData()
    {
        var series  = new List<ChartSeries>();
        var xLabels = new List<string>();

        if (string.IsNullOrWhiteSpace(Chart.DataRange)) return (series, xLabels);
        var dm = RangeRx.Match(Chart.DataRange.Trim().Replace(" ", ""));
        if (!dm.Success) return (series, xLabels);

        var dC1 = Math.Clamp(char.ToUpper(dm.Groups[2].Value[0]) - 'A', 0, ColCount - 1);
        var dR1 = Math.Clamp(int.Parse(dm.Groups[4].Value) - 1, 0, RowCount - 1);
        var dC2 = Math.Clamp(char.ToUpper(dm.Groups[6].Value[0]) - 'A', 0, ColCount - 1);
        var dR2 = Math.Clamp(int.Parse(dm.Groups[8].Value) - 1, 0, RowCount - 1);

        var startRow = Math.Min(dR1, dR2);
        var endRow   = Math.Max(dR1, dR2);
        var startCol = Math.Min(dC1, dC2);
        var endCol   = Math.Max(dC1, dC2);

        var dataStartRow = Chart.HasHeaderRow && endRow > startRow ? startRow + 1 : startRow;

        var xm = RangeRx.Match(Chart.XRange.Trim().Replace(" ", ""));
        if (!string.IsNullOrWhiteSpace(Chart.XRange) && xm.Success)
        {
            var xC1 = Math.Clamp(char.ToUpper(xm.Groups[2].Value[0]) - 'A', 0, ColCount - 1);
            var xR1 = Math.Clamp(int.Parse(xm.Groups[4].Value) - 1, 0, RowCount - 1);
            var xC2 = Math.Clamp(char.ToUpper(xm.Groups[6].Value[0]) - 'A', 0, ColCount - 1);
            var xR2 = Math.Clamp(int.Parse(xm.Groups[8].Value) - 1, 0, RowCount - 1);
            for (var r = Math.Min(xR1, xR2); r <= Math.Max(xR1, xR2); r++)
                for (var c = Math.Min(xC1, xC2); c <= Math.Max(xC1, xC2); c++)
                    xLabels.Add(CellDisplayGetter(r, c));
            if (Chart.HasHeaderRow && xLabels.Count > 0) xLabels.RemoveAt(0);
        }
        else if (Chart.HasHeaderColumn && endCol > startCol)
        {
            for (var r = dataStartRow; r <= endRow; r++)
                xLabels.Add(CellDisplayGetter(r, startCol));
        }
        else
        {
            for (var r = dataStartRow; r <= endRow; r++)
                xLabels.Add((r - dataStartRow + 1).ToString());
        }

        var dataStartCol = (string.IsNullOrWhiteSpace(Chart.XRange) && Chart.HasHeaderColumn && endCol > startCol)
            ? startCol + 1 : startCol;

        for (var c = dataStartCol; c <= endCol; c++)
        {
            var name = Chart.HasHeaderRow && dataStartRow > startRow
                ? CellDisplayGetter(startRow, c)
                : ((char)('A' + c)).ToString();

            var points = new List<ChartPoint>();
            for (var r = dataStartRow; r <= endRow; r++)
            {
                var xi    = r - dataStartRow;
                var label = xi < xLabels.Count ? xLabels[xi] : (xi + 1).ToString();
                var raw   = CellDisplayGetter(r, c).Replace(",", "");
                double.TryParse(raw, out var val);
                points.Add(new ChartPoint(label, val));
            }
            series.Add(new ChartSeries(name, points));
        }

        return (series, xLabels);
    }

    private static string FormatLabel(double v)
    {
        if (Math.Abs(v) >= 1_000_000) return (v / 1_000_000.0).ToString("F1") + "M";
        if (Math.Abs(v) >= 1_000)     return (v / 1_000.0).ToString("F0") + "k";
        return v.ToString("F0");
    }

    public void Dispose() => _dotNetRef?.Dispose();
}
