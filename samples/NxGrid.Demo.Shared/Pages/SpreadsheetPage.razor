@code {
    // ── Instance state ────────────────────────────────────────────────────────

    Cell[,] sheet = new Cell[RowCount, ColCount];
    List<SsRow> rows = [];
    NxGrid<SsRow>? grid;

    // formula bar / selection
    List<NxGridSelectionRange<SsRow>> selectedRanges = [];
    string formulaBarValue      = "";
    string formulaBarBaseValue  = "";
    string anchorRef            = "";

    string? selectedFill      = "#FFFF00";
    string? selectedTextColor = "#000000";
    bool    showFillPicker;
    bool    showTextColorPicker;

    string FillBarBg      => selectedFill      ?? "linear-gradient(135deg,#fff 40%,#c00 40%,#c00 60%,#fff 60%)";
    string TextColorBarBg => selectedTextColor ?? "#000000";

    Cell? AnchorCell => selectedRanges.Count > 0
        ? sheet[selectedRanges[0].StartRow, selectedRanges[0].StartCol]
        : null;

    // charts
    List<SpreadsheetChartDef> charts = [];
    SpreadsheetChartDef? selectedChart;
    bool showChartPanel = false;
    int chartDataVersion = 0;

    // conditional formatting
    List<ConditionalFormattingRule> condFmtRules = [];
    ConditionalFormattingRule? selectedCondFmtRule;
    bool showCondFmtPanel = false;
    ConditionalCellStyle?[,] conditionalStyles = new ConditionalCellStyle?[RowCount, ColCount];

    // persistence
    IJSObjectReference? jsModule;
    System.Threading.Timer? saveTimer;
    bool isSaving;
    const string StorageKey = "nxgrid-spreadsheet-demo";

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        for (var r = 0; r < RowCount; r++)
            for (var c = 0; c < ColCount; c++)
                sheet[r, c] = new Cell();

        rows = Enumerable.Range(0, RowCount).Select(i => new SsRow { RowIndex = i }).ToList();

        LoadSampleData();
        Calculate();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/NxGrid/nx-grid.js");
        await LoadFromStorage();
    }

    public void Dispose()
    {
        saveTimer?.Dispose();
    }

    // ── Sample data ───────────────────────────────────────────────────────────

    void LoadSampleData()
    {
        void H(int r, int c, string v)
        {
            var cell = sheet[r, c];
            cell.Value = v;
            cell.Bold  = true;
            cell.Fill  = "#d9e1f2";
            cell.Align = "center";
        }

        H(0, 0, "Month");
        H(0, 1, "Revenue");
        H(0, 2, "COGS");
        H(0, 3, "Gross Profit");
        H(0, 4, "OpEx");
        H(0, 5, "Net Income");
        H(0, 6, "Margin %");
        H(0, 7, "YTD Revenue");
        H(0, 8, "Target");
        H(0, 9, "vs Target");
        H(0, 10, "On Track");

        string[] months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                           "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        int[] revenue   = [82000, 75000, 91000, 88000, 103000, 115000,
                           97000, 108000, 121000, 134000, 118000, 142000];
        int[] cogs      = [41000, 38000, 44000, 43000, 50000,  55000,
                           47000, 52000,  58000,  63000,  56000,  67000];
        int[] opex      = [18000, 17500, 19000, 18500, 21000,  23000,
                           20000, 22000,  24000,  26000,  23500,  28000];
        int[] target    = [80000, 80000, 90000, 90000, 100000, 110000,
                           95000, 105000, 115000, 125000, 115000, 135000];

        for (var i = 0; i < 12; i++)
        {
            var r = i + 1;
            sheet[r, 0].Value = months[i];
            sheet[r, 0].Align = "center";
            sheet[r, 1].Value = revenue[i].ToString();
            sheet[r, 2].Value = cogs[i].ToString();
            sheet[r, 3].Value = $"=B{r + 1}-C{r + 1}";
            sheet[r, 4].Value = opex[i].ToString();
            sheet[r, 5].Value = $"=D{r + 1}-E{r + 1}";
            sheet[r, 6].Value = $"=F{r + 1}/B{r + 1}";
            sheet[r, 7].Value = i == 0 ? $"=B{r + 1}" : $"=H{r}+B{r + 1}";
            sheet[r, 8].Value = target[i].ToString();
            sheet[r, 9].Value = $"=B{r + 1}-I{r + 1}";

            // Column K: checkbox showing whether on track (>= target)
            sheet[r, 10].IsCheckBox = true;
            sheet[r, 10].Value = revenue[i] >= target[i] ? "true" : "false";
            sheet[r, 10].Align = "center";
        }

        var tot = 13;
        sheet[tot, 0].Value = "Total";
        sheet[tot, 0].Bold  = true;
        sheet[tot, 1].Value = "=SUM(B2:B13)";
        sheet[tot, 2].Value = "=SUM(C2:C13)";
        sheet[tot, 3].Value = "=SUM(D2:D13)";
        sheet[tot, 4].Value = "=SUM(E2:E13)";
        sheet[tot, 5].Value = "=SUM(F2:F13)";
        sheet[tot, 6].Value = "=F14/B14";
        sheet[tot, 8].Value  = "=SUM(I2:I13)";
        sheet[tot, 9].Value  = "=SUM(J2:J13)";
        sheet[tot, 10].Value = "=COUNTIF(K2:K13,TRUE)&\" / \"&COUNTA(K2:K13)";

        for (var c = 0; c <= 10; c++)
        {
            sheet[tot, c].Bold = true;
            sheet[tot, c].Fill = "#e2efda";
        }

        sheet[0, 6].Italic = true;

        // Default conditional formatting rules
        condFmtRules =
        [
            new ConditionalFormattingRule
            {
                ApplyToRange = "F2:F13",
                Formula      = "=F2<0",
                TextColor    = "#cc0000"
            },
            new ConditionalFormattingRule
            {
                ApplyToRange = "J2:J13",
                Formula      = "=J2>=0",
                TextColor    = "#2a7a2a"
            },
            new ConditionalFormattingRule
            {
                ApplyToRange = "J2:J13",
                Formula      = "=J2<0",
                TextColor    = "#cc0000"
            }
        ];

        // Default chart
        charts =
        [
            new SpreadsheetChartDef
            {
                Title         = "Revenue vs Target",
                DataRange     = "B1:B13",
                XRange        = "A2:A13",
                HasHeaderRow  = true,
                HasHeaderColumn = false,
                X = 1032, Y = 48, Width = 420, Height = 270
            }
        ];
        selectedChart = charts[0];
    }

    // ── Formula engine ────────────────────────────────────────────────────────

    void Calculate()
    {
        var done = new bool[RowCount, ColCount];

        for (var r = 0; r < RowCount; r++)
            for (var c = 0; c < ColCount; c++)
            {
                var cell = sheet[r, c];
                if (!cell.Value.StartsWith("=") || cell.Value.StartsWith("'="))
                {
                    cell.Display = cell.Value.StartsWith("'=") ? cell.Value[1..] : cell.Value;
                    done[r, c] = true;
                }
            }

        bool progress;
        do
        {
            progress = false;
            for (var r = 0; r < RowCount; r++)
                for (var c = 0; c < ColCount; c++)
                {
                    if (done[r, c]) continue;
                    var refs = GetRefs(sheet[r, c].Value[1..]);
                    if (refs.All(rf => rf.r < 0 || rf.c < 0 ||
                                       rf.r >= RowCount || rf.c >= ColCount ||
                                       done[rf.r, rf.c]))
                    {
                        sheet[r, c].Display = EvalFormula(sheet[r, c].Value[1..]);
                        done[r, c] = true;
                        progress = true;
                    }
                }
        } while (progress);

        for (var r = 0; r < RowCount; r++)
            for (var c = 0; c < ColCount; c++)
                if (!done[r, c])
                    sheet[r, c].Display = "#err";

        ApplyConditionalFormatting();
    }

    IEnumerable<(int r, int c)> GetRefs(string expr) =>
        CellRef.Matches(expr).Select(m => (
            int.Parse(m.Groups[4].Value) - 1,
            char.ToUpper(m.Groups[2].Value[0]) - 'A'));

    string EvalFormula(string expr)
    {
        expr = StripSpacesOutsideQuotes(expr);
        expr = ExpandFunctions(expr);
        if (expr.Contains('&')) return EvalStringConcat(expr);
        expr = ResolveCellRefs(expr).Replace(",", "");
        try { var pos = 0; return ParseCmp(expr, ref pos).ToString(); }
        catch { return expr.Trim(); }
    }

    string EvalStringConcat(string expr)
    {
        var result = "";
        foreach (var part in SplitByAmpersand(expr))
        {
            var p = part.Trim();
            if (p.Length >= 2 && p[0] == '"' && p[^1] == '"')
                result += p[1..^1];
            else
            {
                var resolved = ResolveCellRefs(p).Replace(",", "");
                try { var pos = 0; result += ParseCmp(resolved, ref pos); }
                catch { result += resolved; }
            }
        }
        return result;
    }

    string ExpandFunctions(string expr)
    {
        expr = SumFunc.Replace(expr, m =>
        {
            var vals = ResolveArgList(m.Groups[1].Value).ToList();
            return vals.Count == 0 ? "0" : vals.Sum().ToString();
        });
        expr = MaxFunc.Replace(expr, m =>
        {
            var vals = ResolveArgList(m.Groups[1].Value).ToList();
            return vals.Count == 0 ? "0" : vals.Max().ToString();
        });
        expr = CountIfFunc.Replace(expr, m =>
        {
            var rm = RangeRef.Match(m.Groups[1].Value.Trim());
            if (!rm.Success) return "0";
            var c1 = char.ToUpper(rm.Groups[2].Value[0]) - 'A';
            var r1 = int.Parse(rm.Groups[4].Value) - 1;
            var c2 = char.ToUpper(rm.Groups[6].Value[0]) - 'A';
            var r2 = int.Parse(rm.Groups[8].Value) - 1;
            var criteria = m.Groups[2].Value.Trim();
            var count = 0;
            for (var r = Math.Min(r1, r2); r <= Math.Max(r1, r2); r++)
                for (var c = Math.Min(c1, c2); c <= Math.Max(c1, c2); c++)
                {
                    if (r < 0 || r >= RowCount || c < 0 || c >= ColCount) continue;
                    var cellVal = sheet[r, c].Value;
                    var cellDisp = sheet[r, c].Display;
                    bool match;
                    if      (string.Equals(criteria, "TRUE",  StringComparison.OrdinalIgnoreCase)) match = cellVal == "true";
                    else if (string.Equals(criteria, "FALSE", StringComparison.OrdinalIgnoreCase)) match = cellVal == "false";
                    else if (criteria.Length >= 2 && criteria[0] == '"' && criteria[^1] == '"')
                        match = string.Equals(cellDisp, criteria[1..^1], StringComparison.OrdinalIgnoreCase);
                    else match = decimal.TryParse(criteria, out var crit) &&
                                 decimal.TryParse(cellDisp.Replace(",", ""), out var cv) && cv == crit;
                    if (match) count++;
                }
            return count.ToString();
        });
        expr = CountAFunc.Replace(expr, m =>
        {
            var rm = RangeRef.Match(m.Groups[1].Value.Trim());
            if (!rm.Success) return "0";
            var c1 = char.ToUpper(rm.Groups[2].Value[0]) - 'A';
            var r1 = int.Parse(rm.Groups[4].Value) - 1;
            var c2 = char.ToUpper(rm.Groups[6].Value[0]) - 'A';
            var r2 = int.Parse(rm.Groups[8].Value) - 1;
            var count = 0;
            for (var r = Math.Min(r1, r2); r <= Math.Max(r1, r2); r++)
                for (var c = Math.Min(c1, c2); c <= Math.Max(c1, c2); c++)
                    if (r >= 0 && r < RowCount && c >= 0 && c < ColCount && sheet[r, c].Value.Length > 0)
                        count++;
            return count.ToString();
        });
        return expr;
    }

    IEnumerable<decimal> ResolveArgList(string arg)
    {
        var m = RangeRef.Match(arg.Trim());
        if (m.Success) return ResolveRange(m);
        return arg.Split(',').SelectMany(a =>
        {
            var resolved = ResolveCellRefs(a.Trim()).Replace(",", "");
            var pos = 0;
            try { return (IEnumerable<decimal>)[ParseAddSub(resolved, ref pos)]; }
            catch { return []; }
        });
    }

    IEnumerable<decimal> ResolveRange(System.Text.RegularExpressions.Match m)
    {
        var c1 = char.ToUpper(m.Groups[2].Value[0]) - 'A';
        var r1 = int.Parse(m.Groups[4].Value) - 1;
        var c2 = char.ToUpper(m.Groups[6].Value[0]) - 'A';
        var r2 = int.Parse(m.Groups[8].Value) - 1;
        for (var r = Math.Min(r1, r2); r <= Math.Max(r1, r2); r++)
            for (var c = Math.Min(c1, c2); c <= Math.Max(c1, c2); c++)
                if (r >= 0 && r < RowCount && c >= 0 && c < ColCount &&
                    decimal.TryParse(sheet[r, c].Display, out var v))
                    yield return v;
    }

    string ResolveCellRefs(string expr) =>
        CellRef.Replace(expr, m =>
        {
            var c = char.ToUpper(m.Groups[2].Value[0]) - 'A';
            var r = int.Parse(m.Groups[4].Value) - 1;
            if (r >= 0 && r < RowCount && c >= 0 && c < ColCount)
                return sheet[r, c].Display;
            return m.Value;
        });

    // ── Conditional formatting ────────────────────────────────────────────────

    void ApplyConditionalFormatting()
    {
        conditionalStyles = new ConditionalCellStyle?[RowCount, ColCount];
        if (condFmtRules.Count == 0) return;

        for (var r = 0; r < RowCount; r++)
            for (var c = 0; c < ColCount; c++)
            {
                bool bold = false, italic = false;
                string? bg = null, text = null;
                bool any = false;

                foreach (var rule in condFmtRules)
                {
                    if (!EvaluateCondRule(rule, r, c)) continue;
                    any = true;
                    if (rule.Bold) bold = true;
                    if (rule.Italic) italic = true;
                    if (rule.BackgroundColor != null) bg = rule.BackgroundColor;
                    if (rule.TextColor != null) text = rule.TextColor;
                }

                if (any)
                    conditionalStyles[r, c] = new ConditionalCellStyle(bold, italic, bg, text);
            }
    }

    bool EvaluateCondRule(ConditionalFormattingRule rule, int cellRow, int cellCol)
    {
        if (string.IsNullOrWhiteSpace(rule.ApplyToRange) || string.IsNullOrWhiteSpace(rule.Formula)) return false;
        var m = RangeRef.Match(rule.ApplyToRange.Trim().Replace(" ", ""));
        if (!m.Success) return false;

        var c1 = char.ToUpper(m.Groups[2].Value[0]) - 'A';
        var r1 = int.Parse(m.Groups[4].Value) - 1;
        var c2 = char.ToUpper(m.Groups[6].Value[0]) - 'A';
        var r2 = int.Parse(m.Groups[8].Value) - 1;

        if (cellRow < Math.Min(r1, r2) || cellRow > Math.Max(r1, r2)) return false;
        if (cellCol < Math.Min(c1, c2) || cellCol > Math.Max(c1, c2)) return false;

        var formula = rule.Formula.Trim();
        if (!formula.StartsWith("=")) return false;

        var adjusted = AdjustFormulaCellRefs(formula, cellRow - Math.Min(r1, r2), cellCol - Math.Min(c1, c2));
        var result   = EvalFormula(adjusted[1..]);
        return decimal.TryParse(result, out var v) && v != 0;
    }

    // ── Cell display / style ─────────────────────────────────────────────────

    string? GetCellStyle(SsRow row, NxGridColumn<SsRow> col)
    {
        var ci   = col.Title![0] - 'A';
        var cell = sheet[row.RowIndex, ci];
        var cf   = conditionalStyles[row.RowIndex, ci];
        var s    = "";

        var bold   = cell.Bold   || (cf?.Bold   ?? false);
        var italic = cell.Italic || (cf?.Italic ?? false);

        if (bold)         s += "font-weight:bold;";
        if (italic)       s += "font-style:italic;";
        if (cell.Underline) s += "text-decoration:underline;";
        if (cell.Strike)    s += "text-decoration:line-through;";

        var textColor = cf?.TextColor       ?? cell.Color;
        var bgColor   = cf?.BackgroundColor ?? cell.Fill;

        if (textColor != null) s += $"color:{textColor};";
        if (bgColor   != null) s += $"background:{bgColor};";

        if (cell.Align != null)
            s += $"text-align:{cell.Align};";
        else if (IsNumeric(cell.Display))
            s += "text-align:right;";

        return s.Length > 0 ? s : null;
    }

    // ── Grid events ──────────────────────────────────────────────────────────

    void HandleUpdate(NxGridUpdateArgs<SsRow> args)
    {
        foreach (var rowArgs in args.Rows)
            foreach (var change in rowArgs.Changes)
            {
                var ci  = change.Column.Title![0] - 'A';
                var val = change.NewValue?.ToString() ?? "";
                sheet[rowArgs.Row.RowIndex, ci].Value = val;
            }

        Calculate();
        chartDataVersion++;
        grid?.ForceRerender();
        TriggerSave();
    }

    void OnSelectionChanged(NxGridSelectionArgs<SsRow> args)
    {
        selectedRanges = args.Ranges;
        if (args.Ranges.Count > 0)
        {
            var r = args.Ranges[0];
            anchorRef           = $"{(char)('A' + r.StartCol)}{r.StartRow + 1}";
            formulaBarValue      = sheet[r.StartRow, r.StartCol].Value;
            formulaBarBaseValue  = formulaBarValue;
        }
        else
        {
            anchorRef = "";
            formulaBarValue = "";
            formulaBarBaseValue = "";
        }
    }

    void OnFillInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)      { selectedFill      = e.Value?.ToString() ?? "#fff2cc"; ApplyFill(); }
    void OnTextColorInput(Microsoft.AspNetCore.Components.ChangeEventArgs e) { selectedTextColor = e.Value?.ToString() ?? "#000000"; ApplyTextColor(); }
    void OnFormulaBarInput(Microsoft.AspNetCore.Components.ChangeEventArgs e) => formulaBarValue   = e.Value?.ToString() ?? "";

    void OnFormulaBarKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && selectedRanges.Count > 0)
        {
            var r0 = selectedRanges[0];
            sheet[r0.StartRow, r0.StartCol].Value = formulaBarValue;
            formulaBarBaseValue = formulaBarValue;
            Calculate();
            chartDataVersion++;
            grid?.ForceRerender();
            TriggerSave();
        }
        else if (e.Key == "Escape")
        {
            formulaBarValue = formulaBarBaseValue;
        }
    }

    void OnKeyPressed(NxGridKeyPressedArgs args)
    {
        if (!args.ModifierPressed) return;
        switch (args.KeyboardEvent.Key)
        {
            case "b": OnBoldClick();      break;
            case "i": OnItalicClick();    break;
            case "u": OnUnderlineClick(); break;
        }
    }

    // ── Checkbox cells ────────────────────────────────────────────────────────

    void OnToggleCheckBoxClick()
    {
        if (selectedRanges.Count == 0) return;
        var newValue = !(AnchorCell?.IsCheckBox ?? false);
        foreach (var rng in selectedRanges)
            for (var r = rng.StartRow; r <= rng.EndRow; r++)
                for (var c = rng.StartCol; c <= rng.EndCol; c++)
                {
                    var cell = sheet[r, c];
                    cell.IsCheckBox = newValue;
                    if (newValue && cell.Value != "true" && cell.Value != "false")
                        cell.Value = "false";
                }
        grid?.ForceRerender();
        TriggerSave();
    }

    void OnCheckBoxCellChanged(int rowIndex, int colIndex, bool value)
    {
        sheet[rowIndex, colIndex].Value = value ? "true" : "false";
        Calculate();
        chartDataVersion++;
        grid?.ForceRerender();
        TriggerSave();
    }

    // ── Formatting actions ────────────────────────────────────────────────────

    void ForEachSelected(Action<Cell> action)
    {
        foreach (var rng in selectedRanges)
            for (var r = rng.StartRow; r <= rng.EndRow; r++)
                for (var c = rng.StartCol; c <= rng.EndCol; c++)
                    action(sheet[r, c]);
        grid?.ForceRerender();
        TriggerSave();
    }

    void OnBoldClick() =>      Toggle(c => c.Bold,      (c, v) => c.Bold      = v);
    void OnItalicClick() =>    Toggle(c => c.Italic,    (c, v) => c.Italic    = v);
    void OnUnderlineClick() => Toggle(c => c.Underline, (c, v) => c.Underline = v);
    void OnStrikeClick() =>    Toggle(c => c.Strike,    (c, v) => c.Strike    = v);

    void Toggle(Func<Cell, bool> get, Action<Cell, bool> set)
    {
        if (AnchorCell == null) return;
        var next = !get(AnchorCell);
        ForEachSelected(c => set(c, next));
    }

    void ToggleFillPicker()      { showFillPicker = !showFillPicker; if (showFillPicker) showTextColorPicker = false; }
    void ToggleTextColorPicker() { showTextColorPicker = !showTextColorPicker; if (showTextColorPicker) showFillPicker = false; }

    void ApplyFillColor(string? color)      { selectedFill = color; ApplyFill(); showFillPicker = false; }
    void ApplyTextColorValue(string? color) { selectedTextColor = color; ApplyTextColor(); showTextColorPicker = false; }

    void ApplyFill()      => ForEachSelected(c => c.Fill  = selectedFill);
    void ClearFill()      => ForEachSelected(c => c.Fill  = null);
    void ApplyTextColor() => ForEachSelected(c => c.Color = selectedTextColor);
    void ClearTextColor() => ForEachSelected(c => c.Color = null);

    void OnAlignClick(string align)
    {
        if (AnchorCell == null) return;
        var next = AnchorCell.Align == align ? null : align;
        ForEachSelected(c => c.Align = next);
    }

    // ── Decimal places ────────────────────────────────────────────────────────

    int GetAnchorDecimalPlaces() => AnchorCell?.DecimalPlaces ?? 2;

    void OnAddDecimalClick()    => ApplyDecimalPlaces(GetAnchorDecimalPlaces() + 1);
    void OnRemoveDecimalClick() => ApplyDecimalPlaces(Math.Max(0, GetAnchorDecimalPlaces() - 1));

    void ApplyDecimalPlaces(int decimalPlaces)
    {
        if (selectedRanges.Count == 0) return;
        foreach (var rng in selectedRanges)
            for (var r = rng.StartRow; r <= rng.EndRow; r++)
                for (var c = rng.StartCol; c <= rng.EndCol; c++)
                    sheet[r, c].DecimalPlaces = decimalPlaces;
        grid?.ForceRerender();
        TriggerSave();
    }

    // ── Charts ────────────────────────────────────────────────────────────────

    void AddChart()
    {
        var chart = new SpreadsheetChartDef { Title = $"Chart {charts.Count + 1}" };
        charts.Add(chart);
        selectedChart = chart;
        TriggerSave();
    }

    void DeleteChart(SpreadsheetChartDef chart)
    {
        var idx = charts.IndexOf(chart);
        charts.Remove(chart);
        if (selectedChart == chart)
            selectedChart = charts.Count > 0 ? charts[Math.Max(0, idx - 1)] : null;
        TriggerSave();
    }

    void OnChartSelectorChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            selectedChart = charts.FirstOrDefault(c => c.Id == id);
    }

    void UseSelectionFor(bool isXRange)
    {
        if (selectedChart == null || selectedRanges.Count == 0) return;
        var r   = selectedRanges[0];
        var c1  = (char)('A' + r.StartCol);
        var c2  = (char)('A' + r.EndCol);
        var rng = $"{c1}{r.StartRow + 1}:{c2}{r.EndRow + 1}";
        if (isXRange) selectedChart.XRange = rng;
        else          selectedChart.DataRange = rng;
        chartDataVersion++;
        TriggerSave();
    }

    // ── Conditional formatting management ─────────────────────────────────────

    void AddCondFmtRule()
    {
        var rule = new ConditionalFormattingRule();
        condFmtRules.Add(rule);
        selectedCondFmtRule = rule;
        TriggerSave();
    }

    void DeleteCondFmtRule(ConditionalFormattingRule rule)
    {
        condFmtRules.Remove(rule);
        if (selectedCondFmtRule == rule)
            selectedCondFmtRule = condFmtRules.Count > 0 ? condFmtRules[^1] : null;
        OnCondFmtChanged();
    }

    void OnCondFmtChanged()
    {
        Calculate();
        grid?.ForceRerender();
        TriggerSave();
        StateHasChanged();
    }

    // ── Local-storage persistence ─────────────────────────────────────────────

    void TriggerSave()
    {
        saveTimer?.Dispose();
        saveTimer = new System.Threading.Timer(_ => InvokeAsync(SaveToStorage), null, 800, System.Threading.Timeout.Infinite);
    }

    async Task SaveToStorage()
    {
        if (jsModule == null) return;
        isSaving = true;
        StateHasChanged();

        var cells = new List<CellSave>();
        for (var r = 0; r < RowCount; r++)
            for (var c = 0; c < ColCount; c++)
            {
                var cell = sheet[r, c];
                if (cell.Value.Length == 0 && !cell.IsCheckBox && !cell.Bold && !cell.Italic &&
                    !cell.Underline && !cell.Strike && cell.Fill == null && cell.Color == null &&
                    cell.Align == null && !cell.DecimalPlaces.HasValue) continue;
                cells.Add(new CellSave { R = r, C = c, V = cell.Value.Length > 0 ? cell.Value : null,
                    Ckbx = cell.IsCheckBox, B = cell.Bold, I = cell.Italic, U = cell.Underline, S = cell.Strike,
                    Fill = cell.Fill, Color = cell.Color, Align = cell.Align, Dec = cell.DecimalPlaces });
            }

        var save = new SpreadsheetSave
        {
            Cells   = cells,
            Charts  = charts.Select(c => new ChartSave
            {
                Id = c.Id, Title = c.Title, X = c.X, Y = c.Y, W = c.Width, H = c.Height,
                DataRange = c.DataRange, XRange = c.XRange, HasHeaderRow = c.HasHeaderRow, HasHeaderCol = c.HasHeaderColumn
            }).ToList(),
            CondFmt = condFmtRules.Select(r => new CondFmtSave
            {
                Id = r.Id, Range = r.ApplyToRange, Formula = r.Formula,
                B = r.Bold, I = r.Italic, Bg = r.BackgroundColor, Txt = r.TextColor
            }).ToList()
        };

        var json = JsonSerializer.Serialize(save);
        await jsModule.InvokeVoidAsync("localStorageSet", StorageKey, json);

        isSaving = false;
        StateHasChanged();
    }

    async Task LoadFromStorage()
    {
        if (jsModule == null) return;
        string? json = null;
        try { json = await jsModule.InvokeAsync<string?>("localStorageGet", StorageKey); } catch { }
        if (json == null) return;

        try
        {
            var save = JsonSerializer.Deserialize<SpreadsheetSave>(json);
            if (save == null) return;

            // Restore cells
            for (var r = 0; r < RowCount; r++)
                for (var c = 0; c < ColCount; c++)
                    sheet[r, c] = new Cell();

            foreach (var cs in save.Cells)
            {
                if (cs.R < 0 || cs.R >= RowCount || cs.C < 0 || cs.C >= ColCount) continue;
                var cell = sheet[cs.R, cs.C];
                cell.Value = cs.V ?? "";
                cell.IsCheckBox = cs.Ckbx;
                cell.Bold = cs.B; cell.Italic = cs.I; cell.Underline = cs.U; cell.Strike = cs.S;
                cell.Fill = cs.Fill; cell.Color = cs.Color; cell.Align = cs.Align; cell.DecimalPlaces = cs.Dec;
            }

            charts = save.Charts.Select(cs => new SpreadsheetChartDef
            {
                Id = cs.Id, Title = cs.Title, X = cs.X, Y = cs.Y, Width = cs.W, Height = cs.H,
                DataRange = cs.DataRange, XRange = cs.XRange, HasHeaderRow = cs.HasHeaderRow, HasHeaderColumn = cs.HasHeaderCol
            }).ToList();
            selectedChart = charts.Count > 0 ? charts[0] : null;

            condFmtRules = save.CondFmt.Select(r => new ConditionalFormattingRule
            {
                Id = r.Id, ApplyToRange = r.Range, Formula = r.Formula,
                Bold = r.B, Italic = r.I, BackgroundColor = r.Bg, TextColor = r.Txt
            }).ToList();
            selectedCondFmtRule = null;

            Calculate();
            chartDataVersion++;
            grid?.ForceRerender();
            StateHasChanged();
        }
        catch { }
    }

    async Task ResetData()
    {
        if (jsModule != null)
            try { await jsModule.InvokeVoidAsync("localStorageRemove", StorageKey); } catch { }

        for (var r = 0; r < RowCount; r++)
            for (var c = 0; c < ColCount; c++)
                sheet[r, c] = new Cell();

        charts.Clear();
        selectedChart = null;
        condFmtRules.Clear();
        selectedCondFmtRule = null;

        LoadSampleData();
        Calculate();
        chartDataVersion++;
        grid?.ForceRerender();
    }
}
