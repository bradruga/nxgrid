@page "/spreadsheet"
@using System.Text.Json
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Spreadsheet — NxGrid</PageTitle>

<h1>Spreadsheet</h1>
<p class="doc-intro">
    NxGrid can serve as the rendering layer for a full spreadsheet UI.
    Formula evaluation (<code>=A1+B2</code>, <code>=SUM(B2:B13)</code>), per-cell styling,
    a formula bar, checkbox cells, draggable charts, conditional formatting, and
    local-storage persistence are all driven by the same parameters:
    <code>CellStyle</code>, <code>CellEditableGetter</code>, <code>Template</code>,
    <code>Overlays</code>, <code>OnKeyPressed</code>, and <code>ForceRerender()</code>.
</p>

<div class="doc-section" style="padding:0; overflow:hidden;">

    @* ── Toolbar ── *@
    <div style="display:flex; align-items:center; gap:6px; padding:5px 10px; border-bottom:1px solid var(--nx-grid-border,#ddd); background:#fafafa; flex-wrap:wrap;">

        @* Bold / Italic / Underline / Strikethrough *@
        <div style="display:flex;">
            <button type="button" class="ss-btn @(AnchorCell?.Bold==true?"ss-btn-active":"")"      style="width:30px; font-weight:700;"              @onclick="OnBoldClick"          title="Bold (Ctrl+B)">B</button>
            <button type="button" class="ss-btn @(AnchorCell?.Italic==true?"ss-btn-active":"")"    style="width:30px; font-style:italic;"            @onclick="OnItalicClick"        title="Italic (Ctrl+I)">I</button>
            <button type="button" class="ss-btn @(AnchorCell?.Underline==true?"ss-btn-active":"")" style="width:30px; text-decoration:underline;"    @onclick="OnUnderlineClick"     title="Underline (Ctrl+U)">U</button>
            <button type="button" class="ss-btn @(AnchorCell?.Strike==true?"ss-btn-active":"")"    style="width:30px; text-decoration:line-through;" @onclick="OnStrikeClick"       title="Strikethrough">S</button>
        </div>

        <div style="width:1px; height:22px; background:#ccc;"></div>

        @* Checkbox toggle *@
        <button type="button" class="ss-btn @(AnchorCell?.IsCheckBox==true?"ss-btn-active":"")" title="Toggle checkbox cell"
                @onclick="OnToggleCheckBoxClick">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"/>
                <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
            </svg>
        </button>

        <div style="width:1px; height:22px; background:#ccc;"></div>

        @* Fill color (split button) *@
        <div style="position:relative; display:flex;">
            <button type="button" class="ss-btn ss-split-l" title="Apply fill color"
                    style="flex-direction:column; gap:1px; padding:2px 5px;"
                    @onclick="ApplyFill">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M16.56 8.94L7.62 0 6.21 1.41l2.38 2.38-5.15 5.15c-.59.59-.59 1.54 0 2.12l5.5 5.5c.29.29.68.44 1.06.44s.77-.15 1.06-.44l5.5-5.5c.59-.58.59-1.53 0-2.12zM5.21 10L10 5.21 14.79 10H5.21zM19 11.5s-2 2.17-2 3.5c0 1.1.9 2 2 2s2-.9 2-2c0-1.33-2-3.5-2-3.5z"/>
                </svg>
                <span style="display:block; width:20px; height:3px; background:@FillBarBg; border:1px solid rgba(0,0,0,.2); border-radius:1px;"></span>
            </button>
            <button type="button" class="ss-btn ss-split-r" title="Choose fill color"
                    @onclick="ToggleFillPicker">
                <svg width="7" height="5" viewBox="0 0 7 5"><path d="M0 0l3.5 5L7 0z" fill="currentColor"/></svg>
            </button>
            @if (showFillPicker)
            {
                <div style="position:fixed; inset:0; z-index:99;" @onclick="@(() => showFillPicker = false)"></div>
                <div style="position:absolute; top:calc(100% + 2px); left:0; z-index:100; background:white; border:1px solid #ccc; border-radius:4px; box-shadow:0 4px 16px rgba(0,0,0,.15); padding:8px; width:220px;">
                    <button type="button" class="ss-no-color-btn"
                            @onclick="@(() => ApplyFillColor(null))">
                        <span style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border:1px solid #bbb;border-radius:2px;overflow:hidden;flex-shrink:0;">
                            <svg width="14" height="14" viewBox="0 0 14 14"><line x1="1" y1="13" x2="13" y2="1" stroke="#c00" stroke-width="1.5" stroke-linecap="round"/></svg>
                        </span>
                        No Fill
                    </button>
                    <div style="font-size:10px; color:#999; margin-bottom:4px; text-transform:uppercase; letter-spacing:.5px;">Theme Colors</div>
                    <div style="display:grid; grid-template-columns:repeat(10,18px); gap:2px; margin-bottom:8px;">
                        @foreach (var row in OfficeThemeColors)
                        {
                            @foreach (var clr in row)
                            {
                                var c = clr;
                                <button type="button" title="@c"
                                        style="width:18px;height:18px;background:@c;border:1px solid rgba(0,0,0,.15);border-radius:2px;cursor:pointer;padding:0;"
                                        @onclick="@(() => ApplyFillColor(c))" @onmousedown:preventDefault></button>
                            }
                        }
                    </div>
                    <div style="font-size:10px; color:#999; margin-bottom:4px; text-transform:uppercase; letter-spacing:.5px;">Standard Colors</div>
                    <div style="display:flex; gap:2px; margin-bottom:8px;">
                        @foreach (var clr in OfficeStandardColors)
                        {
                            var c = clr;
                            <button type="button" title="@c"
                                    style="width:18px;height:18px;background:@c;border:1px solid rgba(0,0,0,.15);border-radius:2px;cursor:pointer;padding:0;"
                                    @onclick="@(() => ApplyFillColor(c))" @onmousedown:preventDefault></button>
                        }
                    </div>
                    <div style="border-top:1px solid #eee; padding-top:6px; display:flex; align-items:center; gap:6px;">
                        <span style="font-size:11px; color:#666; flex-shrink:0;">Custom:</span>
                        <input type="color" value="@selectedFill" @onchange="OnFillInput"
                               style="width:26px; height:22px; padding:1px; border:1px solid #ccc; border-radius:3px; cursor:pointer;" />
                    </div>
                </div>
            }
        </div>

        <div style="width:1px; height:22px; background:#ccc;"></div>

        @* Text color (split button) *@
        <div style="position:relative; display:flex;">
            <button type="button" class="ss-btn ss-split-l" title="Apply text color"
                    style="flex-direction:column; gap:1px; padding:2px 5px;"
                    @onclick="ApplyTextColor">
                <span style="font-size:13px; font-weight:700; line-height:1; font-family:serif;">A</span>
                <span style="display:block; width:20px; height:3px; background:@TextColorBarBg; border:1px solid rgba(0,0,0,.2); border-radius:1px;"></span>
            </button>
            <button type="button" class="ss-btn ss-split-r" title="Choose text color"
                    @onclick="ToggleTextColorPicker">
                <svg width="7" height="5" viewBox="0 0 7 5"><path d="M0 0l3.5 5L7 0z" fill="currentColor"/></svg>
            </button>
            @if (showTextColorPicker)
            {
                <div style="position:fixed; inset:0; z-index:99;" @onclick="@(() => showTextColorPicker = false)"></div>
                <div style="position:absolute; top:calc(100% + 2px); left:0; z-index:100; background:white; border:1px solid #ccc; border-radius:4px; box-shadow:0 4px 16px rgba(0,0,0,.15); padding:8px; width:220px;">
                    <button type="button" class="ss-no-color-btn"
                            @onclick="@(() => ApplyTextColorValue(null))">
                        <span style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border:1px solid #bbb;border-radius:2px;background:#000;flex-shrink:0;"></span>
                        Automatic
                    </button>
                    <div style="font-size:10px; color:#999; margin-bottom:4px; text-transform:uppercase; letter-spacing:.5px;">Theme Colors</div>
                    <div style="display:grid; grid-template-columns:repeat(10,18px); gap:2px; margin-bottom:8px;">
                        @foreach (var row in OfficeThemeColors)
                        {
                            @foreach (var clr in row)
                            {
                                var c = clr;
                                <button type="button" title="@c"
                                        style="width:18px;height:18px;background:@c;border:1px solid rgba(0,0,0,.15);border-radius:2px;cursor:pointer;padding:0;"
                                        @onclick="@(() => ApplyTextColorValue(c))" @onmousedown:preventDefault></button>
                            }
                        }
                    </div>
                    <div style="font-size:10px; color:#999; margin-bottom:4px; text-transform:uppercase; letter-spacing:.5px;">Standard Colors</div>
                    <div style="display:flex; gap:2px; margin-bottom:8px;">
                        @foreach (var clr in OfficeStandardColors)
                        {
                            var c = clr;
                            <button type="button" title="@c"
                                    style="width:18px;height:18px;background:@c;border:1px solid rgba(0,0,0,.15);border-radius:2px;cursor:pointer;padding:0;"
                                    @onclick="@(() => ApplyTextColorValue(c))" @onmousedown:preventDefault></button>
                        }
                    </div>
                    <div style="border-top:1px solid #eee; padding-top:6px; display:flex; align-items:center; gap:6px;">
                        <span style="font-size:11px; color:#666; flex-shrink:0;">Custom:</span>
                        <input type="color" value="@selectedTextColor" @onchange="OnTextColorInput"
                               style="width:26px; height:22px; padding:1px; border:1px solid #ccc; border-radius:3px; cursor:pointer;" />
                    </div>
                </div>
            }
        </div>

        <div style="width:1px; height:22px; background:#ccc;"></div>

        @* Alignment *@
        <div style="display:flex;">
            <button type="button" class="ss-btn @(AnchorCell?.Align=="left"?"ss-btn-active":"")"   @onclick="@(() => OnAlignClick("left"))"   title="Align left">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M2 12.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm0-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5zm0-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm0-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5z"/></svg>
            </button>
            <button type="button" class="ss-btn @(AnchorCell?.Align=="center"?"ss-btn-active":"")" @onclick="@(() => OnAlignClick("center"))" title="Align center">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M4 12.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm-2-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5zm2-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm-2-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5z"/></svg>
            </button>
            <button type="button" class="ss-btn @(AnchorCell?.Align=="right"?"ss-btn-active":"")"  @onclick="@(() => OnAlignClick("right"))"  title="Align right">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M6 12.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm-4-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5zm4-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm-4-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5z"/></svg>
            </button>
        </div>

        <div style="width:1px; height:22px; background:#ccc;"></div>

        @* Decimal places *@
        <div style="display:flex;">
            <button type="button" class="ss-btn" @onclick="OnRemoveDecimalClick" title="Decrease decimal places">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="14" viewBox="0 0 28 14"><text x="0" y="11" font-size="10" font-family="monospace" fill="currentColor">.0</text><polyline points="21,2 17,7 21,12" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="ss-btn" @onclick="OnAddDecimalClick" title="Increase decimal places">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="14" viewBox="0 0 28 14"><text x="0" y="11" font-size="10" font-family="monospace" fill="currentColor">.00</text><polyline points="22,2 26,7 22,12" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
        </div>

        <div style="width:1px; height:22px; background:#ccc;"></div>

        @* Charts toggle *@
        <button type="button" class="ss-btn @(showChartPanel ? "ss-btn-active" : "")"
                @onclick="@(() => { showChartPanel = !showChartPanel; if (showChartPanel) showCondFmtPanel = false; })"
                title="Charts">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                <path d="M0 0h1v15h15v1H0zm14.5 6h-2a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .5.5h2a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.5-.5m-4-4h-2a.5.5 0 0 0-.5.5v11a.5.5 0 0 0 .5.5h2a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5m-4 3h-2a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5h2a.5.5 0 0 0 .5-.5v-8a.5.5 0 0 0-.5-.5"/>
            </svg>
            Charts
        </button>

        @* Conditional formatting toggle *@
        <button type="button" class="ss-btn @(showCondFmtPanel ? "ss-btn-active" : "")"
                @onclick="@(() => { showCondFmtPanel = !showCondFmtPanel; if (showCondFmtPanel) showChartPanel = false; })"
                title="Conditional formatting">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286m1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94"/>
            </svg>
            Cond. Fmt.
        </button>

        <div style="width:1px; height:22px; background:#ccc;"></div>

        @* Reset *@
        <button type="button" class="ss-btn" @onclick="ResetData" title="Reset to sample data and clear saved state">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                <path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z"/>
                <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466"/>
            </svg>
            Reset
        </button>

        <div style="margin-left:auto; font-size:12px; color:#888;">
            @if (isSaving)
            {
                <span>Saving…</span>
            }
            else
            {
                <span>Ctrl+B/I/U · paste adjusts formulas · SUM/MAX supported</span>
            }
        </div>
    </div>

    @* ── Formula bar ── *@
    <div style="display:flex; align-items:center; height:28px; padding:0 8px; border-bottom:1px solid var(--nx-grid-border,#ddd); background:#fff; gap:8px;">
        <span style="font-family:monospace; font-size:12px; color:#888; border:1px solid #ddd; border-radius:3px; padding:1px 6px; min-width:48px; text-align:center; display:inline-block;">
            @(anchorRef.Length > 0 ? anchorRef : " ")
        </span>
        <span style="font-size:12px; color:#aaa; font-style:italic;">fx</span>
        <input style="flex:1; border:none; outline:none; font-family:monospace; font-size:13px;"
               value="@formulaBarValue"
               @oninput="OnFormulaBarInput"
               @onkeydown="OnFormulaBarKeyDown" />
    </div>

    @* ── Content area: grid + side panels ── *@
    <div style="display:flex; height:520px;">

        @* Grid *@
        <div style="flex:1; min-width:0; overflow:hidden;">
            <NxGrid T="SsRow"
                    @ref="grid"
                    Data="@rows"
                    Style="height:100%"
                    ShowRowNumbers="true"
                    HeaderClickSelects="true"
                    RowHeight="24"
                    RowBanding="false"
                    HasColumnMenu="false"
                    Editable="true"
                    Cursor="@NxGridCursor.Cell"
                    OnUpdate="@HandleUpdate"
                    CellStyle="@GetCellStyle"
                    CellEditableGetter="@((row, col) => !sheet[row.RowIndex, col.Title![0] - 'A'].IsCheckBox)"
                    OnSelectionChanged="@OnSelectionChanged"
                    OnKeyPressed="@OnKeyPressed"
                    TransformPastedValue="@AdjustFormulaCellRefs">
                <ChildContent>
                    @for (var i = 0; i < ColCount; i++)
                    {
                        var ci     = i;
                        var letter = ((char)('A' + ci)).ToString();
                        <NxGridColumn T="SsRow"
                                      Title="@letter"
                                      Property="@(x => x.EditValue)"
                                      Display="@(x => FormatDisplay(sheet[x.RowIndex, ci]))"
                                      MinWidth="@ColWidth(ci)"
                                      MaxWidth="@ColWidth(ci)">
                            <Template Context="ssRow">
                                @{
                                    var tcell = sheet[ssRow.RowIndex, ci];
                                }
                                @if (tcell.IsCheckBox)
                                {
                                    <input type="checkbox"
                                           style="cursor:pointer; margin:0;"
                                           checked="@(tcell.Value == "true")"
                                           @onchange="@(e => OnCheckBoxCellChanged(ssRow.RowIndex, ci, (bool)(e.Value ?? false)))"
                                           @ondblclick:stopPropagation />
                                }
                                else
                                {
                                    @FormatDisplay(tcell)
                                }
                            </Template>
                        </NxGridColumn>
                    }
                </ChildContent>
                <Overlays>
                    @foreach (var chart in charts)
                    {
                        var c = chart;
                        <SpreadsheetChart Chart="@c"
                                          CellDisplayGetter="@((r, col) => sheet[r, col].Display)"
                                          RowCount="@RowCount"
                                          ColCount="@ColCount"
                                          DataVersion="@chartDataVersion"
                                          OnDelete="@(() => DeleteChart(c))"
                                          OnChanged="@TriggerSave" />
                    }
                </Overlays>
            </NxGrid>
        </div>

        @* ── Chart panel ── *@
        @if (showChartPanel)
        {
            <div style="width:300px; border-left:1px solid var(--nx-grid-border,#ddd); background:#fafafa; display:flex; flex-direction:column; overflow-y:auto; flex-shrink:0;">
                <div style="padding:8px; border-bottom:1px solid #ddd;">
                    <button type="button" class="ss-btn" style="width:100%;" @onclick="AddChart">+ Add Chart</button>
                </div>

                @if (charts.Count > 0)
                {
                    <div style="padding:6px 8px; border-bottom:1px solid #ddd; display:flex; gap:4px;">
                        <select style="flex:1; font-size:12px; padding:2px 4px; border:1px solid #ccc; border-radius:3px;"
                                value="@selectedChart?.Id.ToString()"
                                @onchange="OnChartSelectorChanged">
                            @foreach (var c in charts)
                            {
                                <option value="@c.Id.ToString()">@c.Title</option>
                            }
                        </select>
                        <button type="button" class="ss-btn" style="color:#c00;" @onclick="@(() => DeleteChart(selectedChart!))">Del</button>
                    </div>

                    @if (selectedChart != null)
                    {
                        <div style="padding:8px; display:flex; flex-direction:column; gap:8px; font-size:12px;">

                            <div>
                                <label style="display:block; color:#666; margin-bottom:2px;">Title</label>
                                <input style="width:100%; padding:3px 6px; border:1px solid #ccc; border-radius:3px; font-size:12px;"
                                       value="@selectedChart.Title"
                                       @onchange="@(e => { selectedChart.Title = e.Value?.ToString() ?? ""; TriggerSave(); StateHasChanged(); })" />
                            </div>

                            <div>
                                <label style="display:block; color:#666; margin-bottom:2px;">Data Range <span style="color:#aaa;">(e.g. B1:D13)</span></label>
                                <div style="display:flex; gap:4px;">
                                    <input style="flex:1; padding:3px 6px; border:1px solid #ccc; border-radius:3px; font-family:monospace; font-size:12px;"
                                           value="@selectedChart.DataRange"
                                           @onchange="@(e => { selectedChart.DataRange = e.Value?.ToString() ?? ""; chartDataVersion++; TriggerSave(); StateHasChanged(); })" />
                                    <button type="button" class="ss-btn" @onclick="@(() => UseSelectionFor(false))" title="Use current selection">Sel</button>
                                </div>
                            </div>

                            <div>
                                <label style="display:block; color:#666; margin-bottom:2px;">X Labels Range <span style="color:#aaa;">(optional)</span></label>
                                <div style="display:flex; gap:4px;">
                                    <input style="flex:1; padding:3px 6px; border:1px solid #ccc; border-radius:3px; font-family:monospace; font-size:12px;"
                                           value="@selectedChart.XRange"
                                           @onchange="@(e => { selectedChart.XRange = e.Value?.ToString() ?? ""; chartDataVersion++; TriggerSave(); StateHasChanged(); })" />
                                    <button type="button" class="ss-btn" @onclick="@(() => UseSelectionFor(true))" title="Use current selection">Sel</button>
                                </div>
                            </div>

                            <div style="display:flex; gap:12px;">
                                <label style="display:flex; align-items:center; gap:4px; cursor:pointer;">
                                    <input type="checkbox"
                                           checked="@selectedChart.HasHeaderRow"
                                           @onchange="@(e => { selectedChart.HasHeaderRow = (bool)(e.Value ?? false); chartDataVersion++; TriggerSave(); StateHasChanged(); })" />
                                    Header row
                                </label>
                                @if (string.IsNullOrWhiteSpace(selectedChart.XRange))
                                {
                                    <label style="display:flex; align-items:center; gap:4px; cursor:pointer;">
                                        <input type="checkbox"
                                               checked="@selectedChart.HasHeaderColumn"
                                               @onchange="@(e => { selectedChart.HasHeaderColumn = (bool)(e.Value ?? false); chartDataVersion++; TriggerSave(); StateHasChanged(); })" />
                                        Header col
                                    </label>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @* ── Conditional formatting panel ── *@
        @if (showCondFmtPanel)
        {
            <div style="width:300px; border-left:1px solid var(--nx-grid-border,#ddd); background:#fafafa; display:flex; flex-direction:column; overflow-y:auto; flex-shrink:0;">
                <div style="padding:8px; border-bottom:1px solid #ddd; display:flex; align-items:center; gap:6px;">
                    <span style="flex:1; font-size:12px; font-weight:600; color:#333;">Conditional Formatting</span>
                    <button type="button" class="ss-btn" @onclick="AddCondFmtRule">+ Rule</button>
                </div>

                @if (condFmtRules.Count == 0)
                {
                    <div style="padding:12px; font-size:12px; color:#888; text-align:center;">No rules yet. Click + Rule.</div>
                }
                else
                {
                    @foreach (var rule in condFmtRules)
                    {
                        var r = rule;
                        var isSelected = selectedCondFmtRule == r;
                        <div style="padding:6px 8px; border-bottom:1px solid #eee; cursor:pointer; @(isSelected ? "background:#e8f0fe;" : "")"
                             @onclick="@(() => selectedCondFmtRule = r)">
                            <div style="font-family:monospace; font-size:11px; color:#555;">
                                @(string.IsNullOrWhiteSpace(r.ApplyToRange) ? "(no range)" : r.ApplyToRange)
                            </div>
                            <div style="font-size:11px; color:#888; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                @(string.IsNullOrWhiteSpace(r.Formula) ? "(no formula)" : r.Formula)
                            </div>
                            <div style="display:flex; gap:3px; margin-top:2px;">
                                @if (r.BackgroundColor != null)
                                {
                                    <span style="display:inline-block; width:12px; height:12px; background:@r.BackgroundColor; border:1px solid #ccc; border-radius:2px;"></span>
                                }
                                @if (r.TextColor != null)
                                {
                                    <span style="display:inline-block; width:12px; height:12px; background:@r.TextColor; border:1px solid #ccc; border-radius:2px;"></span>
                                }
                                @if (r.Bold) { <span style="font-size:10px; font-weight:700;">B</span> }
                                @if (r.Italic) { <span style="font-size:10px; font-style:italic;">I</span> }
                            </div>
                        </div>
                    }
                }

                @if (selectedCondFmtRule != null)
                {
                    var editRule = selectedCondFmtRule;
                    <div style="padding:8px; display:flex; flex-direction:column; gap:8px; font-size:12px; border-top:1px solid #ddd; background:#fff;">

                        <div>
                            <label style="display:block; color:#666; margin-bottom:2px;">Apply to Range</label>
                            <input style="width:100%; padding:3px 6px; border:1px solid #ccc; border-radius:3px; font-family:monospace; font-size:12px;"
                                   placeholder="e.g. A1:Z100"
                                   value="@editRule.ApplyToRange"
                                   @onchange="@(e => { editRule.ApplyToRange = e.Value?.ToString() ?? ""; OnCondFmtChanged(); })" />
                        </div>

                        <div>
                            <label style="display:block; color:#666; margin-bottom:2px;">Format cells if formula is true</label>
                            <input style="width:100%; padding:3px 6px; border:1px solid #ccc; border-radius:3px; font-family:monospace; font-size:12px;"
                                   placeholder="e.g. =A1>100"
                                   value="@editRule.Formula"
                                   @onchange="@(e => { editRule.Formula = e.Value?.ToString() ?? ""; OnCondFmtChanged(); })" />
                        </div>

                        <div style="display:flex; gap:12px;">
                            <label style="display:flex; align-items:center; gap:4px; cursor:pointer;">
                                <input type="checkbox" checked="@editRule.Bold"
                                       @onchange="@(e => { editRule.Bold = (bool)(e.Value ?? false); OnCondFmtChanged(); })" />
                                <strong>Bold</strong>
                            </label>
                            <label style="display:flex; align-items:center; gap:4px; cursor:pointer;">
                                <input type="checkbox" checked="@editRule.Italic"
                                       @onchange="@(e => { editRule.Italic = (bool)(e.Value ?? false); OnCondFmtChanged(); })" />
                                <em>Italic</em>
                            </label>
                        </div>

                        <div style="display:flex; align-items:center; gap:6px;">
                            <label style="color:#666; width:64px;">Background</label>
                            <input type="color" value="@(editRule.BackgroundColor ?? "#ffffff")"
                                   style="width:26px; height:26px; padding:1px; border:1px solid #ccc; border-radius:3px; cursor:pointer;"
                                   @onchange="@(e => { editRule.BackgroundColor = e.Value?.ToString(); OnCondFmtChanged(); })" />
                            <button type="button" class="ss-btn" @onclick="@(() => { editRule.BackgroundColor = null; OnCondFmtChanged(); })">✕</button>
                            <span style="color:#aaa; font-family:monospace;">@(editRule.BackgroundColor ?? "none")</span>
                        </div>

                        <div style="display:flex; align-items:center; gap:6px;">
                            <label style="color:#666; width:64px;">Text color</label>
                            <input type="color" value="@(editRule.TextColor ?? "#000000")"
                                   style="width:26px; height:26px; padding:1px; border:1px solid #ccc; border-radius:3px; cursor:pointer;"
                                   @onchange="@(e => { editRule.TextColor = e.Value?.ToString(); OnCondFmtChanged(); })" />
                            <button type="button" class="ss-btn" @onclick="@(() => { editRule.TextColor = null; OnCondFmtChanged(); })">✕</button>
                            <span style="color:#aaa; font-family:monospace;">@(editRule.TextColor ?? "none")</span>
                        </div>

                        <button type="button" class="ss-btn" style="color:#c00; border-color:#e99;" @onclick="@(() => DeleteCondFmtRule(editRule))">Delete Rule</button>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="doc-section">
    <h2>How it works</h2>
    <p class="doc-note">
        The grid's <code>Data</code> is a list of thin row-index wrappers (<code>SsRow</code>).
        Each column's <code>Display</code> lambda reads from a 2-D <code>Cell[,]</code> array, so
        the grid never owns the cell values. <code>Template</code> renders checkboxes for
        <code>IsCheckBox</code> cells. Chart overlays live in the <code>Overlays</code> slot.
        Conditional formatting rules are evaluated after <code>Calculate()</code>.
        All state is persisted automatically to <code>localStorage</code>.
    </p>
    <pre class="doc-code">@codeSnippet</pre>
</div>

