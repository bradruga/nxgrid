@page "/theming"

<PageTitle>Theming — NxGrid</PageTitle>

<h1>Theming</h1>
<p class="doc-intro">
    All NxGrid colors are CSS custom properties — override them on <code>:root</code> or any ancestor element.
    Font size and family inherit from the parent; override the <code>.nx-grid</code> class to change them.
    The <code>CellStyle</code> parameter lets you apply inline styles per cell.
</p>

<div class="doc-section">
    <h2>Dark Theme</h2>
    <p class="doc-note">
        NxGrid has no built-in theme — all colors are CSS custom properties, so the grid
        automatically picks up any overrides on an ancestor element. Use the <strong>Dark mode</strong>
        button in the sidebar to see this page and the grid update together.
        The toggle works by adding a <code>site-dark</code> class to the layout container,
        which redefines the <code>--nx-grid-*</code> variables for everything underneath it.
    </p>
    <NxGrid T="Person" Data="@SampleData.People.ToList()" RowGutter="NxGridRowGutter.Numbers" Cursor="@NxGridCursor.Cell">
        <NxGridColumn Property="@(x => x.Id)"         Width="50"  MaxWidth="50" />
        <NxGridColumn Property="@(x => x.FirstName)"  Width="130" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="130" />
        <NxGridColumn Property="@(x => x.Age)"        Width="70"  Alignment="NxGridColumnAlignment.Right" />
        <NxGridColumn Property="@(x => x.Department)" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@darkThemeCode</pre>
</div>

<div class="doc-section">
    <h2>CellStyle — Per-Cell Styling</h2>
    <p class="doc-note">
        Provide a <code>Func&lt;T, NxGridColumn&lt;T&gt;, NxGridCellStyle?&gt;</code> to style individual cells.
        Use <code>Style</code> for arbitrary inline CSS, <code>Border</code> for a full-cell outline, or individual
        sides (<code>BorderTop</code>, <code>BorderRight</code>, <code>BorderBottom</code>, <code>BorderLeft</code>).
        All styling is applied before selection color blending, so custom backgrounds mix correctly with highlights.
    </p>
    <NxGrid T="Person" Data="@SampleData.People.ToList()" CellStyle="@GetCellStyle" Cursor="@NxGridCursor.Cell" RowGutter="NxGridRowGutter.Numbers">
        <NxGridColumn Property="@(x => x.Id)"         Width="50"  MaxWidth="50" />
        <NxGridColumn Property="@(x => x.FirstName)"  Width="130" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="130" />
        <NxGridColumn Property="@(x => x.Age)"        Width="70"  Alignment="NxGridColumnAlignment.Right" />
        <NxGridColumn Property="@(x => x.Department)" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@cellStyleCode</pre>
</div>

<div class="doc-section">
    <h2>CellStyle — Borders</h2>
    <p class="doc-note">
        Use <code>Border</code> to outline an entire cell, or individual sides to apply directional accents.
        Individual sides override <code>Border</code> — the same precedence as CSS <code>border</code> + <code>border-top</code>.
    </p>
    <NxGrid T="Person" Data="@SampleData.People.ToList()" CellStyle="@GetBorderStyle" Cursor="@NxGridCursor.Cell" RowGutter="NxGridRowGutter.Numbers">
        <NxGridColumn Property="@(x => x.Id)"         Width="50"  MaxWidth="50" />
        <NxGridColumn Property="@(x => x.FirstName)"  Width="130" />
        <NxGridColumn Property="@(x => x.LastName)"   Width="130" />
        <NxGridColumn Property="@(x => x.Age)"        Width="70"  Alignment="NxGridColumnAlignment.Right" />
        <NxGridColumn Property="@(x => x.Department)" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@cellBordersCode</pre>
</div>

<div class="doc-section">
    <h2>CSS Custom Properties Reference</h2>
    <table class="doc-table">
        <thead><tr><th>Variable</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
            <tr><td>--nx-grid-fg</td><td>(inherited)</td><td>Cell text color; inherits from parent when unset</td></tr>
            <tr><td>--nx-grid-border</td><td>#E0E0E0</td><td>Cell border color</td></tr>
            <tr><td>--nx-grid-header-bg</td><td>#F0F0F0</td><td>Header row background</td></tr>
            <tr><td>--nx-grid-header-border</td><td>#999999</td><td>Header border color</td></tr>
            <tr><td>--nx-grid-row-even-bg</td><td>#e7e7e7</td><td>Even row background (RowBanding)</td></tr>
            <tr><td>--nx-grid-row-odd-bg</td><td>#ececec</td><td>Odd row background (RowBanding)</td></tr>
            <tr><td>--nx-grid-surface</td><td>#fff</td><td>Edit input background, combo-box surface</td></tr>
            <tr><td>--nx-grid-selection-bg</td><td>#C7C7C7</td><td>Selected cell background</td></tr>
            <tr><td>--nx-grid-selected-border</td><td>#AFAFAF</td><td>Border color of selected cells</td></tr>
            <tr><td>--nx-grid-selection-border</td><td>#217346</td><td>Edit-mode input border (Excel green)</td></tr>
            <tr><td>--nx-grid-accent</td><td>#0078d4</td><td>Focus rings, sort icons, hover accents</td></tr>
            <tr><td>--nx-grid-accent-dark</td><td>#005a9e</td><td>Active/pressed states</td></tr>
            <tr><td>--nx-grid-row-number-fg</td><td>#666</td><td>Row number gutter text color</td></tr>
            <tr><td>--nx-grid-icon-fg</td><td>#000</td><td>Header icon color</td></tr>
            <tr><td>--nx-grid-icon-muted-fg</td><td>#555</td><td>Muted icon color</td></tr>
            <tr><td>--nx-grid-hover-bg</td><td>#f0f0f0</td><td>Menu item hover background</td></tr>
            <tr><td>--nx-grid-item-hover-bg</td><td>#e8f4ff</td><td>Combo/filter item hover background</td></tr>
            <tr><td>--nx-grid-muted-fg</td><td>#888</td><td>Muted text (e.g. "No matches")</td></tr>
            <tr><td>--nx-grid-shadow</td><td>rgba(0,0,0,0.15)</td><td>Dropdown / menu shadow</td></tr>
        </tbody>
    </table>
</div>

@code {
    NxGridCellStyle? GetCellStyle(Person p, NxGridColumn<Person> col)
    {
        if (col.Title == "Age" && p.Age >= 50)
            return new NxGridCellStyle { Style = "color:#dc2626;font-weight:600;" };
        if (col.Title == "Department" && p.Department == "Engineering")
            return new NxGridCellStyle { Style = "background-color:#eff6ff;" };
        return null;
    }

    NxGridCellStyle? GetBorderStyle(Person p, NxGridColumn<Person> col)
    {
        // Thick left accent on Engineering rows
        if (col.Title == "Department" && p.Department == "Engineering")
            return new NxGridCellStyle
            {
                Style      = "background-color:#eff6ff;",
                BorderLeft = "3px solid #0078d4"
            };
        // Full outline on Finance rows
        if (p.Department == "Finance")
            return new NxGridCellStyle { Border = "1px solid #d97706" };
        // Top border only on rows where age >= 50
        if (col.Title == "Age" && p.Age >= 50)
            return new NxGridCellStyle
            {
                Style     = "color:#dc2626;font-weight:600;",
                BorderTop = "2px solid #dc2626"
            };
        return null;
    }

    string darkThemeCode = DemoCodeSamples.DarkTheme;
    string cellStyleCode = DemoCodeSamples.CellStyle;
    string cellBordersCode = DemoCodeSamples.CellBorders;
}
