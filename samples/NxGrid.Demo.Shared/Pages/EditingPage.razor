@page "/editing"

<PageTitle>Editing — NxGrid</PageTitle>

<h1>Editing</h1>
<p class="doc-intro">
    A column becomes editable when it has a <code>Setter</code>. Enter edit mode by pressing
    <kbd class="doc-kbd">F2</kbd>, double-clicking, or typing any printable character.
    Commit with <kbd class="doc-kbd">Enter</kbd> or <kbd class="doc-kbd">Tab</kbd>;
    cancel with <kbd class="doc-kbd">Escape</kbd>. The raw string is passed to the setter — parsing is the host's responsibility.
</p>

<div class="doc-section">
    <h2>Text Editing and Combo-Box</h2>
    <p class="doc-note">First, Last, Age, and Department are all editable. Department uses a combo-box dropdown — type to filter, then press <kbd class="doc-kbd">↓</kbd> or click to select.</p>
    <NxGrid T="Person" Data="@editPeople" Cursor="@NxGridCursor.Cell" ShowRowNumbers="true">
        <NxGridColumn T="Person" Title="Id"
                      Getter="@(x => x.Id)" Width="50" MaxWidth="50" />
        <NxGridColumn T="Person" Title="First Name"
                      Getter="@(x => x.FirstName)"
                      Setter="@((x, v) => x.FirstName = v ?? "")" Width="140" />
        <NxGridColumn T="Person" Title="Last Name"
                      Getter="@(x => x.LastName)"
                      Setter="@((x, v) => x.LastName = v ?? "")" Width="140" />
        <NxGridColumn T="Person" Title="Age"
                      Getter="@(x => x.Age)"
                      Setter="@((x, v) => x.Age = int.TryParse(v, out var i) ? i : x.Age)"
                      Width="80" Alignment="NxGridColumnAlignment.Right" />
        <NxGridColumn T="Person" Title="Department"
                      Getter="@(x => x.Department)"
                      Setter="@((x, v) => x.Department = v ?? "")"
                      ComboBoxOptions="@(() => ["Engineering", "Finance", "HR", "Marketing", "Sales"])" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@basicEditCode</pre>
</div>

<div class="doc-section">
    <h2>EditableGetter — Per-Row Editability</h2>
    <p class="doc-note">Finance rows are locked. Cells still render normally but cannot be edited — pressing <kbd class="doc-kbd">F2</kbd> or typing does nothing for those rows.</p>
    <NxGrid T="Person" Data="@editPeople" Cursor="@NxGridCursor.Cell" ShowRowNumbers="true">
        <NxGridColumn T="Person" Title="Id"
                      Getter="@(x => x.Id)" Width="50" MaxWidth="50" />
        <NxGridColumn T="Person" Title="First Name"
                      Getter="@(x => x.FirstName)"
                      Setter="@((x, v) => x.FirstName = v ?? "")"
                      EditableGetter="@(x => x.Department != "Finance")"
                      Width="140" />
        <NxGridColumn T="Person" Title="Last Name"
                      Getter="@(x => x.LastName)"
                      Setter="@((x, v) => x.LastName = v ?? "")"
                      EditableGetter="@(x => x.Department != "Finance")"
                      Width="140" />
        <NxGridColumn T="Person" Title="Department"
                      Getter="@(x => x.Department)" Width="140" />
        <NxGridColumn T="Person" Title="Editable?"
                      Getter="@(x => x.Department == "Finance" ? "Locked" : "Yes")"
                      Width="90" Alignment="NxGridColumnAlignment.Center" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@editableGetterCode</pre>
</div>

<div class="doc-section">
    <h2>OnCellDoubleClicked — Non-Editable Columns</h2>
    <p class="doc-note"><code>OnCellDoubleClicked</code> fires on double-click for columns that have no <code>Setter</code>. Use it to open a detail panel or navigate.</p>
    <div class="doc-controls">
        <span style="font-size:13px;color:#555;">Last double-clicked: <strong>@doubleClickLog</strong></span>
    </div>
    <NxGrid T="Person" Data="@editPeople" Cursor="@NxGridCursor.Pointer"
            OnCellDoubleClicked="@OnCellDoubleClicked">
        <NxGridColumn T="Person" Title="Id"         Getter="@(x => x.Id)"         Width="50" MaxWidth="50" />
        <NxGridColumn T="Person" Title="First Name" Getter="@(x => x.FirstName)"  Width="140" />
        <NxGridColumn T="Person" Title="Last Name"  Getter="@(x => x.LastName)"   Width="140" />
        <NxGridColumn T="Person" Title="Department" Getter="@(x => x.Department)" />
    </NxGrid>
    <pre class="doc-code" style="margin-top:12px">@doubleClickCode</pre>
</div>

<div class="doc-section">
    <h2>Column Editing Parameters</h2>
    <table class="doc-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Description</th></tr></thead>
        <tbody>
            <tr>
                <td>Setter</td>
                <td>Action&lt;T, string?&gt;</td>
                <td>Makes the column editable. Called with the committed text value on Enter, Tab, or click-away.</td>
            </tr>
            <tr>
                <td>EditableGetter</td>
                <td>Func&lt;T, bool&gt;</td>
                <td>Per-row guard — Setter only fires for rows where this returns true.</td>
            </tr>
            <tr>
                <td>ComboBoxOptions</td>
                <td>Func&lt;IEnumerable&lt;string?&gt;&gt;</td>
                <td>Turns the inline editor into a dropdown. Called fresh on each open, so the list can be dynamic.</td>
            </tr>
            <tr>
                <td>Nullable</td>
                <td>bool</td>
                <td>When true, <kbd class="doc-kbd">Delete</kbd> clears the cell to null instead of "" / 0.</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="doc-section">
    <h2>Grid Parameter: TransformPastedValue</h2>
    <pre class="doc-code">@transformCode</pre>
</div>

@code {
    List<Person> editPeople = SampleData.GetPeopleCopy();
    string doubleClickLog = "none";

    Task OnCellDoubleClicked(Person row, NxGridColumn<Person> col)
    {
        doubleClickLog = $"{row.FirstName} {row.LastName} — {col.Title}";
        return Task.CompletedTask;
    }

    string basicEditCode    = DemoCodeSamples.BasicEdit;
    string editableGetterCode = DemoCodeSamples.EditableGetter;
    string doubleClickCode  = DemoCodeSamples.DoubleClick;
    string transformCode    = DemoCodeSamples.TransformPasted;
}
