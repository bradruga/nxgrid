@code {
    static readonly Dictionary<string, string[]> GroupRoutes = new()
    {
        ["Guide"]       = ["", "getting-started"],
        ["Reference"]   = ["reference/nxgrid", "reference/nxgrid-column", "reference/types"],
        ["Selection"]   = ["selection", "selection-math"],
        ["Editing"]     = ["editing", "drag-fill", "multi-line", "math-expression", "combo-box", "date-picker", "time-entry", "checkbox", "batch-update"],
        ["Columns"]     = ["columns", "frozen-columns", "hidden-columns", "header-template", "footer-template"],
        ["Rows"]        = ["grouping", "row-drag-drop", "empty-state"],
        ["Interaction"] = ["keyboard", "context-menu", "tooltips", "filter-sort-events"],
        ["Appearance"]  = ["layout", "theming"],
        ["Advanced"]    = ["state-persistence", "print", "large-data", "stress-test"],
        ["Examples"]    = ["spreadsheet", "trading-desk", "airport-departures"],
    };

    HashSet<string> collapsed = [.. GroupRoutes.Keys];

    protected override void OnInitialized()
    {
        ExpandActiveGroup();
        Nav.LocationChanged += OnLocationChanged;
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ExpandActiveGroup();
        InvokeAsync(StateHasChanged);
    }

    void ExpandActiveGroup()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/').ToLowerInvariant();

        foreach (var (group, routes) in GroupRoutes)
        {
            if (routes.Contains(path, StringComparer.OrdinalIgnoreCase))
            {
                collapsed.Remove(group);
                return;
            }
        }
    }

    void Toggle(string group)
    {
        if (!collapsed.Add(group))
            collapsed.Remove(group);
    }

    bool IsCollapsed(string group) => collapsed.Contains(group);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
