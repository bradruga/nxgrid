@typeparam T

<div class="nx-grid-row" style="@RowStyle" data-row="@RowIndex">
    @if (RowGutter == NxGridRowGutter.DragHandle)
    {
        <div class="nx-grid-row-start nx-grid-drag-handle-gutter">
            <span class="nx-grid-drag-handle"
                  @onmousedown="@(args => HandleDragMouseDown(args))"
                  @onmousedown:stopPropagation
                  @onmousedown:preventDefault>
                <svg xmlns="http://www.w3.org/2000/svg" width="12" height="16" viewBox="0 0 12 16" aria-hidden="true">
                    <circle cx="4"  cy="3"  r="1.5" fill="currentColor"/>
                    <circle cx="4"  cy="8"  r="1.5" fill="currentColor"/>
                    <circle cx="4"  cy="13" r="1.5" fill="currentColor"/>
                    <circle cx="8"  cy="3"  r="1.5" fill="currentColor"/>
                    <circle cx="8"  cy="8"  r="1.5" fill="currentColor"/>
                    <circle cx="8"  cy="13" r="1.5" fill="currentColor"/>
                </svg>
            </span>
        </div>
    }
    else if (RowGutter == NxGridRowGutter.Numbers)
    {
        <div class="nx-grid-row-start nx-grid-row-number"
             @onmousedown="@(args => OnRowNumberMouseDown != null ? OnRowNumberMouseDown(args, RowIndex) : Task.CompletedTask)"
             @onmouseenter="@(args => OnRowNumberMouseEnter != null ? OnRowNumberMouseEnter(args, RowIndex) : Task.CompletedTask)">
            <span>@(RowIndex + 1)</span>
        </div>
    }
    else if (RowGutter == NxGridRowGutter.Blank)
    {
        <div class="nx-grid-row-start"
             @onmousedown="@(args => OnRowNumberMouseDown != null ? OnRowNumberMouseDown(args, RowIndex) : Task.CompletedTask)"
             @onmouseenter="@(args => OnRowNumberMouseEnter != null ? OnRowNumberMouseEnter(args, RowIndex) : Task.CompletedTask)">
        </div>
    }

    @{ var isMultiLineGrid = Columns.Any(c => c.MultiLine); }
    @for (var ci = 0; ci < Columns.Count; ci++)
    {
        var col = Columns[ci];
        var colIdx = ci;
        var isAnchor = SelectionMode == NxGridSelectionMode.Cell
            && AdditionalRanges.Count <= 1
            && SelectedRange != null && RowIndex == SelectedRange.StartRow && ci == SelectedRange.StartCol;
        var inAdditional = AdditionalRanges.Count > 1 && AdditionalRanges.Take(AdditionalRanges.Count - 1).Any(r => r.IsCellInRange(RowIndex, ci));
        var selected = (SelectedRange?.IsCellInRange(RowIndex, ci) == true && !isAnchor) || inAdditional;
        var isFocusHighlighted = FocusCellEnabled
            && FocusCellAnchorRow >= 0
            && (RowIndex == FocusCellAnchorRow || ci == FocusCellAnchorCol)
            && !isAnchor
            && !selected;
        var inPickRange = PickRange?.IsCellInRange(RowIndex, ci) == true;

        <div class="nx-grid-cell @(col.IsLastFrozen ? "nx-grid-cell-frozen-last" : "") @(selected ? "nx-grid-cell-selected" : isAnchor ? "nx-grid-cell-anchor" : isFocusHighlighted ? "nx-grid-cell-focus-highlight" : "") @(inPickRange ? "nx-grid-cell-pick-range" : "") @(IsEditing && EditRow == RowIndex && EditCol == colIdx && col.IsMultiLineColumn ? "nx-grid-cell-editing-ml" : "")"
             data-col="@ci"
             style="@(CellStyleFunc?.Invoke(Row, col, selected) + GetSelectionBorderStyle(RowIndex, colIdx) + CursorStyle)"
             @onmousedown="@(args => HandleMouseDown(args, col))"
             @onmouseenter="@(args => HandleMouseEnter(args, col))"
             @onmouseleave="@(() => OnMouseLeave?.Invoke(Row, col))"
             @onmouseup="@(() => OnMouseUp?.Invoke(Row, col) ?? Task.CompletedTask)"
             @oncontextmenu="@(args => OnContextMenu?.Invoke(args, Row, col))"
             @oncontextmenu:preventDefault
             @ondblclick="@(() => OnDoubleClick?.Invoke(Row, col) ?? Task.CompletedTask)">
            @if (IsEditing && EditRow == RowIndex && EditCol == colIdx)
            {
                @if (col.IsComboColumn)
                {
                    <div class="nx-grid-combo-wrapper">
                        <input class="nx-grid-combo-input"
                               @ref="editInputRef"
                               value="@EditValue"
                               @oninput="@(e => OnEditInput?.Invoke(e))"
                               @onkeydown="@(e => HandleEditKeyDown(e))"
                               @onkeydown:stopPropagation
                               @onmousedown:stopPropagation
                               @onmouseup:stopPropagation />
                        <button type="button" class="nx-grid-combo-button"
                                @onmousedown="@(() => OnComboButtonClick != null ? OnComboButtonClick(RowIndex, colIdx) : Task.CompletedTask)"
                                @onmousedown:stopPropagation
                                @onmousedown:preventDefault>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="m7 10l5 5l5-5z"/></svg>
                                </button>
                    </div>
                }
                else if (col.IsMultiLineColumn)
                {
                    @* Invisible height anchor — keeps the row from collapsing while the textarea is absolute.
                       Trailing \n doesn't generate line height in pre-wrap without content on that line,
                       so append a zero-width space to force the new line to occupy height. *@
                    <span class="nx-grid-cell-text nx-grid-cell-text-multiline" style="visibility:hidden">@(EditValue.EndsWith('\n') ? EditValue + "​" : EditValue)</span>
                    <textarea class="nx-grid-edit-textarea"
                              @ref="editInputRef"
                              value="@EditValue"
                              @oninput="@(e => OnEditInput?.Invoke(e))"
                              @onkeydown="@(e => HandleEditKeyDown(e))"
                              @onkeydown:stopPropagation
                              @onmousedown:stopPropagation
                              @onmouseup:stopPropagation></textarea>
                }
                else if (col.IsDatePickerColumn)
                {
                    <div class="nx-grid-datepicker-wrapper">
                        <input class="nx-grid-datepicker-input"
                               @ref="editInputRef"
                               value="@EditValue"
                               @oninput="@(e => OnEditInput?.Invoke(e))"
                               @onkeydown="@(e => HandleEditKeyDown(e))"
                               @onkeydown:stopPropagation
                               @onmousedown:stopPropagation
                               @onmouseup:stopPropagation />
                        <button type="button" class="nx-grid-datepicker-button"
                                @onmousedown="@(() => OnDatePickerButtonClick != null ? OnDatePickerButtonClick(RowIndex, colIdx) : Task.CompletedTask)"
                                @onmousedown:stopPropagation
                                @onmousedown:preventDefault>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                        </button>
                    </div>
                }
                else if (isMultiLineGrid)
                {
                    @* Textarea in single-line mode: fills height so text is top-aligned (input always centers) *@
                    <textarea class="nx-grid-edit-textarea-sl"
                              @ref="editInputRef"
                              value="@EditValue"
                              @oninput="@(e => OnEditInput?.Invoke(e))"
                              @onkeydown="@(e => HandleEditKeyDown(e))"
                              @onkeydown:stopPropagation
                              @onmousedown:stopPropagation
                              @onmouseup:stopPropagation></textarea>
                }
                else
                {
                    <input class="nx-grid-edit-input"
                           @ref="editInputRef"
                           value="@EditValue"
                           @oninput="@(e => OnEditInput?.Invoke(e))"
                           @onkeydown="@(e => HandleEditKeyDown(e))"
                           @onkeydown:stopPropagation
                           @onmousedown:stopPropagation
                           @onmouseup:stopPropagation />
                }
            }
            else if (col.Template != null)
            {
                <span class="nx-grid-cell-template">@col.Template(Row)</span>
                @if (col.IsComboColumn && RowIndex == SelectedRange?.StartRow && colIdx == SelectedRange?.StartCol
                     && (col.Editable ?? GridEditable)
                     && (CellEditableGetter == null || CellEditableGetter(Row, col)))
                {
                    <button type="button" class="nx-grid-combo-button nx-grid-combo-button-idle"
                            @onmousedown="@(() => OnComboButtonClick != null ? OnComboButtonClick(RowIndex, colIdx) : Task.CompletedTask)"
                            @onmousedown:stopPropagation
                            @onmousedown:preventDefault>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="m7 10l5 5l5-5z"/></svg>
                            </button>
                }
            }
            else if (col.IsCheckboxColumn)
            {
                var boolValue = col.EffectiveGetter?.Invoke(Row) is true;
                var colEditable = col.Editable ?? GridEditable;
                var isBlocked = CellEditableGetter != null && !CellEditableGetter(Row, col);
                var wrapCls = "nx-grid-checkbox-wrap"
                    + (boolValue    ? " nx-grid-checkbox-checked"  : "")
                    + (!colEditable ? " nx-grid-checkbox-disabled"
                      : isBlocked  ? " nx-grid-checkbox-blocked"   : "");
                <span class="@wrapCls"
                      @onclick="@(() => HandleCheckboxClick(colIdx))"
                      @ondblclick:stopPropagation>
                    @if (boolValue)
                    {
                        <svg width="10" height="8" viewBox="0 0 10 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M1 4L3.5 6.5L9 1" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                </span>
            }
            else
            {
                var rawValue = col.EffectiveGetter?.Invoke(Row);
                object? cellValue;
                if (col.IsDatePickerColumn && col.Display == null)
                    cellValue = (object?)(col.FormatDateValue(rawValue) ?? rawValue?.ToString());
                else
                    cellValue = rawValue;
                var cellDisplay = col.MultiLine && cellValue is string sv && sv.EndsWith('\n')
                    ? (object?)(sv + "​")
                    : cellValue;
                <span class="nx-grid-cell-text @(col.MultiLine ? "nx-grid-cell-text-multiline" : "")">@cellDisplay</span>
                @if (col.IsComboColumn && RowIndex == SelectedRange?.StartRow && colIdx == SelectedRange?.StartCol
                     && (col.Editable ?? GridEditable)
                     && (CellEditableGetter == null || CellEditableGetter(Row, col)))
                {
                    <button type="button" class="nx-grid-combo-button nx-grid-combo-button-idle"
                            @onmousedown="@(() => OnComboButtonClick != null ? OnComboButtonClick(RowIndex, colIdx) : Task.CompletedTask)"
                            @onmousedown:stopPropagation
                            @onmousedown:preventDefault>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="m7 10l5 5l5-5z"/></svg>
                            </button>
                }
                @if (col.IsDatePickerColumn && RowIndex == SelectedRange?.StartRow && colIdx == SelectedRange?.StartCol
                     && (col.Editable ?? GridEditable)
                     && (CellEditableGetter == null || CellEditableGetter(Row, col)))
                {
                    <button type="button" class="nx-grid-datepicker-button nx-grid-datepicker-button-idle"
                            @onmousedown="@(() => OnDatePickerButtonClick != null ? OnDatePickerButtonClick(RowIndex, colIdx) : Task.CompletedTask)"
                            @onmousedown:stopPropagation
                            @onmousedown:preventDefault>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public T Row { get; set; } = default!;
    [Parameter] public int RowIndex { get; set; }
    [Parameter] public List<NxGridColumn<T>> Columns { get; set; } = [];
    [Parameter] public string RowStyle { get; set; } = "";
    [Parameter] public NxGridRange? SelectedRange { get; set; }
    [Parameter] public IReadOnlyList<NxGridRange> AdditionalRanges { get; set; } = [];
    [Parameter] public NxGridRange? PickRange { get; set; }
    [Parameter] public NxGridRowGutter RowGutter { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public int EditRow { get; set; }
    [Parameter] public int EditCol { get; set; }
    [Parameter] public string EditValue { get; set; } = "";
    [Parameter] public Func<T, NxGridColumn<T>, bool, string>? CellStyleFunc { get; set; }
    [Parameter] public Func<MouseEventArgs, T, NxGridColumn<T>, Task>? OnMouseDown { get; set; }
    [Parameter] public Func<MouseEventArgs, T, NxGridColumn<T>, Task>? OnMouseEnter { get; set; }
    [Parameter] public Func<T, NxGridColumn<T>, Task>? OnMouseUp { get; set; }
    [Parameter] public Action<T, NxGridColumn<T>>? OnMouseLeave { get; set; }
    [Parameter] public Action<MouseEventArgs, T, NxGridColumn<T>>? OnContextMenu { get; set; }
    [Parameter] public Func<T, NxGridColumn<T>, Task>? OnDoubleClick { get; set; }
    [Parameter] public Func<T, NxGridColumn<T>, bool>? CellEditableGetter { get; set; }
    [Parameter] public Action<ChangeEventArgs>? OnEditInput { get; set; }
    [Parameter] public Func<KeyboardEventArgs, Task>? OnEditKeyDown { get; set; }
    [Parameter] public Func<MouseEventArgs, int, Task>? OnRowNumberMouseDown { get; set; }
    [Parameter] public Func<MouseEventArgs, int, Task>? OnRowNumberMouseEnter { get; set; }
    [Parameter] public Func<MouseEventArgs, int, Task>? OnDragHandleMouseDown { get; set; }
    [Parameter] public Func<int, int, Task>? OnComboButtonClick { get; set; }
    [Parameter] public Func<int, int, Task>? OnDatePickerButtonClick { get; set; }
    [Parameter] public Func<int, int, Task>? OnCheckboxToggle { get; set; }
    [Parameter] public NxGridCursor Cursor { get; set; }
    [Parameter] public int RenderToken { get; set; }
    [Parameter] public bool GridEditable { get; set; }
    [Parameter] public NxGridSelectionMode SelectionMode { get; set; }
    [Parameter] public bool FocusCellEnabled { get; set; }
    [Parameter] public int FocusCellAnchorRow { get; set; } = -1;
    [Parameter] public int FocusCellAnchorCol { get; set; } = -1;

    private string CursorStyle => Cursor switch
    {
        NxGridCursor.Cell    => "cursor:cell;",
        NxGridCursor.Pointer => "cursor:pointer;",
        _                    => ""
    };

    private ElementReference editInputRef;

    // Snapshot of parameters from the last render — used by ShouldRender.
    // The selection range is stored as a value tuple rather than a reference so that
    // in-place mutations to NxGridRange (e.g. during mouse-drag) are detected correctly.
    private T? prevRow;
    private (int MinRow, int MaxRow, int MinCol, int MaxCol)? prevRangeSnapshot;
    private (int MinRow, int MaxRow, int MinCol, int MaxCol)? prevPickRangeSnapshot;
    private List<(int, int, int, int)> prevAdditionalSnapshots = [];
    private bool prevIsEditing;
    private NxGridCursor prevCursor;
    private NxGridSelectionMode prevSelectionMode;
    private int prevEditRow = -1;
    private int prevEditCol = -1;
    private string prevEditValue = "";
    private int prevRenderToken = -1;
    private NxGridRowGutter prevRowGutter;
    private bool prevFocusCellEnabled;
    private int prevFocusCellAnchorRow = -1;
    private int prevFocusCellAnchorCol = -1;

    // Track which edit session we've already focused so we focus exactly once per cell entry
    private (int Row, int Col) focusedSession = (-1, -1);

    private Task HandleDragMouseDown(MouseEventArgs args) =>
        OnDragHandleMouseDown?.Invoke(args, RowIndex) ?? Task.CompletedTask;

    private Task HandleMouseDown(MouseEventArgs args, NxGridColumn<T> col) =>
        OnMouseDown?.Invoke(args, Row, col) ?? Task.CompletedTask;

    private Task HandleMouseEnter(MouseEventArgs args, NxGridColumn<T> col) =>
        OnMouseEnter?.Invoke(args, Row, col) ?? Task.CompletedTask;

    private Task HandleEditKeyDown(KeyboardEventArgs args) =>
        OnEditKeyDown?.Invoke(args) ?? Task.CompletedTask;

    private Task HandleCheckboxClick(int colIdx) =>
        OnCheckboxToggle?.Invoke(RowIndex, colIdx) ?? Task.CompletedTask;

    protected override bool ShouldRender()
    {
        var rowChanged       = !EqualityComparer<T>.Default.Equals(prevRow, Row);
        var selChanged       = SelectionChangedForRow();
        var pickChanged      = PickRangeChangedForRow();
        var addlChanged      = AdditionalRangesChangedForRow();
        var editChanged      = EditChangedForRow();
        var tokenChanged     = RenderToken != prevRenderToken;
        var cursorChanged    = Cursor != prevCursor;
        var gutterChanged    = RowGutter != prevRowGutter;
        var modeChanged      = SelectionMode != prevSelectionMode;
        var focusChanged     = FocusCellChangedForRow();

        if (!rowChanged && !selChanged && !pickChanged && !addlChanged && !editChanged && !tokenChanged && !cursorChanged && !gutterChanged && !modeChanged && !focusChanged)
            return false;

        // Save snapshot so the next call can compare against it
        prevRow                 = Row;
        prevRangeSnapshot       = GetRangeSnapshot();
        prevPickRangeSnapshot   = GetPickRangeSnapshot();
        prevAdditionalSnapshots = GetAdditionalSnapshots();
        prevIsEditing           = IsEditing;
        prevEditRow             = EditRow;
        prevEditCol             = EditCol;
        prevEditValue           = EditValue;
        prevRenderToken         = RenderToken;
        prevCursor              = Cursor;
        prevRowGutter           = RowGutter;
        prevSelectionMode       = SelectionMode;
        prevFocusCellEnabled    = FocusCellEnabled;
        prevFocusCellAnchorRow  = FocusCellAnchorRow;
        prevFocusCellAnchorCol  = FocusCellAnchorCol;

        return true;
    }

    private (int, int, int, int)? GetRangeSnapshot() =>
        SelectedRange == null ? null : (
            Math.Min(SelectedRange.StartRow, SelectedRange.EndRow),
            Math.Max(SelectedRange.StartRow, SelectedRange.EndRow),
            Math.Min(SelectedRange.StartCol, SelectedRange.EndCol),
            Math.Max(SelectedRange.StartCol, SelectedRange.EndCol));

    private (int, int, int, int)? GetPickRangeSnapshot() =>
        PickRange == null ? null : (
            Math.Min(PickRange.StartRow, PickRange.EndRow),
            Math.Max(PickRange.StartRow, PickRange.EndRow),
            Math.Min(PickRange.StartCol, PickRange.EndCol),
            Math.Max(PickRange.StartCol, PickRange.EndCol));

    private bool PickRangeChangedForRow()
    {
        var curr = GetPickRangeSnapshot();
        if (curr == prevPickRangeSnapshot) return false;
        var prevTouches = prevPickRangeSnapshot is var (pr0, pr1, _, _) && RowIndex >= pr0 && RowIndex <= pr1;
        var currTouches = curr              is var (cr0, cr1, _, _) && RowIndex >= cr0 && RowIndex <= cr1;
        return prevTouches || currTouches;
    }

    private List<(int, int, int, int)> GetAdditionalSnapshots()
    {
        if (AdditionalRanges.Count <= 1) return [];
        var result = new List<(int, int, int, int)>(AdditionalRanges.Count - 1);
        for (var i = 0; i < AdditionalRanges.Count - 1; i++)
        {
            var r = AdditionalRanges[i];
            result.Add((Math.Min(r.StartRow, r.EndRow), Math.Max(r.StartRow, r.EndRow),
                        Math.Min(r.StartCol, r.EndCol), Math.Max(r.StartCol, r.EndCol)));
        }
        return result;
    }

    private bool AdditionalRangesChangedForRow()
    {
        var curr = GetAdditionalSnapshots();
        if (curr.Count != prevAdditionalSnapshots.Count)
        {
            // Check if any old or new snapshot touches this row
            return prevAdditionalSnapshots.Any(s => RowIndex >= s.Item1 && RowIndex <= s.Item2)
                || curr.Any(s => RowIndex >= s.Item1 && RowIndex <= s.Item2);
        }
        for (var i = 0; i < curr.Count; i++)
        {
            if (curr[i] != prevAdditionalSnapshots[i])
            {
                var prev = prevAdditionalSnapshots[i];
                if ((RowIndex >= prev.Item1 && RowIndex <= prev.Item2) ||
                    (RowIndex >= curr[i].Item1 && RowIndex <= curr[i].Item2))
                    return true;
            }
        }
        return false;
    }

    private bool SelectionChangedForRow()
    {
        var curr = GetRangeSnapshot();
        if (curr == prevRangeSnapshot) return false;

        // Fast path: if neither snapshot touches this row, nothing changed for us
        var prevTouches = prevRangeSnapshot is var (pr0, pr1, _, _) && RowIndex >= pr0 && RowIndex <= pr1;
        var currTouches = curr              is var (cr0, cr1, _, _) && RowIndex >= cr0 && RowIndex <= cr1;
        if (!prevTouches && !currTouches) return false;

        // At least one range touches this row — check each column
        for (var c = 0; c < Columns.Count; c++)
        {
            var was = prevRangeSnapshot is var (r0p, r1p, c0p, c1p) && RowIndex >= r0p && RowIndex <= r1p && c >= c0p && c <= c1p;
            var now = curr              is var (r0c, r1c, c0c, c1c) && RowIndex >= r0c && RowIndex <= r1c && c >= c0c && c <= c1c;
            if (was != now) return true;
        }

        // Re-render when this row's edge status changes (top/bottom border of selection)
        if (prevRangeSnapshot.HasValue && curr.HasValue)
        {
            var prevIsEdgeRow = RowIndex == prevRangeSnapshot.Value.Item1 || RowIndex == prevRangeSnapshot.Value.Item2;
            var currIsEdgeRow = RowIndex == curr.Value.Item1           || RowIndex == curr.Value.Item2;
            if (prevIsEdgeRow || currIsEdgeRow) return true;

            // Re-render when column edges change for in-range rows (left/right border cells)
            if (currTouches && (prevRangeSnapshot.Value.Item3 != curr.Value.Item3 ||
                                prevRangeSnapshot.Value.Item4 != curr.Value.Item4))
                return true;
        }

        return false;
    }

    private string GetSelectionBorderStyle(int row, int col)
    {
        var shadows = new System.Text.StringBuilder();
        if (AdditionalRanges.Count <= 1)
            AppendRangeBorderShadows(shadows, row, col, SelectedRange, "var(--nx-grid-selection-border)");
        AppendRangeBorderShadows(shadows, row, col, PickRange, "var(--nx-grid-pick-border)");
        return shadows.Length > 0 ? $"box-shadow:{shadows.ToString().TrimEnd(',')};" : "";
    }

    private static void AppendRangeBorderShadows(System.Text.StringBuilder sb, int row, int col, NxGridRange? range, string color)
    {
        if (range == null || !range.IsCellInRange(row, col)) return;

        var minRow = Math.Min(range.StartRow, range.EndRow);
        var maxRow = Math.Max(range.StartRow, range.EndRow);
        var minCol = Math.Min(range.StartCol, range.EndCol);
        var maxCol = Math.Max(range.StartCol, range.EndCol);

        if (row == minRow) sb.Append($"inset 0 2px 0 0 {color},");
        if (row == maxRow) sb.Append($"inset 0 -2px 0 0 {color},");
        if (col == minCol) sb.Append($"inset 2px 0 0 0 {color},");
        if (col == maxCol) sb.Append($"inset -2px 0 0 0 {color},");
    }

    private bool EditChangedForRow()
    {
        var wasAffected = prevIsEditing && prevEditRow == RowIndex;
        var isAffected  = IsEditing    && EditRow     == RowIndex;
        if (!wasAffected && !isAffected) return false;
        if (wasAffected != isAffected)   return true;
        return prevEditCol != EditCol || prevEditValue != EditValue;
    }

    private bool FocusCellChangedForRow()
    {
        if (FocusCellEnabled == prevFocusCellEnabled
            && FocusCellAnchorRow == prevFocusCellAnchorRow
            && FocusCellAnchorCol == prevFocusCellAnchorCol)
            return false;

        // Feature toggled on or off — re-render all rows
        if (FocusCellEnabled != prevFocusCellEnabled) return true;

        // Anchor column changed — affects every row (each row has a cell in that column)
        if (FocusCellAnchorCol != prevFocusCellAnchorCol) return true;

        // Only anchor row changed — only the two affected rows need to re-render
        return RowIndex == FocusCellAnchorRow || RowIndex == prevFocusCellAnchorRow;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsEditing && EditRow == RowIndex)
        {
            var session = (EditRow, EditCol);
            if (session != focusedSession)
            {
                focusedSession = session;
                try { await editInputRef.FocusAsync(); } catch { }
            }
        }
        else
        {
            focusedSession = (-1, -1);
        }
    }
}
