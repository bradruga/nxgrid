@typeparam T
@attribute [CascadingTypeParameter("T")]

@inject IJSRuntime JsRuntime

<CascadingValue Value="@this">
    @ChildContent
</CascadingValue>

<div id="@id" class="nx-grid @(!RowBanding ? "nx-grid-no-banding" : "") @(HasMultiLineColumns ? "nx-grid-multiline" : "") @(HasTemplateHeaders ? "nx-grid-template-header" : "") @Class" style="@Style;--nx-grid-row-height:@(RowHeight)px;--nx-grid-content-width:@(contentWidth)px"
     data-state-key="@StateKey"
     tabindex="0"
     @onkeydown="@OnGridKeyDown">
    @if (ShowHeader)
    {
    <div class="nx-grid-header-row" style="@headerRowStyle">
        @if (RowGutter != NxGridRowGutter.Hidden)
        {
            <div class="nx-grid-row-start @(RowGutter == NxGridRowGutter.Numbers ? "nx-grid-row-number" : "")"
                 @onmousedown="@OnCornerMouseDown">
                @if (RowGutter == NxGridRowGutter.Numbers) { <span>#</span> }
            </div>
        }

        @foreach (var column in visibleColumns)
        {
            <div class="nx-grid-cell @(column.IsLastFrozen ? "nx-grid-cell-frozen-last" : "")"
                 style="@column.HeaderCellStyle"
                 aria-label="@column.EffectiveTitle"
                 @onmousedown="@(args => OnColumnHeaderMouseDown(args, column))"
                 @onmousedown:preventDefault
                 @oncontextmenu="@(() => { if (HasColumnMenu) OnColumnButtonClick(column); })"
                 @oncontextmenu:preventDefault="@HasColumnMenu"
                 @onmouseenter="@(args => OnColumnHeaderMouseEnter(args, column))"
                 @onmouseleave="@(() => HideHeaderTooltip())">
                <div class="nx-grid-column-title-wrap">
                    <span class="nx-grid-column-title @(column.HeaderTemplate != null ? "nx-grid-column-title-template" : "")"
                              @onclick="@(async () => { if (HasColumnMenu) await OnColumnClick(column); })">
                        @if (column.HeaderTemplate != null)
                        {
                            @column.HeaderTemplate
                        }
                        else
                        {
                            @column.EffectiveTitle
                        }
                    </span>

                    @if (IsPrimarySort(column) && column.SortState == 1)
                    {
                        <span class="nx-grid-sort-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 512 512">
                                <path fill="currentColor" d="M412.6 49.7C407.2 38.8 396.1 32 384 32s-23.2 6.8-28.6 17.7c-50.7 101.3-77.3 154.7-80 160c-7.9 15.8-1.5 35 14.3 42.9s35 1.5 42.9-14.3l7.2-14.3h88.4l7.2 14.3c7.9 15.8 27.1 22.2 42.9 14.3s22.2-27.1 14.3-42.9c-2.7-5.3-29.3-58.7-80-160M384 135.6l20.2 40.4h-40.4zM288 320c0 17.7 14.3 32 32 32h50.7l-73.4 73.4c-9.2 9.2-11.9 22.9-6.9 34.9S307.1 480 320 480h128c17.7 0 32-14.3 32-32s-14.3-32-32-32h-50.7l73.4-73.4c9.2-9.2 11.9-22.9 6.9-34.9S460.9 288 448 288H320c-17.7 0-32 14.3-32 32M150.6 41.4c-12.5-12.5-32.8-12.5-45.3 0l-80 80c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L96 141.3V448c0 17.7 14.3 32 32 32s32-14.3 32-32V141.3l25.4 25.4c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3l-80-80z"/>
                            </svg>
                        </span>
                    }
                    else if (IsPrimarySort(column) && column.SortState == 2)
                    {
                        <span class="nx-grid-sort-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 512 512">
                                <path fill="currentColor" d="m230.6 390.6l-80 80c-12.5 12.5-32.8 12.5-45.3 0l-80-80c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L96 370.7V64c0-17.7 14.3-32 32-32s32 14.3 32 32v306.7l25.4-25.4c12.5-12.5 32.8-12.5 45.3 0s12.5 32.8 0 45.3zm182-340.9c50.7 101.3 77.3 154.7 80 160c7.9 15.8 1.5 35-14.3 42.9s-35 1.5-42.9-14.3l-7.2-14.3h-88.4l-7.2 14.3c-7.9 15.8-27.1 22.2-42.9 14.3s-22.2-27.1-14.3-42.9c2.7-5.3 29.3-58.7 80-160C360.8 38.9 371.9 32 384 32s23.2 6.8 28.6 17.7M384 135.6L363.8 176h40.4zM288 320c0-17.7 14.3-32 32-32h128c12.9 0 24.6 7.8 29.6 19.8s2.2 25.7-6.9 34.9L397.3 416H448c17.7 0 32 14.3 32 32s-14.3 32-32 32H320c-12.9 0-24.6-7.8-29.6-19.8s-2.2-25.7 6.9-34.9l73.4-73.4H320c-17.7 0-32-14.3-32-32z"/>
                            </svg>
                        </span>
                    }

                    @if (column.FilterState.Count > 0)
                    {
                        <span class="nx-grid-sort-icon">
                            @* https://icon-sets.iconify.design/tabler/filter-filled/ *@
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M20 3H4a1 1 0 0 0-1 1v2.227l.008.223a3 3 0 0 0 .772 1.795L8 12.886V21a1 1 0 0 0 1.316.949l6-2l.108-.043A1 1 0 0 0 16 19v-6.586l4.121-4.12A3 3 0 0 0 21 6.171V4a1 1 0 0 0-1-1"/>
                            </svg>
                        </span>
                    }
                </div>

                @if (HasColumnMenu)
                {
                    <button type="button" class="nx-grid-menu-button"
                            @onclick="@(() => OnColumnButtonClick(column))"
                            @onmousedown:stopPropagation>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                            <path fill="currentColor" d="m7 10l5 5l5-5z"/>
                        </svg>
                    </button>
                }

                <div class="nx-grid-resize-grip"
                     @onmousedown="@(args => OnResizeGripMouseDown(args, column))"
                     @onmousedown:stopPropagation
                     onmousedown:preventDefault
                     @ondblclick="@(() => OnResizeGripDoubleClick(column))"
                     @ondblclick:stopPropagation>
                </div>
            </div>
        }
    </div>
    }

    @if (IsLoading && LoadingTemplate != null && filteredData.Count == 0)
    {
        <div class="nx-grid-empty-state">@LoadingTemplate</div>
    }
    else if (!IsLoading && filteredData.Count == 0 && EmptyTemplate != null)
    {
        <div class="nx-grid-empty-state">@EmptyTemplate</div>
    }
    else if (!IsVirtualized)
    {
        @if (IsGrouped)
        {
            @foreach (var group in groups)
            {
                var grpValue = group.Value;
                var grpCollapsed = collapsedGroupValues.Contains(grpValue);
                <div @key="@($"grp:{grpValue}")"
                     class="nx-grid-group-header @(GroupsCollapsible ? "nx-grid-group-header-collapsible" : "")"
                     style="@rowStyle"
                     @onclick="@(() => ToggleGroup(grpValue))">
                    @if (GroupsCollapsible)
                    {
                        <span class="nx-grid-group-toggle">@(grpCollapsed ? "▶" : "▼")</span>
                    }
                    @if (GroupHeaderTemplate != null)
                    {
                        @GroupHeaderTemplate(new NxGridGroupHeaderArgs<T> { GroupValue = grpValue, Items = group.Items, IsCollapsed = grpCollapsed })
                    }
                    else
                    {
                        <span>@grpValue (@group.Count)</span>
                    }
                </div>
                @if (!grpCollapsed)
                {
                    @foreach (var rowIndex in Enumerable.Range(group.StartIndex, group.Count))
                    {
                        @RowTemplate(rowIndex)
                    }
                }
            }
        }
        else
        {
            @foreach (var context in rowIndices)
            {
                @RowTemplate(context)
            }
        }
    }
    else
    {
        <Virtualize Items="@rowIndices" ItemSize="@((float)RowHeight)" OverscanCount="12">
            @RowTemplate(context)
        </Virtualize>
    }

    @if (HasFooterRow)
    {
        <div class="nx-grid-footer-row" style="@headerRowStyle">
            @if (RowGutter != NxGridRowGutter.Hidden)
            {
                <div class="nx-grid-row-start"></div>
            }
            @foreach (var column in visibleColumns)
            {
                <div class="nx-grid-cell @(column.IsLastFrozen ? "nx-grid-cell-frozen-last" : "")"
                     style="@column.FooterCellStyle">
                    @if (column.FooterTemplate != null)
                    {
                        @column.FooterTemplate(filteredData)
                    }
                </div>
            }
        </div>
    }

    @if (EnableSelectionMath && selectedRanges.Count > 0)
    {
        var math = ComputeSelectionMath();
        <div class="nx-grid-status-bar">
            @if (math.NumericCount > 0)
            {
                <span class="nx-grid-status-item"><span class="nx-grid-status-label">Sum:</span> @math.Sum.ToString("N2")</span>
                <span class="nx-grid-status-item"><span class="nx-grid-status-label">Avg:</span> @math.Avg.ToString("N2")</span>
            }
            <span class="nx-grid-status-item"><span class="nx-grid-status-label">Count:</span> @math.Count</span>
        </div>
    }

    @if (openColumn != null)
    {
        <div class="nx-grid-menu-backdrop"></div>
        <div class="nx-grid-column-menu @(menuIsMobile ? "nx-grid-column-menu-mobile" : "")" style="top:@(menuTop)px;left:@(menuLeft)px;@(menuNeedsPositioning ? "visibility:hidden;" : "")">
            <button type="button" class="nx-grid-menu-item"
                    @onclick="@(() => ApplySortState(1))">
                <span class="nx-grid-menu-item-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 512 512">
                        <path fill="currentColor" d="M412.6 49.7C407.2 38.8 396.1 32 384 32s-23.2 6.8-28.6 17.7c-50.7 101.3-77.3 154.7-80 160c-7.9 15.8-1.5 35 14.3 42.9s35 1.5 42.9-14.3l7.2-14.3h88.4l7.2 14.3c7.9 15.8 27.1 22.2 42.9 14.3s22.2-27.1 14.3-42.9c-2.7-5.3-29.3-58.7-80-160M384 135.6l20.2 40.4h-40.4zM288 320c0 17.7 14.3 32 32 32h50.7l-73.4 73.4c-9.2 9.2-11.9 22.9-6.9 34.9S307.1 480 320 480h128c17.7 0 32-14.3 32-32s-14.3-32-32-32h-50.7l73.4-73.4c9.2-9.2 11.9-22.9 6.9-34.9S460.9 288 448 288H320c-17.7 0-32 14.3-32 32M150.6 41.4c-12.5-12.5-32.8-12.5-45.3 0l-80 80c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L96 141.3V448c0 17.7 14.3 32 32 32s32-14.3 32-32V141.3l25.4 25.4c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3l-80-80z"/>
                    </svg>
                </span>
                Sort Ascending
            </button>
            <button type="button" class="nx-grid-menu-item"
                    @onclick="@(() => ApplySortState(2))">
                <span class="nx-grid-menu-item-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 512 512">
                        <path fill="currentColor" d="m230.6 390.6l-80 80c-12.5 12.5-32.8 12.5-45.3 0l-80-80c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L96 370.7V64c0-17.7 14.3-32 32-32s32 14.3 32 32v306.7l25.4-25.4c12.5-12.5 32.8-12.5 45.3 0s12.5 32.8 0 45.3zm182-340.9c50.7 101.3 77.3 154.7 80 160c7.9 15.8 1.5 35-14.3 42.9s-35 1.5-42.9-14.3l-7.2-14.3h-88.4l-7.2 14.3c-7.9 15.8-27.1 22.2-42.9 14.3s-22.2-27.1-14.3-42.9c2.7-5.3 29.3-58.7 80-160C360.8 38.9 371.9 32 384 32s23.2 6.8 28.6 17.7M384 135.6L363.8 176h40.4zM288 320c0-17.7 14.3-32 32-32h128c12.9 0 24.6 7.8 29.6 19.8s2.2 25.7-6.9 34.9L397.3 416H448c17.7 0 32 14.3 32 32s-14.3 32-32 32H320c-12.9 0-24.6-7.8-29.6-19.8s-2.2-25.7 6.9-34.9l73.4-73.4H320c-17.7 0-32-14.3-32-32z"/>
                    </svg>
                </span>
                Sort Descending
            </button>
            <button type="button" class="nx-grid-menu-item"
                    @onclick="@(() => ApplySortState(0))">
                <span class="nx-grid-menu-item-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9l9-7l9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    </svg>
                </span>
                Clear Sort
            </button>
            @if (columns.Any(c => c.FilterState.Count > 0))
            {
                <button type="button" class="nx-grid-menu-item"
                        @onclick="@OnClearAllFiltersClick">
                    <span class="nx-grid-menu-item-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M20 3H4a1 1 0 0 0-1 1v2.227l.008.223a3 3 0 0 0 .772 1.795L8 12.886V21a1 1 0 0 0 1.316.949l6-2l.108-.043A1 1 0 0 0 16 19v-6.586l4.121-4.12A3 3 0 0 0 21 6.171V4a1 1 0 0 0-1-1"/>
                        </svg>
                    </span>
                    Clear All Filters
                </button>
            }

            @if (openColumn.Freezable || openColumn.Hideable || ActiveColumns.Any(c => c.Hideable && c.Visible) || ActiveColumns.Any(c => c.UserWidth != null))
            {
                <div class="nx-grid-menu-divider"></div>
                @if (openColumn.Freezable)
                {
                    <button type="button" class="nx-grid-menu-item" @onclick="@OnFreezeToggleClick">
                        <span class="nx-grid-menu-item-icon">
                            @if (openColumn.IsFrozen)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 576 512">
                                    <path fill="currentColor" d="M352 144c0-44.2 35.8-80 80-80s80 35.8 80 80v48c0 17.7 14.3 32 32 32s32-14.3 32-32V144C576 64.5 511.5 0 432 0S288 64.5 288 144v48H64c-35.3 0-64 28.7-64 64V448c0 35.3 28.7 64 64 64H384c35.3 0 64-28.7 64-64V256c0-35.3-28.7-64-64-64H352V144z"/>
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 448 512">
                                    <path fill="currentColor" d="M144 144v48H304V144c0-44.2-35.8-80-80-80s-80 35.8-80 80zM80 192V144C80 64.5 144.5 0 224 0s144 64.5 144 144v48h16c35.3 0 64 28.7 64 64V448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V256c0-35.3 28.7-64 64-64h16z"/>
                                </svg>
                            }
                        </span>
                        @(openColumn.IsFrozen ? "Unfreeze column" : "Freeze column")
                    </button>
                }
                @if (openColumn.Hideable)
                {
                    <button type="button" class="nx-grid-menu-item" @onclick="@OnHideColumnClick">
                        <span class="nx-grid-menu-item-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.88 9.88a3 3 0 1 0 4.243 4.243M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68m-6.72-1.07a3 3 0 0 1-4.194-4.194M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61M2 2l20 20"/>
                            </svg>
                        </span>
                        Hide column
                    </button>
                }
                @if (ActiveColumns.Any(c => c.Hideable && c.Visible))
                {
                    <button type="button" class="nx-grid-menu-item" @onclick="@OnManageColumnsClick">
                        <span class="nx-grid-menu-item-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>
                            </svg>
                        </span>
                        Manage columns...
                    </button>
                }
                @if (ActiveColumns.Any(c => c.UserWidth != null))
                {
                    <button type="button" class="nx-grid-menu-item" @onclick="@OnResetAllColumnWidthsClick">
                        <span class="nx-grid-menu-item-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3v5h5"/>
                            </svg>
                        </span>
                        Reset all column widths
                    </button>
                }
            }

            <div class="nx-grid-menu-divider"></div>
            <NxGridFilter T="@T"
                              Data="@Data"
                              Columns="@visibleColumns"
                              Column="@openColumn"
                              OnFilter="@OnFilterOk"
                              OnCancel="@OnFilterCancel"/>
        </div>
    }

    @if (showContextMenu)
    {
        var headerItems        = contextMenuItems.Where(i => i.Section == NxGridMenuSection.Header).ToList();
        var beforeFocusItems   = contextMenuItems.Where(i => i.Section == NxGridMenuSection.BeforeFocusCell).ToList();
        var footerItems        = contextMenuItems.Where(i => i.Section == NxGridMenuSection.Footer).ToList();
        var hasFocusCell       = AllowFocusCellMode && SelectionMode == NxGridSelectionMode.Cell;

        <div class="nx-grid-context-menu" style="position:fixed;left:@(contextMenuX)px;top:@(contextMenuY)px;z-index:1000;">
            @for (var i = 0; i < headerItems.Count; i++)
            {
                var capturedItem = headerItems[i];
                @if (capturedItem.Separator && i > 0)
                {
                    <div class="nx-grid-menu-divider"></div>
                }
                <button type="button" class="nx-grid-context-item @(capturedItem.Disabled ? "nx-grid-context-item-disabled" : "")"
                        disabled="@capturedItem.Disabled"
                        @onclick="@(() => OnCustomContextMenuItemClick(capturedItem))">
                    <span>@capturedItem.Label</span>
                    @if (capturedItem.Shortcut != null)
                    {
                        <span class="nx-grid-context-shortcut">@capturedItem.Shortcut</span>
                    }
                </button>
            }
            @if (headerItems.Count > 0)
            {
                <div class="nx-grid-menu-divider"></div>
            }
            <button type="button" class="nx-grid-context-item"
                    @onclick="@OnContextMenuCopyClick">
                <span>Copy</span><span class="nx-grid-context-shortcut">Ctrl+C</span>
            </button>
            <button type="button" class="nx-grid-context-item"
                    @onclick="@OnContextMenuCopyWithHeadersClick">
                Copy with headers
            </button>
            @if (contextMenuCellEditable)
            {
                <button type="button" class="nx-grid-context-item"
                        @onclick="@OnContextMenuPasteClick">
                    Paste
                </button>
            }
            @for (var i = 0; i < beforeFocusItems.Count; i++)
            {
                var capturedItem = beforeFocusItems[i];
                @if (capturedItem.Separator && i > 0)
                {
                    <div class="nx-grid-menu-divider"></div>
                }
                <button type="button" class="nx-grid-context-item @(capturedItem.Disabled ? "nx-grid-context-item-disabled" : "")"
                        disabled="@capturedItem.Disabled"
                        @onclick="@(() => OnCustomContextMenuItemClick(capturedItem))">
                    <span>@capturedItem.Label</span>
                    @if (capturedItem.Shortcut != null)
                    {
                        <span class="nx-grid-context-shortcut">@capturedItem.Shortcut</span>
                    }
                </button>
            }
            @if (hasFocusCell)
            {
                <div class="nx-grid-menu-divider"></div>
                <button type="button" class="nx-grid-context-item"
                        @onclick="@OnFocusCellToggle">
                    <input type="checkbox" checked="@focusCellEnabled" style="pointer-events:none;margin-right:6px;" tabindex="-1" />
                    Focus Cell
                </button>
            }
            @if (footerItems.Count > 0)
            {
                <div class="nx-grid-menu-divider"></div>
            }
            @for (var i = 0; i < footerItems.Count; i++)
            {
                var capturedItem = footerItems[i];
                @if (capturedItem.Separator && i > 0)
                {
                    <div class="nx-grid-menu-divider"></div>
                }
                <button type="button" class="nx-grid-context-item @(capturedItem.Disabled ? "nx-grid-context-item-disabled" : "")"
                        disabled="@capturedItem.Disabled"
                        @onclick="@(() => OnCustomContextMenuItemClick(capturedItem))">
                    <span>@capturedItem.Label</span>
                    @if (capturedItem.Shortcut != null)
                    {
                        <span class="nx-grid-context-shortcut">@capturedItem.Shortcut</span>
                    }
                </button>
            }
        </div>
    }

    @if (isEditing && editCol >= 0 && editCol < visibleColumns.Count
         && visibleColumns[editCol].IsComboColumn && isComboOpen)
    {
        var comboCol = visibleColumns[editCol];
        <div class="nx-grid-combo-dropdown"
             style="position:fixed;top:@(comboDropdownTop)px;left:@(comboDropdownLeft)px;width:@(comboDropdownWidth)px;z-index:1001;">
            @if (comboFilteredOptions.Count == 0)
            {
                <div class="nx-grid-combo-no-options">No matches</div>
            }
            else
            {
                @for (var i = 0; i < comboFilteredOptions.Count; i++)
                {
                    var optIdx = i;
                    var item = comboFilteredOptions[i];
                    <div class="nx-grid-combo-item @(i == comboHighlightIndex ? "nx-grid-combo-item-active" : "")"
                         @onmousedown="@(() => OnComboItemMouseDown(optIdx))"
                         @onmousedown:preventDefault>
                        @if (comboCol.ComboBoxItemTemplate != null)
                        {
                            @comboCol.ComboBoxItemTemplate(item)
                        }
                        else
                        {
                            @item.Text
                        }
                    </div>
                }
            }
        </div>
    }

    @if (isEditing && editCol >= 0 && editCol < visibleColumns.Count
         && visibleColumns[editCol].IsDatePickerColumn && isDatePickerOpen)
    {
        <div class="nx-grid-datepicker-popup"
             style="position:fixed;top:@(datePickerTop)px;left:@(datePickerLeft)px;z-index:1001;@(datePickerNeedsPositioning ? "visibility:hidden;" : "")"
             @onmousedown:stopPropagation>
            <div class="nx-grid-datepicker-header">
                <button type="button" class="nx-grid-datepicker-nav"
                        @onmousedown="DatePickerPrevMonth"
                        @onmousedown:stopPropagation
                        @onmousedown:preventDefault>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z"/></svg>
                </button>
                <span class="nx-grid-datepicker-title">@datePickerViewDate.ToString("MMMM yyyy")</span>
                <button type="button" class="nx-grid-datepicker-nav"
                        @onmousedown="DatePickerNextMonth"
                        @onmousedown:stopPropagation
                        @onmousedown:preventDefault>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
                </button>
            </div>
            <div class="nx-grid-datepicker-grid">
                <div class="nx-grid-datepicker-dow">Su</div>
                <div class="nx-grid-datepicker-dow">Mo</div>
                <div class="nx-grid-datepicker-dow">Tu</div>
                <div class="nx-grid-datepicker-dow">We</div>
                <div class="nx-grid-datepicker-dow">Th</div>
                <div class="nx-grid-datepicker-dow">Fr</div>
                <div class="nx-grid-datepicker-dow">Sa</div>
                @{ var calDays = GetCalendarDays(); }
                @for (var di = 0; di < calDays.Count; di++)
                {
                    var day = calDays[di];
                    var dayCls = "nx-grid-datepicker-day"
                        + (!day.IsCurrentMonth ? " nx-grid-datepicker-day-other" : "")
                        + (day.IsSelected ? " nx-grid-datepicker-day-selected" : day.IsHighlighted ? " nx-grid-datepicker-day-highlight" : day.IsToday ? " nx-grid-datepicker-day-today" : "");
                    <div class="@dayCls"
                         @onmousedown="@(() => OnDatePickerDayMouseDown(day.Date))"
                         @onmousedown:stopPropagation
                         @onmousedown:preventDefault>
                        @day.Date.Day
                    </div>
                }
            </div>
        </div>
    }

    @if (isEditing && editCol >= 0 && editCol < visibleColumns.Count
         && visibleColumns[editCol].IsColorPickerColumn && isColorPickerOpen)
    {
        <div class="nx-grid-colorpicker-popup"
             style="position:fixed;top:@(colorPickerTop)px;left:@(colorPickerLeft)px;z-index:1001;@(colorPickerNeedsPositioning ? "visibility:hidden;" : "")"
             @onmousedown:stopPropagation>
            <div class="nx-grid-colorpicker-tabs">
                <button type="button" class="nx-grid-colorpicker-tab @(!colorPickerCustomView ? "nx-grid-colorpicker-tab-active" : "")"
                        @onmousedown="@(() => { colorPickerCustomView = false; StateHasChanged(); })"
                        @onmousedown:stopPropagation @onmousedown:preventDefault>Palette</button>
                <button type="button" class="nx-grid-colorpicker-tab @(colorPickerCustomView ? "nx-grid-colorpicker-tab-active" : "")"
                        @onmousedown="@(() => { colorPickerCustomView = true; colorPickerNeedsGradientSetup = true; StateHasChanged(); })"
                        @onmousedown:stopPropagation @onmousedown:preventDefault>Custom</button>
            </div>
            @{ var (cpR, cpG, cpB) = HsvToRgb(colorPickerH, colorPickerS, colorPickerV); var cpHex = RgbToHex(cpR, cpG, cpB); }
            @if (!colorPickerCustomView)
            {
                <div class="nx-grid-colorpicker-palette">
                    @foreach (var paletteColor in ColorPickerPalette)
                    {
                        var capturedColor = paletteColor;
                        <button type="button" class="nx-grid-colorpicker-swatch"
                                style="background-color:@capturedColor"
                                title="@capturedColor"
                                @onmousedown="@(() => OnColorPickerPaletteClick(capturedColor))"
                                @onmousedown:stopPropagation @onmousedown:preventDefault>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="nx-grid-colorpicker-custom">
                    <div class="nx-grid-colorpicker-gradient"
                         style="background:linear-gradient(to bottom,transparent,#000),linear-gradient(to right,#fff,hsl(@(colorPickerH),100%,50%))">
                        <div class="nx-grid-colorpicker-gradient-thumb"
                             style="left:@(colorPickerS)%;top:@(100 - colorPickerV)%">
                        </div>
                    </div>
                    <div class="nx-grid-colorpicker-hue-track">
                        <input type="range" class="nx-grid-colorpicker-hue-input"
                               min="0" max="360" value="@colorPickerH"
                               @oninput="OnColorPickerHueInput"
                               @oninput:stopPropagation
                               @onmousedown:stopPropagation
                               @onmouseup:stopPropagation
                               @onkeydown:stopPropagation />
                    </div>
                    <div class="nx-grid-colorpicker-inputs">
                        <div class="nx-grid-colorpicker-preview" style="background-color:@cpHex"></div>
                        <div class="nx-grid-colorpicker-inputs-group">
                            <label class="nx-grid-colorpicker-input-label">
                                Hex
                                <input class="nx-grid-colorpicker-text-input"
                                       value="@cpHex"
                                       @onchange="OnColorPickerHexInput"
                                       @onmousedown:stopPropagation @onmouseup:stopPropagation @onkeydown:stopPropagation />
                            </label>
                            <div class="nx-grid-colorpicker-rgb-row">
                                <label class="nx-grid-colorpicker-input-label">
                                    R<input class="nx-grid-colorpicker-rgb-input" type="number" min="0" max="255" value="@cpR"
                                            @onchange="@((e) => OnColorPickerRgbInput(e, 'r', cpG, cpB))"
                                            @onmousedown:stopPropagation @onmouseup:stopPropagation @onkeydown:stopPropagation />
                                </label>
                                <label class="nx-grid-colorpicker-input-label">
                                    G<input class="nx-grid-colorpicker-rgb-input" type="number" min="0" max="255" value="@cpG"
                                            @onchange="@((e) => OnColorPickerRgbInput(e, 'g', cpR, cpB))"
                                            @onmousedown:stopPropagation @onmouseup:stopPropagation @onkeydown:stopPropagation />
                                </label>
                                <label class="nx-grid-colorpicker-input-label">
                                    B<input class="nx-grid-colorpicker-rgb-input" type="number" min="0" max="255" value="@cpB"
                                            @onchange="@((e) => OnColorPickerRgbInput(e, 'b', cpR, cpG))"
                                            @onmousedown:stopPropagation @onmouseup:stopPropagation @onkeydown:stopPropagation />
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (ShowFillHandle)
    {
        <div class="nx-grid-fill-handle"
             style="top:@(fillHandleTop)px;left:@(fillHandleLeft)px;@(fillHandleNeedsPositioning || !fillHandleVisible ? "visibility:hidden;" : "")"
             @onmousedown="OnFillHandleMouseDown"
             @onmousedown:preventDefault
             @onmousedown:stopPropagation>
        </div>
    }

    @if (Overlays != null)
    {
        <div style="position:absolute; top:0; left:0; right:0; bottom:0; z-index:1; pointer-events:none;">
            @Overlays
        </div>
    }

    @if (IsLoading && LoadingTemplate != null && filteredData.Count > 0)
    {
        <div class="nx-grid-loading-overlay">@LoadingTemplate</div>
    }

    @if (showColumnChooser)
    {
        <div style="position:fixed;inset:0;z-index:999;" @onclick="CloseColumnChooser"></div>
        <div class="nx-grid-chooser-panel" style="top:@(chooserTop)px;left:@(chooserLeft)px;" @onclick:stopPropagation>
            <div class="nx-grid-chooser-title">Columns</div>
            @foreach (var col in ActiveColumns.Where(c => c.Hideable && c.Visible))
            {
                var capturedCol = col;
                <label class="nx-grid-chooser-item">
                    <input type="checkbox"
                           checked="@(!capturedCol.IsHidden)"
                           @onchange="@(e => OnChooserToggle(capturedCol, (bool)(e.Value ?? false)))" />
                    @capturedCol.EffectiveTitle
                </label>
            }
        </div>
    }

    @if (tooltipVisible && tooltipColumn != null)
    {
        <div class="nx-grid-tooltip" style="position:fixed;top:@(tooltipTop)px;left:@(tooltipLeft)px;z-index:1002;pointer-events:none;">
            @if (tooltipIsHeader)
            {
                @if (tooltipColumn.HeaderTooltipTemplate != null)
                {
                    @tooltipColumn.HeaderTooltipTemplate
                }
                else
                {
                    @tooltipColumn.HeaderTooltip
                }
            }
            else if (TooltipTemplate != null && tooltipRow != null)
            {
                @TooltipTemplate(new NxGridTooltipContext<T> { Row = tooltipRow, Column = tooltipColumn, Data = tooltipData })
            }
            else
            {
                @tooltipData?.ToString()
            }
        </div>
    }

    @if (printDialogOpen)
    {
        <div class="nx-print-dialog-backdrop" @onclick="ClosePrintDialog">
            <div class="nx-print-dialog" @onclick:stopPropagation>
                <div class="nx-print-dialog-header">
                    <span class="nx-print-dialog-title">Print</span>
                    <button type="button" class="nx-print-dialog-close" @onclick="ClosePrintDialog">✕</button>
                </div>
                <div class="nx-print-dialog-body">
                    <div class="nx-print-dialog-options">
                        <label class="nx-print-option">
                            <input type="radio" name="@($"nx-print-scope-{id}")"
                                   checked="@printAll"
                                   @onchange="@(() => printAll = true)" />
                            <span>Print everything — @filteredData.Count @(filteredData.Count == 1 ? "row" : "rows"), @visibleColumns.Count @(visibleColumns.Count == 1 ? "column" : "columns")</span>
                        </label>
                        <label class="nx-print-option @(ActiveRange == null ? "nx-print-option-disabled" : "")">
                            <input type="radio" name="@($"nx-print-scope-{id}")"
                                   disabled="@(ActiveRange == null)"
                                   checked="@(!printAll)"
                                   @onchange="@(() => printAll = false)" />
                            <span>Print selection — @PrintSelectionRowCount @(PrintSelectionRowCount == 1 ? "row" : "rows"), @PrintSelectionColCount @(PrintSelectionColCount == 1 ? "column" : "columns")</span>
                        </label>
                    </div>
                    <div class="nx-print-preview-wrap">
                        <table class="nx-print-table">
                            <thead>
                                <tr>
                                    @foreach (var col in GetPrintColumns())
                                    {
                                        <th>@col.EffectiveTitle</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in GetPrintRows())
                                {
                                    <tr>
                                        @foreach (var col in GetPrintColumns())
                                        {
                                            <td style="@(CellStyle != null ? BuildCellStyleCss(CellStyle(row, col)) : null)">@PrintCellValue(col, row)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="nx-print-dialog-footer">
                    <button type="button" class="nx-print-btn-print" @onclick="ExecutePrint">Print</button>
                    <button type="button" class="nx-print-btn-cancel" @onclick="ClosePrintDialog">Cancel</button>
                </div>
            </div>
        </div>

        <div id="@($"{id}-print")" class="nx-print-area" aria-hidden="true">
            @if (!string.IsNullOrWhiteSpace(printTitle))
            {
                <h1 class="nx-print-title">@printTitle</h1>
            }
            <p class="nx-print-date">@DateTime.Now.ToShortDateString()</p>
            <table class="nx-print-table">
                <thead>
                    <tr>
                        @foreach (var col in GetPrintColumns())
                        {
                            <th>@col.EffectiveTitle</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in GetPrintRows())
                    {
                        <tr>
                            @foreach (var col in GetPrintColumns())
                            {
                                <td style="@(CellStyle != null ? BuildCellStyleCss(CellStyle(row, col)) : null)">@PrintCellValue(col, row)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private RenderFragment<int> RowTemplate => rowIndex => @<NxGridRow T="T"
        @key="rowIndex"
        Row="@filteredData[rowIndex]"
        RowIndex="@rowIndex"
        Columns="@visibleColumns"
        RowStyle="@rowStyle"
        SelectedRange="@ActiveRange"
        AdditionalRanges="@selectedRanges"
        PickRange="@GetCurrentPickRange()"
        RowGutter="@EffectiveRowGutter"
        IsEditing="@isEditing"
        EditRow="@editRow"
        EditCol="@editCol"
        EditValue="@editValue"
        CellStyleFunc="@GetCellStyle"
        OnMouseDown="@OnCellMouseDown"
        OnMouseEnter="@OnCellMouseEnter"
        OnMouseUp="@OnCellMouseUp"
        OnMouseLeave="@OnCellMouseLeaveForTooltip"
        OnContextMenu="@OnCellContextMenu"
        OnDoubleClick="@OnCellDoubleClick"
        OnEditInput="@OnEditInputChange"
        OnEditKeyDown="@OnEditInputKeyDown"
        OnRowNumberMouseDown="@(HeaderClickSelects ? OnRowNumberMouseDown : null)"
        OnRowNumberMouseEnter="@(HeaderClickSelects ? OnRowNumberMouseEnter : null)"
        OnDragHandleMouseDown="@OnDragHandleMouseDown"
        OnComboButtonClick="@OnComboButtonClick"
        OnDatePickerButtonClick="@OnDatePickerButtonClick"
        OnColorPickerButtonClick="@OnColorPickerButtonClick"
        OnCheckboxToggle="@OnCheckboxToggleCell"
        Cursor="@Cursor"
        RenderToken="@renderToken"
        GridEditable="@Editable"
        CellEditableGetter="@CellEditableGetter"
        SelectionMode="@SelectionMode"
        FocusCellEnabled="@(focusCellEnabled && AllowFocusCellMode && SelectionMode == NxGridSelectionMode.Cell)"
        FocusCellAnchorRow="@(ActiveRange?.StartRow ?? -1)"
        FocusCellAnchorCol="@(ActiveRange?.StartCol ?? -1)" />;
}

