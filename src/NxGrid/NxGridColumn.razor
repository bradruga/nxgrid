@typeparam T
@using System.Linq.Expressions
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@implements IDisposable

@code {
    // ── Cascading Parameters ──────────────────────────────────────────────────

    [CascadingParameter] public NxGrid<T>? Parent { get; set; }

    // ── Identity ──────────────────────────────────────────────────────────────

    /// <summary>
    /// Stable identity used for state persistence via <see cref="NxGrid{T}.StateKey"/>.
    /// Falls back to <see cref="Title"/> when not set. Columns with neither <c>Id</c>
    /// nor <c>Title</c> are excluded from persistence.
    /// </summary>
    [Parameter] public string? Id { get; set; }

    // ── Data binding ──────────────────────────────────────────────────────────

    /// <summary>
    /// Member expression that binds the column to a property of <typeparamref name="T"/>
    /// (e.g. <c>x =&gt; x.Age</c>). Used for display, sort/filter, and as the write target
    /// for <see cref="NxGridCellChange{T}.Apply"/>. Get-only and computed expressions are fully
    /// supported for display, sort, and filter — they simply make the column non-editable.
    /// </summary>
    [Parameter] public Expression<Func<T, object?>>? Property { get; set; }

    /// <summary>
    /// Display value override. Takes priority over <see cref="Property"/> for cell rendering.
    /// Use when you need formatted output (e.g. <c>x =&gt; x.Age + " yrs"</c>).
    /// <see cref="Property"/> is still used for sort/filter when <c>Display</c> is set.
    /// Clipboard copy falls back to this when <see cref="CopyGetter"/> is not set.
    /// </summary>
    [Parameter] public Func<T, object?>? Display { get; set; }

    /// <summary>
    /// Override for the value placed on the clipboard during copy. Takes priority over
    /// <see cref="Display"/> and <see cref="Property"/> for copy only. Use when the rendered
    /// display value differs from what should be pasted (e.g. copy a raw formula while
    /// displaying the evaluated result).
    /// </summary>
    [Parameter] public Func<T, object?>? CopyGetter { get; set; }

    /// <summary>
    /// Makes this column editable. When not set, falls back to the grid-level
    /// <see cref="NxGrid{T}.Editable"/>. Requires <see cref="NxGrid{T}.OnUpdate"/> on the grid.
    /// </summary>
    [Parameter] public bool? Editable { get; set; }

    // ── Display ───────────────────────────────────────────────────────────────

    /// <summary>
    /// Column header text. When omitted, falls back to a <c>[Display(Name = "...")]</c>
    /// attribute on the property, then to the property name split on PascalCase word
    /// boundaries (e.g. <c>FirstName</c> → <c>"First Name"</c>). Explicit <c>Title</c> always wins.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Declared column width in pixels. When set, it is used as the exact width for
    /// <see cref="NxGridColumnSizing.Fixed"/> columns (disabling auto-measurement under
    /// <see cref="NxGridFitContent.Auto"/>), or as the flex-basis / initial placeholder for
    /// <see cref="NxGridColumnSizing.Flex"/> columns. When <c>null</c> (default), the column
    /// auto-measures its content width unless <see cref="FitContent"/> is
    /// <see cref="NxGridFitContent.Never"/>. Not a minimum — without <see cref="MinWidth"/>
    /// the column can be dragged narrower.
    /// </summary>
    [Parameter] public int? Width { get; set; }

    /// <summary>
    /// Hard minimum width in pixels. Enforced both in auto-size mode (CSS <c>min-width</c>)
    /// and during user drag. Remains active even after <see cref="UserWidth"/> is set.
    /// </summary>
    [Parameter] public int? MinWidth { get; set; }

    /// <summary>
    /// Hard maximum width in pixels. Enforced both in auto-size mode (CSS <c>max-width</c>)
    /// and during user drag. When <c>null</c>, the column uses <c>flex-grow: {Width}</c>
    /// in auto mode so extra space is distributed proportionally to declared widths.
    /// Remains active even after <see cref="UserWidth"/> is set.
    /// </summary>
    [Parameter] public int? MaxWidth { get; set; }

    /// <summary>Horizontal text alignment. Default: <see cref="NxGridColumnAlignment.Left"/>.</summary>
    [Parameter] public NxGridColumnAlignment Alignment { get; set; }

    /// <summary>
    /// Pins this column to the left of the scroll area using <c>position: sticky</c>.
    /// Multiple frozen columns stack left-to-right in declaration order, always before
    /// unfrozen columns. Freezing a column at runtime via the column menu clears the active selection.
    /// Default: <c>false</c>.
    /// </summary>
    [Parameter] public bool Frozen { get; set; }

    /// <summary>
    /// When <c>true</c>, the column menu shows a "Freeze / Unfreeze" toggle.
    /// Set to <c>false</c> to prevent the user from changing the frozen state.
    /// The user-toggled state is included in <see cref="NxGrid{T}.StateKey"/> persistence.
    /// Default: <c>true</c>.
    /// </summary>
    [Parameter] public bool Freezable { get; set; } = true;

    /// <summary>
    /// Excludes the column from rendering. A hidden column still participates in sort and filter
    /// if it has a <see cref="Property"/> or <see cref="Display"/>, but it is never rendered
    /// and cannot be selected. Useful for including a field in sort/filter without showing it.
    /// Default: <c>false</c>.
    /// </summary>
    [Parameter] public bool Hidden { get; set; }

    /// <summary>
    /// When <c>true</c>, the column menu shows a "Hide column" entry and a "Manage columns…"
    /// entry appears (when at least one column is hideable). Set to <c>false</c> to prevent
    /// the user from hiding this column. The user-toggled state is included in
    /// <see cref="NxGrid{T}.StateKey"/> persistence. Default: <c>true</c>.
    /// </summary>
    [Parameter] public bool Hideable { get; set; } = true;

    /// <summary>
    /// Controls whether this column is rendered at all. When <c>false</c>, the column is excluded
    /// from the grid and from the column chooser; the user cannot show it. Unlike <see cref="Hidden"/>,
    /// this is not user-controlled and is never persisted. Use for authorization-based column
    /// visibility. Default: <c>true</c>.
    /// </summary>
    [Parameter] public bool Visible { get; set; } = true;

    /// <summary>
    /// When <c>true</c>, double-clicking the column's resize grip auto-sizes the column to fit
    /// its widest content across the current filtered dataset. Obeys <see cref="MinWidth"/> and
    /// <see cref="MaxWidth"/>. Set to <c>false</c> to disable double-click auto-size for this
    /// column without affecting drag resize. Default: <c>true</c>.
    /// </summary>
    [Parameter] public bool AutoSizable { get; set; } = true;

    /// <summary>
    /// Controls whether the column automatically measures its widest data value to determine its width.
    /// <see cref="NxGridFitContent.Auto"/> (default) infers the behavior: measurement is skipped when
    /// <see cref="Sizing"/> is <see cref="NxGridColumnSizing.Fixed"/> and <see cref="Width"/> is set
    /// (the declared width is the final answer); measurement runs in all other cases.
    /// <see cref="NxGridFitContent.Always"/> forces measurement regardless of other parameters.
    /// <see cref="NxGridFitContent.Never"/> disables measurement; the column renders at its declared
    /// <see cref="Width"/> (or 100 px when unset). <see cref="FlexMinWidth"/> and
    /// <see cref="FlexMaxWidth"/> bound the measurement result. Columns the user has manually resized
    /// are not re-measured. Default: <see cref="NxGridFitContent.Auto"/>.
    /// </summary>
    [Parameter] public NxGridFitContent FitContent { get; set; } = NxGridFitContent.Auto;

    /// <summary>
    /// Resolved fit-content flag after applying <see cref="NxGridFitContent.Auto"/> inference.
    /// <c>false</c> when <see cref="FitContent"/> is <see cref="NxGridFitContent.Never"/>, or when
    /// <see cref="FitContent"/> is <see cref="NxGridFitContent.Auto"/> and
    /// <see cref="Sizing"/> is <see cref="NxGridColumnSizing.Fixed"/> with <see cref="Width"/> set.
    /// <c>true</c> otherwise.
    /// </summary>
    internal bool EffectiveFitContent => FitContent switch
    {
        NxGridFitContent.Always => true,
        NxGridFitContent.Never  => false,
        _                       => !(Sizing == NxGridColumnSizing.Fixed && Width.HasValue)
    };

    /// <summary>
    /// Controls how the column participates in flexible width distribution.
    /// <see cref="NxGridColumnSizing.Flex"/> (default) uses <see cref="Width"/> as the
    /// flex-basis and proportional grow/shrink weight. Use <see cref="FlexMinWidth"/> and
    /// <see cref="FlexMaxWidth"/> to bound how far the column can shrink or grow automatically.
    /// <see cref="NxGridColumnSizing.Fixed"/> pins the column at its exact pixel width with no
    /// flex participation. Default: <see cref="NxGridColumnSizing.Flex"/>.
    /// </summary>
    [Parameter] public NxGridColumnSizing Sizing { get; set; } = NxGridColumnSizing.Flex;

    /// <summary>
    /// Minimum width in pixels the column may shrink to during automatic flex distribution.
    /// Only applies when <see cref="Sizing"/> is <see cref="NxGridColumnSizing.Flex"/> and
    /// the column has not been manually resized by the user.
    /// Independent of <see cref="MinWidth"/>, which enforces the floor during user drag-resize.
    /// When both are set the larger value is the effective CSS <c>min-width</c> in flex mode.
    /// </summary>
    [Parameter] public int? FlexMinWidth { get; set; }

    /// <summary>
    /// Maximum width in pixels the column may grow to during automatic flex distribution.
    /// Only applies when <see cref="Sizing"/> is <see cref="NxGridColumnSizing.Flex"/> and
    /// the column has not been manually resized by the user.
    /// Independent of <see cref="MaxWidth"/>, which enforces the ceiling during user drag-resize.
    /// When both are set the smaller value is the effective CSS <c>max-width</c> in flex mode.
    /// Also clamps the width computed when <see cref="FitContent"/> is <c>true</c>.
    /// </summary>
    [Parameter] public int? FlexMaxWidth { get; set; }

    /// <summary>
    /// Custom cell renderer. The cell container (padding, selection highlight) is still rendered
    /// by the grid; the template fills the inner content. When both <c>Template</c> and
    /// <see cref="CheckBox"/> are set, <c>Template</c> takes priority.
    /// </summary>
    [Parameter] public RenderFragment<T>? Template { get; set; }

    /// <summary>
    /// Custom markup rendered inside the column header cell instead of <see cref="Title"/>.
    /// Sort/filter icons and the menu button still appear. Interactive elements inside the
    /// template should include <c>@onmousedown:stopPropagation</c> and
    /// <c>@onclick:stopPropagation</c> to prevent unintended selection/menu interactions.
    /// </summary>
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }

    /// <summary>Static tooltip text shown immediately on hovering the column header.</summary>
    [Parameter] public string? HeaderTooltip { get; set; }

    /// <summary>
    /// Custom tooltip markup for the column header. Takes priority over <see cref="HeaderTooltip"/>.
    /// </summary>
    [Parameter] public RenderFragment? HeaderTooltipTemplate { get; set; }

    /// <summary>
    /// Custom markup rendered in the footer cell for this column. The template receives the
    /// current filtered dataset as <c>IReadOnlyList&lt;T&gt;</c>. A footer row is rendered when
    /// at least one visible column has a <c>FooterTemplate</c>; columns without one show an empty
    /// cell. The footer row is sticky at the bottom of the grid scroll area.
    /// </summary>
    [Parameter] public RenderFragment<IReadOnlyList<T>>? FooterTemplate { get; set; }

    // ── Editing ───────────────────────────────────────────────────────────────

    /// <summary>
    /// When <c>true</c>, pressing Delete clears the cell to <c>null</c> rather than
    /// <c>0</c> / <c>""</c>. Default: <c>false</c>.
    /// </summary>
    [Parameter] public bool Nullable { get; set; }

    /// <summary>
    /// When <c>true</c> and the column is editable, the raw input string is evaluated as an
    /// arithmetic expression (<c>+</c>, <c>-</c>, <c>*</c>, <c>/</c>, parentheses, unary
    /// negation, decimal literals) before being passed to <see cref="NxGrid{T}.OnUpdate"/>.
    /// If evaluation fails, the raw string is passed unchanged. Applies to typed commits,
    /// Ctrl+Enter fill, and paste (after <see cref="NxGrid{T}.TransformPastedValue"/> runs).
    /// </summary>
    [Parameter] public bool MathExpression { get; set; }

    /// <summary>
    /// When <c>true</c>, cells render with <c>white-space: pre-wrap</c> and the inline editor
    /// is a <c>&lt;textarea&gt;</c> that grows with content. Shift+Enter inserts a newline;
    /// Enter commits. When any visible column has <c>MultiLine = true</c>, row virtualization
    /// is disabled for the entire grid and all editable columns use a textarea editor.
    /// Silently ignored when <see cref="ComboBoxSource"/> is also set.
    /// </summary>
    [Parameter] public bool MultiLine { get; set; }

    /// <summary>
    /// Renders every body cell as a checkbox. <see cref="Property"/> must resolve to
    /// <c>bool</c> or <c>bool?</c>. Clicking or pressing Space toggles the value immediately
    /// and fires <see cref="NxGrid{T}.OnUpdate"/> — no F2 or double-click required.
    /// When the column is not editable, the checkbox is rendered as read-only. Delete has no
    /// effect on <c>bool</c> columns; for <c>bool?</c> it clears to <c>null</c>.
    /// Default: <c>false</c>.
    /// </summary>
    [Parameter] public bool CheckBox { get; set; }

    /// <summary>
    /// Turns the inline editor into a combo-box dropdown.
    /// Use <see cref="NxGridComboSource"/>.<c>FixedList</c> for a list that is the same for every row —
    /// the selected item's <see cref="NxGridComboItem.Id"/> is committed via <see cref="Property"/>
    /// and the <see cref="NxGridComboItem.Text"/> is automatically shown in the non-editing cell
    /// without a separate <c>Display</c> parameter.
    /// Use <see cref="NxGridComboSource"/>.<c>VariableList</c> when the list depends on the row;
    /// the source is called fresh each time the dropdown opens.
    /// </summary>
    /// <example>
    /// <code>ComboBoxSource="@(NxGridComboSource.FixedList(statuses, s => s.Code, s => s.Label))"</code>
    /// </example>
    [Parameter] public NxGridComboSource? ComboBoxSource { get; set; }

    /// <summary>
    /// Custom markup for each combo-box dropdown item. When set, replaces the plain
    /// <see cref="NxGridComboItem.Text"/> string in the dropdown list.
    /// </summary>
    [Parameter] public RenderFragment<NxGridComboItem>? ComboBoxItemTemplate { get; set; }

    /// <summary>
    /// When <c>true</c> and the column is editable, the inline editor renders a free-text
    /// input alongside a calendar button that opens a month-view date picker popup.
    /// <see cref="Property"/> should resolve to <c>DateTime</c> or <c>DateTime?</c>.
    /// Default: <c>false</c>.
    /// </summary>
    [Parameter] public bool DatePicker { get; set; }

    /// <summary>
    /// Format string used both to display the date in the non-editing cell and to pre-populate
    /// the editor on F2 / double-click (e.g. <c>"MM/dd/yyyy"</c>). Also used as the first
    /// parse format on commit before falling back to <c>DateTime.TryParse</c>. Defaults to the
    /// thread's current culture short-date pattern when not set.
    /// </summary>
    [Parameter] public string? DateFormat { get; set; }

    /// <summary>
    /// When <c>true</c> and the column is editable, the inline editor renders a free-text input
    /// alongside a color swatch button that opens a color picker popup with palette and custom
    /// views. The <see cref="Property"/> should resolve to a <c>string</c> containing a CSS color
    /// value (e.g. <c>"#FF5733"</c>, <c>"rgb(255,87,51)"</c>, or <c>"tomato"</c>).
    /// Default: <c>false</c>.
    /// </summary>
    [Parameter] public bool ColorPicker { get; set; }

    /// <summary>
    /// Controls how the selected color is written to the property on commit.
    /// Accepted values: <c>"hex"</c> (default, e.g. <c>"#FF5733"</c>),
    /// <c>"rgb"</c> (e.g. <c>"rgb(255, 87, 51)"</c>), or
    /// <c>"name"</c> (CSS named color when one matches, otherwise hex).
    /// </summary>
    [Parameter] public string? ColorFormat { get; set; }

    // ── Runtime state ─────────────────────────────────────────────────────────

    /// <summary>Pre-computed CSS for the header cell (width, sticky offset). Rebuilt on each parameter set.</summary>
    public string HeaderCellStyle { get; private set; } = "";

    /// <summary>Pre-computed CSS for body cells (width, alignment, sticky offset). Rebuilt on each parameter set.</summary>
    public string CellStyle { get; private set; } = "";

    /// <summary>Pre-computed CSS for footer cells (width, alignment, sticky offset with footer background). Rebuilt on each parameter set.</summary>
    public string FooterCellStyle { get; private set; } = "";

    /// <summary>Current sort state: <c>0</c> = unsorted, <c>1</c> = ascending, <c>2</c> = descending.</summary>
    public int SortState { get; set; }

    /// <summary>
    /// The set of values currently included by the column filter. An empty list means
    /// no filter is active (all rows pass). Each entry is the normalized string form of the
    /// property value as shown in the filter panel.
    /// </summary>
    public List<object?> FilterState { get; set; } = [];

    /// <summary>
    /// Width set by the user via drag. When set, the column is in manual mode and
    /// <c>flex-grow</c> is suppressed. <c>null</c> means the declared <see cref="Width"/> is in use.
    /// </summary>
    public int? UserWidth { get; set; }

    /// <summary>
    /// Frozen state overridden at runtime via the column menu. <c>null</c> means the user has
    /// not changed the declared <see cref="Frozen"/> value. Read <see cref="IsFrozen"/> for
    /// the effective state.
    /// </summary>
    public bool? UserFrozen { get; set; }

    /// <summary>Effective frozen state: <c>UserFrozen ?? Frozen</c>.</summary>
    public bool IsFrozen => UserFrozen ?? Frozen;

    /// <summary>
    /// Hidden state overridden at runtime via the column menu. <c>null</c> means the user has
    /// not changed the declared <see cref="Hidden"/> value. Read <see cref="IsHidden"/> for
    /// the effective state.
    /// </summary>
    public bool? UserHidden { get; set; }

    /// <summary>Effective hidden state: <c>UserHidden ?? Hidden</c>. Hidden columns are excluded from all rendering and selection.</summary>
    public bool IsHidden => UserHidden ?? Hidden;

    /// <summary>CSS <c>left</c> offset in pixels when the column is sticky-frozen. <c>null</c> for unfrozen columns.</summary>
    public int? StickyLeft { get; set; }

    /// <summary>CSS <c>right</c> offset in pixels when the column is sticky-frozen from the right. <c>null</c> in normal use.</summary>
    public int? StickyRight { get; set; }

    /// <summary><c>true</c> when this is the rightmost frozen column (receives the sticky-shadow visual separator).</summary>
    public bool IsLastFrozen { get; set; }

    /// <summary><c>true</c> when <see cref="ComboBoxSource"/> is set.</summary>
    public bool IsComboColumn => ComboBoxSource != null;

    /// <summary><c>true</c> when <see cref="CheckBox"/> is set.</summary>
    public bool IsCheckboxColumn => CheckBox;

    /// <summary><c>true</c> when <see cref="MultiLine"/> is set and <see cref="ComboBoxSource"/> is not (combo overrides multi-line).</summary>
    public bool IsMultiLineColumn => MultiLine && !IsComboColumn;

    /// <summary><c>true</c> when <see cref="DatePicker"/> is set.</summary>
    public bool IsDatePickerColumn => DatePicker;

    /// <summary><c>true</c> when <see cref="ColorPicker"/> is set.</summary>
    public bool IsColorPickerColumn => ColorPicker;

    /// <summary>
    /// The effective display getter: <see cref="Display"/> takes priority, then the combo-source
    /// lookup (when <see cref="ComboBoxSource"/> is set and <see cref="Display"/> is not), then
    /// an enum wrapper, date formatter, or the compiled <see cref="Property"/> getter.
    /// Used for rendering, filter labels, column fit measurement, and clipboard copy fallback.
    /// </summary>
    public Func<T, object?>? EffectiveGetter => Display != null ? Display : (comboDisplayGetter ?? enumDisplayGetter ?? dateFormatGetter ?? compiledPropertyGetter);

    /// <summary>
    /// The effective copy getter: <see cref="CopyGetter"/> takes priority, then
    /// <see cref="EffectiveGetter"/>. Used exclusively for clipboard copy.
    /// </summary>
    public Func<T, object?>? EffectiveCopyGetter => CopyGetter ?? EffectiveGetter;

    /// <summary>
    /// The effective value getter for sort/filter: compiled <see cref="Property"/> getter takes
    /// priority, then <see cref="Display"/>. Ensures sort/filter use the raw property value
    /// even when <see cref="Display"/> is set for formatted rendering.
    /// </summary>
    public Func<T, object?>? EffectiveValueGetter => compiledPropertyGetter ?? Display;

    /// <summary>
    /// Resolved column header title following the fallback chain:
    /// explicit <see cref="Title"/> → <c>[Display(Name)]</c> attribute → PascalCase-split property name → empty string.
    /// </summary>
    public string EffectiveTitle => Title ?? displayName ?? inferredName ?? "";

    private Func<T, object?>? compiledPropertyGetter;
    private Func<T, object?>? enumDisplayGetter;
    private Func<T, object?>? dateFormatGetter;
    private Func<T, object?>? comboDisplayGetter;
    private Action<T, object?>? compiledPropertySetter;
    private Type? propertyType;
    private string? displayName;
    private string? inferredName;
    private Expression<Func<T, object?>>? _lastBuiltProperty;
    private bool _lastVisible = true;

    protected override void OnInitialized()
    {
        Parent?.AddColumn(this);
    }

    protected override void OnParametersSet()
    {
        if (Visible != _lastVisible)
        {
            _lastVisible = Visible;
            Parent?.NotifyColumnLayoutChanged();
        }

        if (!ReferenceEquals(_lastBuiltProperty, Property))
        {
            _lastBuiltProperty = Property;
            BuildPropertyAccessors();
        }
        RebuildDateFormatGetter();
        RebuildComboDisplayGetter();
        HeaderCellStyle = BuildHeaderCellStyle();
        CellStyle = BuildCellStyle();
        FooterCellStyle = BuildFooterCellStyle();
    }

    private void RebuildComboDisplayGetter()
    {
        if (ComboBoxSource is NxGridFixedComboSource fixedSource && Display == null && compiledPropertyGetter != null)
        {
            var valueGetter = compiledPropertyGetter;
            comboDisplayGetter = row => fixedSource.LookupText(row!, valueGetter(row)?.ToString());
        }
        else
        {
            comboDisplayGetter = null;
        }
    }

    private void RebuildDateFormatGetter()
    {
        if (compiledPropertyGetter != null && !string.IsNullOrEmpty(DateFormat) && propertyType != null)
        {
            var underlying = System.Nullable.GetUnderlyingType(propertyType) ?? propertyType;
            if (underlying == typeof(DateTime))
            {
                var baseGetter = compiledPropertyGetter;
                var fmt = DateFormat;
                dateFormatGetter = row =>
                {
                    var val = baseGetter(row);
                    return val is DateTime dt ? dt.ToString(fmt) : val;
                };
                return;
            }
            if (underlying == typeof(TimeOnly))
            {
                var baseGetter = compiledPropertyGetter;
                var fmt = DateFormat;
                dateFormatGetter = row =>
                {
                    var val = baseGetter(row);
                    return val is TimeOnly to ? to.ToString(fmt) : val;
                };
                return;
            }
        }
        dateFormatGetter = null;
    }

    public void BuildStyles()
    {
        HeaderCellStyle = BuildHeaderCellStyle();
        CellStyle = BuildCellStyle();
        FooterCellStyle = BuildFooterCellStyle();
    }

    private void BuildPropertyAccessors()
    {
        if (Property == null)
        {
            compiledPropertyGetter = null;
            enumDisplayGetter = null;
            compiledPropertySetter = null;
            propertyType = null;
            displayName = null;
            inferredName = null;
            return;
        }

        // Unwrap the boxing Convert node present when value types are assigned to object?
        var body = Property.Body;
        if (body is UnaryExpression { NodeType: ExpressionType.Convert } convert)
            body = convert.Operand;

        if (body is not MemberExpression member)
        {
            // Not a simple member access — read-only (getter only, no setter)
            compiledPropertyGetter = Property.Compile();
            enumDisplayGetter = null;
            compiledPropertySetter = null;
            propertyType = null;
            displayName = null;
            inferredName = null;
            return;
        }

        propertyType = member.Type;
        compiledPropertyGetter = Property.Compile();
        inferredName = SplitPascalCase(member.Member.Name);
        displayName = member.Member.GetCustomAttribute<DisplayAttribute>()?.GetName();

        // Cache an enum-display wrapper when the property type is an enum (or nullable enum).
        var enumType = System.Nullable.GetUnderlyingType(propertyType) ?? propertyType;
        if (enumType.IsEnum)
        {
            var baseGetter = compiledPropertyGetter;
            enumDisplayGetter = row => GetEnumDisplayName(baseGetter(row));
        }
        else
        {
            enumDisplayGetter = null;
        }

        var canWrite = member.Member is PropertyInfo pi ? pi.CanWrite : member.Member is FieldInfo;
        if (canWrite)
        {
            var rowParam = Property.Parameters[0];
            var valueParam = Expression.Parameter(typeof(object), "value");
            var assignment = Expression.Assign(member, Expression.Convert(valueParam, propertyType));
            compiledPropertySetter = Expression.Lambda<Action<T, object?>>(
                assignment, rowParam, valueParam).Compile();
        }
        else
        {
            compiledPropertySetter = null;
        }
    }

    private static string? TryEvaluateMath(string expression)
    {
        try
        {
            var result = new System.Data.DataTable().Compute(expression.Trim(), null);
            if (result is DBNull || result == null) return null;
            var d = Convert.ToDouble(result);
            if (!double.IsFinite(d)) return null;
            return d.ToString(System.Globalization.CultureInfo.CurrentCulture);
        }
        catch
        {
            return null;
        }
    }

    // Parses shorthand time strings such as "8p", "830a", "1230".
    // Accepts H, HH, HMM, HHMM with an optional a/am/p/pm suffix.
    // No suffix: hours 12 and 1–4 default to PM; hours 5–11 default to AM.
    // Returns null when the input is not a recognised shorthand.
    internal static (int hours, int minutes)? TryParseShorthandTime(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return null;
        var s = input.Trim().ToLowerInvariant().Replace(" ", "");

        bool? isPm = null;
        if      (s.EndsWith("pm")) { isPm = true;  s = s[..^2]; }
        else if (s.EndsWith("am")) { isPm = false; s = s[..^2]; }
        else if (s.EndsWith("p"))  { isPm = true;  s = s[..^1]; }
        else if (s.EndsWith("a"))  { isPm = false; s = s[..^1]; }

        if (s.Length is 0 or > 4 || !s.All(char.IsDigit)) return null;

        var n = int.Parse(s);
        int hours, minutes;
        if (s.Length <= 2)      { hours = n;       minutes = 0;       }
        else if (s.Length == 3) { hours = n / 100; minutes = n % 100; }
        else                    { hours = n / 100; minutes = n % 100; }

        if (hours is < 0 or > 12 || minutes is < 0 or >= 60) return null;

        if (isPm == null)
            isPm = hours == 12 || hours is >= 1 and <= 4;

        if (isPm == true  && hours != 12) hours += 12;
        if (isPm == false && hours == 12) hours  = 0;

        return (hours, minutes);
    }

    internal static string SplitPascalCase(string name)
    {
        if (string.IsNullOrEmpty(name)) return name;
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < name.Length; i++)
        {
            if (i > 0 && char.IsUpper(name[i]) && char.IsLower(name[i - 1]))
                sb.Append(' ');
            sb.Append(i == 0 ? char.ToUpper(name[i]) : name[i]);
        }
        return sb.ToString();
    }

    /// <summary>
    /// Returns the <see cref="DisplayAttribute.Name"/> for an enum value when the attribute is
    /// present; otherwise returns <c>value.ToString()</c>. Returns <c>null</c> when
    /// <paramref name="value"/> is <c>null</c>. Supports nullable enums.
    /// </summary>
    internal static string? GetEnumDisplayName(object? value)
    {
        if (value == null) return null;
        var type = value.GetType();
        var enumType = System.Nullable.GetUnderlyingType(type) ?? type;
        if (!enumType.IsEnum) return value.ToString();
        var memberName = value.ToString();
        if (memberName == null) return null;
        var members = enumType.GetMember(memberName);
        if (members.Length == 0) return memberName;
        var attr = members[0].GetCustomAttribute<DisplayAttribute>();
        return attr?.GetName() ?? memberName;
    }

    // Parses rawValue to the property's CLR type and returns a pre-bound apply action.
    // Returns (rawValue, null) when Property is not set or parsing fails — Apply is a no-op.
    // existingValue is the cell's current value; used to preserve the date when parsing time shorthands.
    public (object? typedValue, Action<T>? apply) ParseAndBuildApply(string? rawValue, object? existingValue = null)
    {
        if (compiledPropertySetter == null || propertyType == null)
            return (rawValue, null);

        var underlying = System.Nullable.GetUnderlyingType(propertyType) ?? propertyType;
        var isNullable  = System.Nullable.GetUnderlyingType(propertyType) != null;

        if (rawValue == null)
        {
            if (isNullable || !propertyType.IsValueType)
            {
                var s = compiledPropertySetter;
                return (null, row => s(row, null));
            }
            return (null, null);
        }

        if (MathExpression)
            rawValue = TryEvaluateMath(rawValue) ?? rawValue;

        object? typed = null;
        bool    parsed = false;

        if      (underlying == typeof(string))                                               { typed = rawValue; parsed = true; }
        else if (underlying == typeof(int)      && int.TryParse(rawValue,     out var i))    { typed = i; parsed = true; }
        else if (underlying == typeof(long)     && long.TryParse(rawValue,    out var l))    { typed = l; parsed = true; }
        else if (underlying == typeof(double)   && double.TryParse(rawValue,  out var dbl))  { typed = dbl; parsed = true; }
        else if (underlying == typeof(float)    && float.TryParse(rawValue,   out var flt))  { typed = flt; parsed = true; }
        else if (underlying == typeof(decimal)  && decimal.TryParse(rawValue, out var dec))  { typed = dec; parsed = true; }
        else if (underlying == typeof(bool)     && bool.TryParse(rawValue,    out var b))    { typed = b; parsed = true; }
        else if (underlying == typeof(DateTime))
        {
            if (!string.IsNullOrEmpty(DateFormat) &&
                DateTime.TryParseExact(rawValue, DateFormat,
                    System.Globalization.CultureInfo.CurrentCulture,
                    System.Globalization.DateTimeStyles.None, out var dtFmt))
            { typed = dtFmt; parsed = true; }
            else if (DateTime.TryParse(rawValue, out var dt))
            { typed = dt; parsed = true; }
            else
            {
                var hm = TryParseShorthandTime(rawValue);
                if (hm.HasValue)
                {
                    var baseDate = existingValue is DateTime evDt ? evDt.Date : DateTime.Today;
                    typed = baseDate.AddHours(hm.Value.hours).AddMinutes(hm.Value.minutes);
                    parsed = true;
                }
            }
        }
        else if (underlying == typeof(TimeOnly))
        {
            if (!string.IsNullOrEmpty(DateFormat) &&
                TimeOnly.TryParseExact(rawValue, DateFormat,
                    System.Globalization.CultureInfo.CurrentCulture,
                    System.Globalization.DateTimeStyles.None, out var toFmt))
            { typed = toFmt; parsed = true; }
            else if (TimeOnly.TryParse(rawValue, out var to))
            { typed = to; parsed = true; }
            else
            {
                var hm = TryParseShorthandTime(rawValue);
                if (hm.HasValue)
                { typed = new TimeOnly(hm.Value.hours, hm.Value.minutes); parsed = true; }
            }
        }

        if (!parsed) return (rawValue, null);

        var setter  = compiledPropertySetter;
        var capture = typed;
        return (typed, row => setter(row, capture));
    }

    internal int? FitWidth { get; set; }

    private string BuildWidthStyle()
    {
        // Fixed sizing: exact pixel width — no flex growth or shrinkage regardless of mode.
        // EffectiveFitContent=true may have measured content into FitWidth; prefer that over Width.
        // Width=null with no FitWidth yet falls back to 100px until measurement completes.
        if (Sizing == NxGridColumnSizing.Fixed)
        {
            var fixedW = UserWidth ?? FitWidth ?? Width ?? 100;
            var style = $"width:{fixedW}px;flex-shrink:0;";
            if (MinWidth != null) style += $"min-width:{MinWidth}px;";
            if (MaxWidth != null) style += $"max-width:{MaxWidth}px;";
            return style;
        }

        // Pinned: user-resized — fixed width, no flex.
        // FlexMinWidth/FlexMaxWidth don't apply; MinWidth/MaxWidth govern drag resize.
        if (UserWidth.HasValue)
        {
            var fixedW = UserWidth.Value;
            var style = $"width:{fixedW}px;flex-shrink:0;";
            if (MinWidth != null) style += $"min-width:{MinWidth}px;";
            if (MaxWidth != null) style += $"max-width:{MaxWidth}px;";
            return style;
        }

        // Flex sizing, FitContent mode: FitWidth is the computed content-fit basis.
        // FlexMinWidth/FlexMaxWidth bound the flex distribution on top of MinWidth/MaxWidth.
        if (FitWidth.HasValue)
        {
            var cssMin = MaxOf(MaxOf(MinWidth, FlexMinWidth), FitWidth); // never shrink below computed fit
            var cssMax = MinOf(MaxWidth, FlexMaxWidth);
            var style = $"width:{FitWidth}px;flex-grow:{FitWidth};min-width:{cssMin}px;";
            if (cssMax != null) style += $"max-width:{cssMax}px;";
            return style;
        }

        // Flex sizing, fallback (before first fit, or FitContent=Never): declared Width or 100px.
        var w = Width ?? 100;
        var fallback = $"width:{w}px;";
        var fMin = MaxOf(MinWidth, FlexMinWidth);
        var fMax = MinOf(MaxWidth, FlexMaxWidth);
        if (fMin != null) fallback += $"min-width:{fMin}px;";
        if (fMax != null) fallback += $"max-width:{fMax}px;";
        if (!(Parent?.IsManualMode ?? false)) fallback += $"flex-grow:{w};";
        return fallback;
    }

    private static int? MaxOf(int? a, int? b) => (a, b) switch
    {
        (null, null) => null,
        (null, _)    => b,
        (_, null)    => a,
        _            => Math.Max(a.Value, b.Value)
    };

    private static int? MinOf(int? a, int? b) => (a, b) switch
    {
        (null, null) => null,
        (null, _)    => b,
        (_, null)    => a,
        _            => Math.Min(a.Value, b.Value)
    };

    private string BuildHeaderCellStyle()
    {
        var style = BuildWidthStyle().TrimEnd(';');
        if (StickyLeft is int left)
        {
            var right = StickyRight is int r ? $";right:{r}px" : "";
            style += $";position:sticky;left:{left}px{right};z-index:1;background-color:var(--nx-grid-header-bg)";
        }
        return style;
    }

    private string BuildCellStyle()
    {
        var style = BuildWidthStyle();
        if (CheckBox) style += "justify-content:center;";
        else if (Alignment == NxGridColumnAlignment.Center) style += "justify-content:center;text-align:center;";
        else if (Alignment == NxGridColumnAlignment.Right) style += "justify-content:flex-end;text-align:right;";
        if (StickyLeft is int left)
        {
            var right = StickyRight is int r ? $"right:{r}px;" : "";
            style += $"position:sticky;left:{left}px;{right}z-index:1;background-color:inherit;";
        }
        return style;
    }

    private string BuildFooterCellStyle()
    {
        var style = BuildWidthStyle();
        if (CheckBox || Alignment == NxGridColumnAlignment.Center) style += "justify-content:center;";
        else if (Alignment == NxGridColumnAlignment.Right) style += "justify-content:flex-end;";
        if (StickyLeft is int left)
        {
            var right = StickyRight is int r ? $"right:{r}px;" : "";
            style += $"position:sticky;left:{left}px;{right}z-index:1;background-color:var(--nx-grid-footer-bg,var(--nx-grid-header-bg));";
        }
        return style;
    }

    public string? FormatDateValue(object? value)
    {
        if (value is not DateTime dt) return null;
        var fmt = DateFormat ?? System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern;
        return dt.ToString(fmt);
    }

    public List<T> FilterData(List<T> data)
    {
        if (FilterState.Count == 0) return data;
        var filterStrings = FilterState.Select(v => v?.ToString()).ToHashSet();
        return data.Where(x => filterStrings.Contains(GetNormalizedValue(x)?.ToString())).ToList();
    }

    public object? GetNormalizedValue(T item)
    {
        var getter = EffectiveValueGetter;
        return getter == null ? null : NormalizeObject(getter(item));
    }

    private static object? NormalizeObject(object? value)
    {
        if (value is string s && string.IsNullOrWhiteSpace(s))
            return null;
        return value;
    }

    public void Dispose()
    {
        Parent?.RemoveColumn(this);
    }
}
